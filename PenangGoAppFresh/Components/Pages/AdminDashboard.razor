@page "/admindashboard"
@inject PenangGoAppFresh.Auth.AuthService AuthService
@inject PenangGoAppFresh.Services.IUserService UserService
@inject PenangGoAppFresh.Services.HeritageSiteService HeritageSiteService
@inject PenangGoAppFresh.Services.EventService EventService
@inject PenangGoAppFresh.Services.PanoramaContentService PanoramaService
@inject PenangGoAppFresh.Services.IReviewService ReviewService
@inject PenangGoAppFresh.Services.IBookingService BookingService
@inject NavigationManager Navigation

<div>
    <PenangGoAppFresh.Components.Shared.PageHeader Title="Admin Dashboard" Subtitle="System overview and pending actions">
        <PenangGoAppFresh.Components.Shared.StatusBadge Text="Admin" Variant="gold" />
    </PenangGoAppFresh.Components.Shared.PageHeader>

    @if (!AuthService.IsAdmin)
    {
        <PenangGoAppFresh.Components.Shared.EmptyState Title="Access denied" Description="You do not have admin privileges." Icon="🔒" />
    }
    else if (isLoading)
    {
        <div class="grid-auto-fill" style="grid-template-columns:repeat(4,1fr);">
            @for (int i = 0; i < 4; i++) { <PenangGoAppFresh.Components.Shared.Skeleton Variant="image" Style="height:120px;" /> }
        </div>
    }
    else
    {
        <!-- Stats Grid -->
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:var(--space-16);margin-bottom:var(--space-32);">
            <div class="l1-material" style="padding:var(--space-20);text-align:center;">
                <div class="text-3xl font-bold text-teal">@totalUsers</div>
                <div class="text-sm text-secondary mt-4">Total Users</div>
                <div class="text-xs text-tertiary mt-4">@activeUsers active</div>
            </div>
            <div class="l1-material" style="padding:var(--space-20);text-align:center;">
                <div class="text-3xl font-bold text-teal">@totalSites</div>
                <div class="text-sm text-secondary mt-4">Heritage Sites</div>
                <div class="text-xs text-tertiary mt-4">@pendingSites pending</div>
            </div>
            <div class="l1-material" style="padding:var(--space-20);text-align:center;">
                <div class="text-3xl font-bold text-teal">@totalEvents</div>
                <div class="text-sm text-secondary mt-4">Events</div>
                <div class="text-xs text-tertiary mt-4">@upcomingEvents upcoming</div>
            </div>
            <div class="l1-material" style="padding:var(--space-20);text-align:center;">
                <div class="text-3xl font-bold text-teal">@totalBookings</div>
                <div class="text-sm text-secondary mt-4">Bookings</div>
                <div class="text-xs text-tertiary mt-4">@confirmedBookings confirmed</div>
            </div>
            <div class="l1-material" style="padding:var(--space-20);text-align:center;">
                <div class="text-3xl font-bold text-teal">@totalReviews</div>
                <div class="text-sm text-secondary mt-4">Reviews</div>
            </div>
            <div class="l1-material" style="padding:var(--space-20);text-align:center;">
                <div class="text-3xl font-bold text-teal">@totalPanoramas</div>
                <div class="text-sm text-secondary mt-4">Panoramas</div>
            </div>
        </div>

        <!-- Pending Actions -->
        @if (pendingSites > 0 || pendingReviews > 0)
        {
            <h3 class="text-lg font-semibold mb-16">Pending Actions</h3>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:var(--space-16);margin-bottom:var(--space-32);">
                @if (pendingSites > 0)
                {
                    <div class="l1-material" style="padding:var(--space-20);">
                        <div class="d-flex justify-between items-center mb-8">
                            <span class="text-md font-medium">Site Approvals</span>
                            <PenangGoAppFresh.Components.Shared.StatusBadge Text="@($"{pendingSites} pending")" Variant="terracotta" />
                        </div>
                        <button class="btn-glass btn-sm btn-primary-heritage" @onclick="@(() => Navigation.NavigateTo("/adminsites"))">Review Sites</button>
                    </div>
                }
                @if (pendingReviews > 0)
                {
                    <div class="l1-material" style="padding:var(--space-20);">
                        <div class="d-flex justify-between items-center mb-8">
                            <span class="text-md font-medium">Review Moderation</span>
                            <PenangGoAppFresh.Components.Shared.StatusBadge Text="@($"{pendingReviews} pending")" Variant="terracotta" />
                        </div>
                        <button class="btn-glass btn-sm btn-primary-heritage" @onclick="@(() => Navigation.NavigateTo("/adminreviews"))">Review Reviews</button>
                    </div>
                }
            </div>
        }

        <!-- Quick Links -->
        <h3 class="text-lg font-semibold mb-16">Management</h3>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:var(--space-12);">
            @foreach (var link in adminLinks)
            {
                <button class="l1-material l2-glass-interactive" style="padding:var(--space-16);text-align:left;cursor:pointer;"
                        @onclick="@(() => Navigation.NavigateTo(link.Href))">
                    <div class="text-md font-medium">@link.Label</div>
                    <div class="text-xs text-secondary mt-4">@link.Description</div>
                </button>
            }
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private int totalUsers, activeUsers, totalSites, activeSites, pendingSites;
    private int totalEvents, upcomingEvents, totalBookings, confirmedBookings;
    private int totalReviews, pendingReviews, totalPanoramas;

    private record AdminLink(string Href, string Label, string Description);
    private AdminLink[] adminLinks = new[]
    {
        new AdminLink("/adminsites", "Heritage Sites", "Manage and approve sites"),
        new AdminLink("/adminevents", "Events", "Create and manage events"),
        new AdminLink("/adminusers", "Users", "Manage user accounts"),
        new AdminLink("/adminbookings", "Bookings", "View all bookings"),
        new AdminLink("/adminreviews", "Reviews", "Moderate user reviews"),
        new AdminLink("/admin-panoramas", "Panoramas", "Manage 360° content"),
    };

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAdmin) { isLoading = false; return; }
        try
        {
            var users = await UserService.GetAllUsersAsync();
            totalUsers = users.Count;
            activeUsers = users.Count(u => u.IsActive);

            var sites = await HeritageSiteService.GetAllForManagementAsync();
            totalSites = sites.Count;
            activeSites = sites.Count(s => s.IsActive);
            pendingSites = sites.Count(s => s.ApprovalStatus == PenangGoApp.DataAccess.ApprovalStatus.Pending);

            var events = await EventService.GetAllAsync();
            totalEvents = events.Count;
            upcomingEvents = events.Count(e => e.StartTime > DateTime.UtcNow);

            var bookings = await BookingService.GetAllBookingsAsync();
            totalBookings = bookings.Count;
            confirmedBookings = bookings.Count(b => b.Status == PenangGoApp.DataAccess.BookingStatus.Confirmed);

            var reviews = await ReviewService.GetAllReviewsAsync();
            totalReviews = reviews.Count;

            var panoramas = await PanoramaService.GetAllAsync();
            totalPanoramas = panoramas.Count;
        }
        catch { }
        isLoading = false;
    }
}
