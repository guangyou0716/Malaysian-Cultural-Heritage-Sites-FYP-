@page "/signup"
@inject PenangGoAppFresh.Auth.IAuthService AuthService
@inject NavigationManager Navigation

<div class="d-flex items-center justify-center" style="min-height:80vh;padding:var(--space-16);">
    <PenangGoAppFresh.Components.Shared.GlassSurface Level="1" Class="p-24" Style="max-width:420px;width:100%;">
        <div class="text-center mb-24">
            <img src="/images/penanggo_logo.png" alt="PenangGo Logo" style="max-width:80px;margin-bottom:var(--space-12);" />
            <h1 class="text-2xl font-bold tracking-tight m-0">Create Account</h1>
            <p class="text-sm text-secondary mt-4">Join PenangGo to explore cultural heritage</p>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div style="padding:var(--space-12);border-radius:var(--radius-md);background:rgba(196,58,58,0.1);color:var(--color-error);margin-bottom:var(--space-16);">
                <span class="text-sm">@error</span>
            </div>
        }

        <div class="d-flex flex-col gap-16">
            <div>
                <label class="text-sm font-medium text-secondary d-block mb-8">Name</label>
                <input class="input-glass @(nameError ? "is-invalid" : "")" @bind="name" @onblur="ValidateName" placeholder="Your name"
                       style="@(nameError ? "border-color:var(--color-error);" : "")" />
                @if (nameError)
                {
                    <div class="text-xs mt-4" style="color:var(--color-error);">@nameErrorMessage</div>
                }
            </div>
            <div>
                <label class="text-sm font-medium text-secondary d-block mb-8">Email</label>
                <input class="input-glass @(emailError ? "is-invalid" : "")" type="email" @bind="email" @onblur="ValidateEmail" placeholder="your@email.com"
                       style="@(emailError ? "border-color:var(--color-error);" : "")" />
                @if (emailError)
                {
                    <div class="text-xs mt-4" style="color:var(--color-error);">@emailErrorMessage</div>
                }
            </div>
            <div>
                <label class="text-sm font-medium text-secondary d-block mb-8">Password</label>
                <input class="input-glass @(passwordError ? "is-invalid" : "")" type="password" @bind="password" @onblur="ValidatePassword" placeholder="Create a password"
                       style="@(passwordError ? "border-color:var(--color-error);" : "")" />
                <div class="mt-8">
                    <div class="text-xs text-tertiary mb-8">Password requirements:</div>
                    <div class="d-flex flex-col gap-4">
                        <div class="d-flex items-center gap-8 text-xs @(passwordLength ? "text-teal" : "text-tertiary")">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                            At least 8 characters
                        </div>
                        <div class="d-flex items-center gap-8 text-xs @(passwordUpper ? "text-teal" : "text-tertiary")">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                            One uppercase letter
                        </div>
                        <div class="d-flex items-center gap-8 text-xs @(passwordLower ? "text-teal" : "text-tertiary")">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                            One lowercase letter
                        </div>
                        <div class="d-flex items-center gap-8 text-xs @(passwordDigit ? "text-teal" : "text-tertiary")">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                            One number
                        </div>
                        <div class="d-flex items-center gap-8 text-xs @(passwordSpecial ? "text-teal" : "text-tertiary")">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                            One special character (!@@#$%^&*)
                        </div>
                    </div>
                </div>
                @if (passwordError)
                {
                    <div class="text-xs mt-4" style="color:var(--color-error);">@passwordErrorMessage</div>
                }
            </div>
            <button class="btn-glass btn-primary-heritage btn-lg w-full" @onclick="SignupUser" disabled="@(isLoading || !IsFormValid())">
                @if (isLoading)
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation:signup-spin 1s linear infinite;"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                    <span>Creating Account...</span>
                }
                else
                {
                    <span>Sign Up</span>
                }
            </button>
        </div>

        <p class="text-sm text-secondary text-center mt-24">
            Already have an account? <a href="/login" class="text-teal font-medium" style="text-decoration:none;">Login</a>
        </p>
    </PenangGoAppFresh.Components.Shared.GlassSurface>
</div>

<style>
    @@keyframes signup-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
</style>

@code {
    private string name = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private string error = string.Empty;
    private bool isLoading = false;

    // Validation states
    private bool nameError = false;
    private bool emailError = false;
    private bool passwordError = false;
    private string nameErrorMessage = string.Empty;
    private string emailErrorMessage = string.Empty;
    private string passwordErrorMessage = string.Empty;

    // Password requirement states
    private bool passwordLength = false;
    private bool passwordUpper = false;
    private bool passwordLower = false;
    private bool passwordDigit = false;
    private bool passwordSpecial = false;

    private void ValidateName()
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            nameError = true;
            nameErrorMessage = "Name is required";
        }
        else if (name.Length < 2)
        {
            nameError = true;
            nameErrorMessage = "Name must be at least 2 characters long";
        }
        else
        {
            nameError = false;
            nameErrorMessage = string.Empty;
        }
    }

    private void ValidateEmail()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            emailError = true;
            emailErrorMessage = "Email is required";
        }
        else
        {
            // Email format validation using regex
            var emailRegex = new System.Text.RegularExpressions.Regex(@"^[^@\s]+@[^@\s]+\.[^@\s]+$");
            if (!emailRegex.IsMatch(email))
            {
                emailError = true;
                emailErrorMessage = "Please enter a valid email address";
            }
            else
            {
                emailError = false;
                emailErrorMessage = string.Empty;
            }
        }
    }

    private void ValidatePassword()
    {
        if (string.IsNullOrWhiteSpace(password))
        {
            passwordError = true;
            passwordErrorMessage = "Password is required";
            ResetPasswordRequirements();
            return;
        }

        // Check password requirements
        passwordLength = password.Length >= 8;
        passwordUpper = password.Any(char.IsUpper);
        passwordLower = password.Any(char.IsLower);
        passwordDigit = password.Any(char.IsDigit);

        var specialChars = @"!@#$%^&*()_+-=[]{}|;:,.<>?";
        passwordSpecial = password.Any(c => specialChars.Contains(c));

        // Check if all requirements are met
        if (passwordLength && passwordUpper && passwordLower && passwordDigit && passwordSpecial)
        {
            passwordError = false;
            passwordErrorMessage = string.Empty;
        }
        else
        {
            passwordError = true;
            passwordErrorMessage = "Password does not meet all requirements";
        }
    }

    private void ResetPasswordRequirements()
    {
        passwordLength = false;
        passwordUpper = false;
        passwordLower = false;
        passwordDigit = false;
        passwordSpecial = false;
    }

    private bool IsFormValid()
    {
        return !string.IsNullOrWhiteSpace(name) &&
               !string.IsNullOrWhiteSpace(email) &&
               !string.IsNullOrWhiteSpace(password) &&
               !nameError &&
               !emailError &&
               !passwordError;
    }

    private async Task SignupUser()
    {
        // Validate all fields before submission
        ValidateName();
        ValidateEmail();
        ValidatePassword();

        if (!IsFormValid())
        {
            return;
        }

        isLoading = true;
        error = string.Empty;

        try
        {
            var result = await AuthService.SignupAsync(name, email, password);

            if (result.Success)
            {
                Navigation.NavigateTo("/dashboard");
            }
            else
            {
                error = result.Message;
            }
        }
        catch (Exception ex)
        {
            error = "An error occurred during registration. Please try again.";
            Console.WriteLine($"Signup error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    [Inject] NavigationManager NavigationManager { get; set; }
    void NavigateTo(string url) => NavigationManager.NavigateTo(url);
}
