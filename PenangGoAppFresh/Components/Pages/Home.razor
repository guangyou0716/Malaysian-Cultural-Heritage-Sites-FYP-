@page "/"
@inject NavigationManager Navigation
@inject PenangGoAppFresh.Auth.AuthService AuthService
@inject PenangGoAppFresh.Services.HeritageSiteService HeritageSiteService
@inject PenangGoAppFresh.Services.EventService EventService
@implements IDisposable

<div class="home-page" style="padding-top:var(--space-8);">
    <!-- Hero with real photo -->
    <section class="l0-content" style="position:relative;border-radius:var(--radius-xl);overflow:hidden;margin-bottom:var(--space-32);">
        <img src="/images/sites/Khoo-Kongsi.jpg" alt="Penang Heritage"
             style="width:100%;height:340px;object-fit:cover;display:block;" />
        <div class="l2-glass" style="position:absolute;bottom:var(--space-24);left:var(--space-24);right:var(--space-24);padding:var(--space-24);border-radius:var(--radius-xl);">
            <h1 class="text-3xl font-bold tracking-tight" style="color:var(--text-primary);margin:0 0 var(--space-8);">
                Discover Penang's Heritage
            </h1>
            <p class="text-base text-secondary" style="margin:0 0 var(--space-16);">
                Explore centuries of cultural history across the Pearl of the Orient
            </p>
            <div class="d-flex gap-8 flex-wrap">
                <button class="btn-glass btn-primary-heritage" @onclick="@(() => Navigation.NavigateTo("/map"))">
                    Explore Map
                </button>
                <button class="btn-glass" @onclick="@(() => Navigation.NavigateTo("/events"))">
                    Upcoming Events
                </button>
            </div>
        </div>
    </section>

    <!-- Featured Sites -->
    <section style="margin-bottom:var(--space-40);">
        <div class="d-flex justify-between items-center mb-16">
            <h2 class="text-xl font-semibold tracking-tight m-0">Heritage Sites</h2>
            <button class="btn-glass btn-sm" @onclick="@(() => Navigation.NavigateTo("/map"))">View All</button>
        </div>
        @if (sites == null)
        {
            <div class="grid-auto-fill">
                @for (int i = 0; i < 4; i++) { <PenangGoAppFresh.Components.Shared.Skeleton Variant="image" /> }
            </div>
        }
        else if (sites.Count == 0)
        {
            <PenangGoAppFresh.Components.Shared.EmptyState Title="No sites yet" Description="Heritage sites will appear here." />
        }
        else
        {
            <div class="grid-auto-fill">
                @foreach (var site in sites.Take(6))
                {
                    <PenangGoAppFresh.Components.Shared.SiteCard Site="site" />
                }
            </div>
        }
    </section>

    <!-- Upcoming Events -->
    <section style="margin-bottom:var(--space-40);">
        <div class="d-flex justify-between items-center mb-16">
            <h2 class="text-xl font-semibold tracking-tight m-0">Upcoming Events</h2>
            <button class="btn-glass btn-sm" @onclick="@(() => Navigation.NavigateTo("/events"))">View All</button>
        </div>
        @if (events == null)
        {
            <div class="grid-auto-fill">
                @for (int i = 0; i < 3; i++) { <PenangGoAppFresh.Components.Shared.Skeleton Variant="image" /> }
            </div>
        }
        else if (events.Count == 0)
        {
            <PenangGoAppFresh.Components.Shared.EmptyState Title="No upcoming events" Description="Check back soon for cultural events and tours." />
        }
        else
        {
            <div class="grid-auto-fill">
                @foreach (var ev in events.Take(3))
                {
                    <PenangGoAppFresh.Components.Shared.EventCard Event="ev" />
                }
            </div>
        }
    </section>

    <!-- Quick Categories -->
    <section style="margin-bottom:var(--space-40);">
        <h2 class="text-xl font-semibold tracking-tight mb-16">Explore by Category</h2>
        <div class="d-flex gap-8 flex-wrap">
            @foreach (var cat in categories)
            {
                <PenangGoAppFresh.Components.Shared.FilterChip Label="@cat" IsActiveChanged="@((val) => NavigateToCategory(cat))" />
            }
        </div>
    </section>
</div>

@code {
    private List<PenangGoApp.DataAccess.HeritageSite>? sites;
    private List<PenangGoApp.DataAccess.Event>? events;
    private string[] categories = new[] { "Temple", "Mosque", "Church", "Mansion", "Fort", "Museum" };

    protected override async Task OnInitializedAsync()
    {
        try { sites = await HeritageSiteService.GetAllAsync(); } catch { sites = new(); }
        try { events = await EventService.GetAllAsync(); } catch { events = new(); }
    }

    private void NavigateToCategory(string category)
        => Navigation.NavigateTo($"/map?category={Uri.EscapeDataString(category)}");

    public void Dispose() { }
}
