@page "/adminsites"
@inject PenangGoAppFresh.Services.HeritageSiteService HeritageSiteService
@inject PenangGoAppFresh.Services.PanoramaContentService PanoramaContentService
@inject PenangGoAppFresh.Auth.AuthService AuthService
@inject PenangGoAppFresh.Services.NotificationService NotificationService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<div>
    <PenangGoAppFresh.Components.Shared.PageHeader Title="Heritage Sites Management" Subtitle="Manage heritage sites, locations, and cultural information">
        <PenangGoAppFresh.Components.Shared.StatusBadge Text="Admin" Variant="gold" />
    </PenangGoAppFresh.Components.Shared.PageHeader>

    @if (AuthService == null || !AuthService.IsAdmin)
    {
        <PenangGoAppFresh.Components.Shared.EmptyState Title="Access Denied" Description="You do not have admin privileges to access this page.">
            <button class="btn-glass btn-primary-heritage" @onclick="@(() => Navigation.NavigateTo("/dashboard"))">Go to Dashboard</button>
        </PenangGoAppFresh.Components.Shared.EmptyState>
    }
    else if (sites == null)
    {
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:var(--space-16);">
            @for (int i = 0; i < 6; i++) { <PenangGoAppFresh.Components.Shared.Skeleton Variant="image" Style="height:180px;" /> }
        </div>
    }
    else
    {
        <!-- Statistics -->
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:var(--space-16);margin-bottom:var(--space-24);">
            <div class="l1-material" style="padding:var(--space-16);text-align:center;">
                <div class="text-xl font-bold" style="color:var(--heritage-teal);">@sites.Count</div>
                <div class="text-sm text-secondary mt-4">Total Sites</div>
            </div>
            <div class="l1-material" style="padding:var(--space-16);text-align:center;">
                <div class="text-xl font-bold" style="color:var(--heritage-teal);">@sites.Count(s => s.IsActive && s.ApprovalStatus == ApprovalStatus.Approved)</div>
                <div class="text-sm text-secondary mt-4">Active Sites</div>
            </div>
            <div class="l1-material" style="padding:var(--space-16);text-align:center;">
                <div class="text-xl font-bold" style="color:var(--heritage-teal);">@sites.Count(s => s.ApprovalStatus == ApprovalStatus.Pending)</div>
                <div class="text-sm text-secondary mt-4">Pending Approval</div>
            </div>
            <div class="l1-material" style="padding:var(--space-16);text-align:center;">
                <div class="text-xl font-bold" style="color:var(--heritage-teal);">@sites.Count(s => s.HasPanoramaContent)</div>
                <div class="text-sm text-secondary mt-4">With Panoramas</div>
            </div>
        </div>

        <!-- Action Bar -->
        <div class="d-flex gap-12 mb-24 items-center" style="flex-wrap:wrap;">
            <input type="text" class="input-glass" placeholder="Search sites..." @bind="searchTerm" style="flex:1;min-width:200px;" />
            <select class="input-glass" @bind="statusFilter" style="min-width:160px;">
                <option value="">All Statuses</option>
                <option value="@ApprovalStatus.Approved">Approved</option>
                <option value="@ApprovalStatus.Pending">Pending</option>
                <option value="@ApprovalStatus.Rejected">Rejected</option>
            </select>
            <button class="btn-glass btn-sm" @onclick="ClearFilters">Clear</button>
            <button class="btn-glass btn-sm btn-primary-heritage" @onclick="ShowAddModal">Add New Site</button>
        </div>

        <!-- Sites Table -->
        <div class="l1-material" style="overflow:hidden;">
            <table style="width:100%;border-collapse:collapse;">
                <thead>
                    <tr style="border-bottom:1px solid var(--border-subtle, rgba(255,255,255,0.08));">
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:left;">Site</th>
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:left;">Location</th>
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:left;">Category</th>
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:center;">Rating</th>
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:center;">Status</th>
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var site in pagedItems)
                    {
                        <tr style="border-bottom:1px solid var(--border-subtle, rgba(255,255,255,0.06));">
                            <td style="padding:var(--space-12) var(--space-16);">
                                <div class="text-md font-medium text-primary">@site.Name</div>
                                <div class="text-xs text-tertiary">#@site.Id</div>
                            </td>
                            <td style="padding:var(--space-12) var(--space-16);">
                                <span class="text-sm text-secondary">@site.Location</span>
                            </td>
                            <td style="padding:var(--space-12) var(--space-16);">
                                @if (!string.IsNullOrEmpty(site.Category))
                                {
                                    <span class="badge badge-neutral">@site.Category</span>
                                }
                                else
                                {
                                    <span class="text-sm text-tertiary">--</span>
                                }
                            </td>
                            <td style="padding:var(--space-12) var(--space-16);text-align:center;">
                                <span class="text-sm font-medium">@site.AverageRating.ToString("F1")</span>
                                <span class="text-xs text-tertiary">(@site.TotalReviews)</span>
                            </td>
                            <td style="padding:var(--space-12) var(--space-16);text-align:center;">
                                @if (site.ApprovalStatus == ApprovalStatus.Pending)
                                {
                                    <PenangGoAppFresh.Components.Shared.StatusBadge Text="Pending" Variant="gold" />
                                }
                                else if (site.ApprovalStatus == ApprovalStatus.Rejected)
                                {
                                    <PenangGoAppFresh.Components.Shared.StatusBadge Text="Rejected" Variant="terracotta" />
                                }
                                else if (site.IsActive)
                                {
                                    <PenangGoAppFresh.Components.Shared.StatusBadge Text="Active" Variant="teal" />
                                }
                                else
                                {
                                    <PenangGoAppFresh.Components.Shared.StatusBadge Text="Inactive" Variant="terracotta" />
                                }
                            </td>
                            <td style="padding:var(--space-12) var(--space-16);text-align:right;">
                                <div class="d-flex gap-8" style="justify-content:flex-end;">
                                    @if (site.ApprovalStatus == ApprovalStatus.Pending)
                                    {
                                        <button class="btn-glass btn-sm" @onclick="@(() => ViewSiteDetails(site))" @onclick:stopPropagation="true">View</button>
                                        <button class="btn-glass btn-sm btn-primary-heritage" @onclick="@(() => ApproveSite(site))" @onclick:stopPropagation="true">Approve</button>
                                        <button class="btn-glass btn-sm btn-accent-heritage" @onclick="@(() => RejectSite(site))" @onclick:stopPropagation="true">Reject</button>
                                    }
                                    else
                                    {
                                        <button class="btn-glass btn-sm" @onclick="@(() => EditSite(site))" @onclick:stopPropagation="true">Edit</button>
                                        <button class="btn-glass btn-sm btn-accent-heritage" @onclick="@(() => DeleteSite(site))" @onclick:stopPropagation="true">Delete</button>
                                    }
                                </div>
                            </td>
                        </tr>
                        @if (site.ApprovalStatus == ApprovalStatus.Pending)
                        {
                            <tr style="border-bottom:1px solid var(--border-subtle, rgba(255,255,255,0.06));">
                                <td colspan="6" style="padding:0 var(--space-16) var(--space-12);">
                                    <div class="d-flex gap-16 text-xs text-tertiary">
                                        <span>Submitted by: @(site.Submitter?.Name ?? "Unknown User")</span>
                                        <span>@site.SubmittedAt?.ToString("MMM dd, yyyy HH:mm")</span>
                                        @if (!string.IsNullOrEmpty(site.HistoricalPeriod))
                                        {
                                            <span>Period: @site.HistoricalPeriod</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            @if (!filteredSites.Any())
            {
                <div style="padding:var(--space-32);text-align:center;">
                    <PenangGoAppFresh.Components.Shared.EmptyState Title="No sites found" Description="Try adjusting your search or filter criteria." />
                </div>
            }
            @if (TotalPages > 1)
            {
                <div class="d-flex justify-between items-center p-16" style="border-top:1px solid var(--border-subtle);">
                    <span class="text-xs text-secondary">Showing @((ClampedPage - 1) * PageSize + 1)–@Math.Min(ClampedPage * PageSize, filteredSites.Count()) of @filteredSites.Count()</span>
                    <div class="d-flex gap-8 items-center">
                        <button class="btn-glass btn-sm" @onclick="PrevPage" disabled="@(currentPage <= 1)">Previous</button>
                        <span class="text-xs text-secondary">Page @ClampedPage of @TotalPages</span>
                        <button class="btn-glass btn-sm" @onclick="NextPage" disabled="@(currentPage >= TotalPages)">Next</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Add/Edit Site Modal -->
@if (showModal)
{
    <div class="dialog-overlay" @onclick="CloseModal">
        <div class="dialog-panel" @onclick:stopPropagation="true" style="max-width:560px;width:100%;">
            <h3 class="dialog-title">@(isEditing ? "Edit Site: " + selectedSite?.Name : "Add New Heritage Site")</h3>
            <div style="display:grid;gap:var(--space-12);margin:var(--space-16) 0;">
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Name *</label>
                    <input type="text" class="input-glass w-full" @bind="editSite.Name" placeholder="Enter site name" />
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Description *</label>
                    <textarea class="input-glass w-full" @bind="editSite.Description" rows="3" placeholder="Enter site description"></textarea>
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Location *</label>
                    <input type="text" class="input-glass w-full" @bind="editSite.Location" placeholder="Enter site location" />
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-12);">
                    <div>
                        <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Latitude</label>
                        <input type="number" step="0.000001" class="input-glass w-full" @bind="editSite.Latitude" placeholder="0.000000" />
                    </div>
                    <div>
                        <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Longitude</label>
                        <input type="number" step="0.000001" class="input-glass w-full" @bind="editSite.Longitude" placeholder="0.000000" />
                    </div>
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Category</label>
                    <input type="text" class="input-glass w-full" @bind="editSite.Category" placeholder="e.g., Temple, Mosque, Mansion" />
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Historical Period</label>
                    <input type="text" class="input-glass w-full" @bind="editSite.HistoricalPeriod" placeholder="e.g., 19th Century, Colonial Era" />
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Image URL</label>
                    <input type="url" class="input-glass w-full" @bind="editSite.ImageUrl" placeholder="https://example.com/image.jpg" />
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Status</label>
                    <select class="input-glass w-full" @bind="editSite.IsActive">
                        <option value="@true">Active</option>
                        <option value="@false">Inactive</option>
                    </select>
                </div>
            </div>
            <div class="dialog-actions">
                <button class="btn-glass btn-sm" @onclick="CloseModal">Cancel</button>
                <button class="btn-glass btn-sm btn-primary-heritage" @onclick="SaveSite" disabled="@isSaving">
                    @(isSaving ? "Saving..." : (isEditing ? "Update Site" : "Add Site"))
                </button>
            </div>
        </div>
    </div>
}

<!-- Site Details Modal -->
@if (showDetailsModal)
{
    <div class="dialog-overlay" @onclick="CloseDetailsModal">
        <div class="dialog-panel" @onclick:stopPropagation="true" style="max-width:640px;width:100%;max-height:80vh;overflow-y:auto;">
            <h3 class="dialog-title">Site Details: @selectedSite?.Name</h3>
            @if (selectedSite != null)
            {
                <div style="display:grid;gap:var(--space-16);margin:var(--space-16) 0;">
                    <!-- Basic Info -->
                    <div>
                        <h4 class="text-sm font-semibold text-secondary mb-8">Basic Information</h4>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-8);">
                            <div><span class="text-xs text-tertiary">Name</span><div class="text-sm">@selectedSite.Name</div></div>
                            <div><span class="text-xs text-tertiary">Location</span><div class="text-sm">@selectedSite.Location</div></div>
                            <div><span class="text-xs text-tertiary">Category</span><div class="text-sm">@(selectedSite.Category ?? "Not specified")</div></div>
                            <div><span class="text-xs text-tertiary">Historical Period</span><div class="text-sm">@(selectedSite.HistoricalPeriod ?? "Not specified")</div></div>
                        </div>
                        <div class="mt-8"><span class="text-xs text-tertiary">Description</span><div class="text-sm">@selectedSite.Description</div></div>
                    </div>

                    <!-- Location -->
                    <div>
                        <h4 class="text-sm font-semibold text-secondary mb-8">Location</h4>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-8);">
                            <div><span class="text-xs text-tertiary">Latitude</span><div class="text-sm">@selectedSite.Latitude.ToString("F6")</div></div>
                            <div><span class="text-xs text-tertiary">Longitude</span><div class="text-sm">@selectedSite.Longitude.ToString("F6")</div></div>
                        </div>
                    </div>

                    <!-- Additional -->
                    <div>
                        <h4 class="text-sm font-semibold text-secondary mb-8">Additional Information</h4>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-8);">
                            <div><span class="text-xs text-tertiary">Cultural Significance</span><div class="text-sm">@(selectedSite.CulturalSignificance ?? "Not specified")</div></div>
                            <div><span class="text-xs text-tertiary">Visiting Hours</span><div class="text-sm">@(selectedSite.VisitingHours ?? "Not specified")</div></div>
                            <div><span class="text-xs text-tertiary">Entry Fee</span><div class="text-sm">@(selectedSite.EntryFee ?? "Not specified")</div></div>
                            <div><span class="text-xs text-tertiary">Contact</span><div class="text-sm">@(selectedSite.ContactInfo ?? "Not specified")</div></div>
                            <div><span class="text-xs text-tertiary">Website</span><div class="text-sm">@(selectedSite.Website ?? "Not specified")</div></div>
                            <div><span class="text-xs text-tertiary">Image URL</span><div class="text-sm" style="word-break:break-all;">@(selectedSite.ImageUrl ?? "Not specified")</div></div>
                        </div>
                    </div>

                    <!-- Statistics -->
                    <div>
                        <h4 class="text-sm font-semibold text-secondary mb-8">Statistics</h4>
                        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-8);">
                            <div class="l1-material" style="padding:var(--space-8);text-align:center;">
                                <div class="text-md font-bold" style="color:var(--heritage-teal);">@selectedSite.AverageRating.ToString("F1")</div>
                                <div class="text-xs text-tertiary">Rating</div>
                            </div>
                            <div class="l1-material" style="padding:var(--space-8);text-align:center;">
                                <div class="text-md font-bold">@selectedSite.TotalReviews</div>
                                <div class="text-xs text-tertiary">Reviews</div>
                            </div>
                            <div class="l1-material" style="padding:var(--space-8);text-align:center;">
                                <div class="text-md font-bold">@selectedSite.TotalBookmarks</div>
                                <div class="text-xs text-tertiary">Bookmarks</div>
                            </div>
                            <div class="l1-material" style="padding:var(--space-8);text-align:center;">
                                <div class="text-md font-bold">@(selectedSite.HasPanoramaContent ? "Yes" : "No")</div>
                                <div class="text-xs text-tertiary">Panorama</div>
                            </div>
                        </div>
                    </div>

                    @if (selectedSite.ApprovalStatus == ApprovalStatus.Pending)
                    {
                        <div>
                            <h4 class="text-sm font-semibold text-secondary mb-8">Submission Information</h4>
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-8);">
                                <div><span class="text-xs text-tertiary">Submitted By</span><div class="text-sm">@(selectedSite.Submitter?.Name ?? "Unknown User")</div></div>
                                <div><span class="text-xs text-tertiary">Submitted At</span><div class="text-sm">@selectedSite.SubmittedAt?.ToString("MMM dd, yyyy HH:mm")</div></div>
                            </div>
                        </div>
                    }
                    else if (selectedSite.ApprovalStatus == ApprovalStatus.Rejected)
                    {
                        <div>
                            <h4 class="text-sm font-semibold text-secondary mb-8">Rejection Information</h4>
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-8);">
                                <div><span class="text-xs text-tertiary">Rejected By</span><div class="text-sm">@(selectedSite.Approver?.Name ?? "Unknown Admin")</div></div>
                                <div><span class="text-xs text-tertiary">Rejected At</span><div class="text-sm">@selectedSite.ApprovedAt?.ToString("MMM dd, yyyy HH:mm")</div></div>
                            </div>
                            <div class="mt-8"><span class="text-xs text-tertiary">Reason</span><div class="text-sm">@(selectedSite.ApprovalNotes ?? "No reason provided")</div></div>
                        </div>
                    }
                    else if (selectedSite.ApprovalStatus == ApprovalStatus.Approved)
                    {
                        <div>
                            <h4 class="text-sm font-semibold text-secondary mb-8">Approval Information</h4>
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-8);">
                                <div><span class="text-xs text-tertiary">Approved By</span><div class="text-sm">@(selectedSite.Approver?.Name ?? "Unknown Admin")</div></div>
                                <div><span class="text-xs text-tertiary">Approved At</span><div class="text-sm">@selectedSite.ApprovedAt?.ToString("MMM dd, yyyy HH:mm")</div></div>
                            </div>
                        </div>
                    }
                </div>
            }
            <div class="dialog-actions">
                <button class="btn-glass btn-sm" @onclick="CloseDetailsModal">Close</button>
                @if (selectedSite?.ApprovalStatus == ApprovalStatus.Pending)
                {
                    <button class="btn-glass btn-sm btn-primary-heritage" @onclick="@(() => ApproveSite(selectedSite))">Approve Site</button>
                    <button class="btn-glass btn-sm btn-accent-heritage" @onclick="@(() => RejectSite(selectedSite))">Reject Site</button>
                }
            </div>
        </div>
    </div>
}

<!-- Confirm Dialog -->
<PenangGoAppFresh.Components.Shared.ConfirmDialog IsVisible="showConfirm" Title="@confirmTitle" Message="@confirmMessage" IsDestructive="@confirmDestructive" OnConfirm="RunConfirm" OnCancel="CancelConfirm" />

@code {
    private List<PenangGoApp.DataAccess.HeritageSite> sites;
    private string searchTerm = "";
    private ApprovalStatus? statusFilter;
    private bool showModal = false;
    private bool showDetailsModal = false;
    private bool isEditing = false;
    private bool isSaving = false;
    private PenangGoApp.DataAccess.HeritageSite? selectedSite;
    private PenangGoApp.DataAccess.HeritageSite editSite = new();

    // Pagination
    private const int PageSize = 10;
    private int currentPage = 1;
    private int ClampedPage => Math.Min(currentPage, TotalPages);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(filteredSites.Count() / (double)PageSize));
    private IEnumerable<PenangGoApp.DataAccess.HeritageSite> pagedItems =>
        filteredSites.Skip((ClampedPage - 1) * PageSize).Take(PageSize);
    private void NextPage() { if (currentPage < TotalPages) currentPage++; }
    private void PrevPage() { if (currentPage > 1) currentPage--; }

    // Shared confirm dialog
    private bool showConfirm;
    private string confirmTitle = "Confirm";
    private string confirmMessage = "";
    private bool confirmDestructive = true;
    private Func<Task>? confirmAction;

    private void OpenConfirm(string title, string message, Func<Task> action, bool destructive = true)
    {
        confirmTitle = title;
        confirmMessage = message;
        confirmAction = action;
        confirmDestructive = destructive;
        showConfirm = true;
    }

    private async Task RunConfirm()
    {
        showConfirm = false;
        if (confirmAction != null)
            await confirmAction();
    }

    private void CancelConfirm() => showConfirm = false;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService != null && AuthService.IsAdmin)
        {
            await LoadSites();
        }
    }

    private async Task LoadSites()
    {
        try
        {
            sites = await HeritageSiteService.GetAllForManagementAsync();
            currentPage = 1;
        }
        catch (Exception ex)
        {
            NotificationService.RaiseNotification("Error", "Failed to load sites: " + ex.Message);
            sites = new List<PenangGoApp.DataAccess.HeritageSite>();
        }
    }

    private IEnumerable<PenangGoApp.DataAccess.HeritageSite> filteredSites
    {
        get
        {
            var filtered = sites.AsEnumerable();

            if (statusFilter.HasValue)
            {
                filtered = filtered.Where(s => s.ApprovalStatus == statusFilter.Value);
            }

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                filtered = filtered.Where(s =>
                    s.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    s.Location.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    s.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (s.Category?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true));
            }

            return filtered.OrderByDescending(s => s.ApprovalStatus == ApprovalStatus.Pending)
                         .ThenBy(s => s.Name);
        }
    }

    private void ShowAddModal()
    {
        isEditing = false;
        selectedSite = null;
        editSite = new PenangGoApp.DataAccess.HeritageSite
        {
            IsActive = true,
            ApprovalStatus = ApprovalStatus.Approved, // Admin-created sites are auto-approved
            CreatedAt = DateTime.Now
        };
        showModal = true;
    }

    private void EditSite(PenangGoApp.DataAccess.HeritageSite site)
    {
        isEditing = true;
        selectedSite = site;
        editSite = new PenangGoApp.DataAccess.HeritageSite
        {
            Id = site.Id,
            Name = site.Name,
            Description = site.Description,
            Location = site.Location,
            Latitude = site.Latitude,
            Longitude = site.Longitude,
            Category = site.Category,
            HistoricalPeriod = site.HistoricalPeriod,
            ImageUrl = site.ImageUrl,
            IsActive = site.IsActive,
            ApprovalStatus = site.ApprovalStatus,
            CreatedAt = site.CreatedAt
        };
        showModal = true;
    }

    private void ViewSiteDetails(PenangGoApp.DataAccess.HeritageSite site)
    {
        selectedSite = site;
        showDetailsModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        selectedSite = null;
        editSite = new();
    }

    private void CloseDetailsModal()
    {
        showDetailsModal = false;
        selectedSite = null;
    }

    private async Task SaveSite()
    {
        if (string.IsNullOrWhiteSpace(editSite.Name) ||
            string.IsNullOrWhiteSpace(editSite.Description) ||
            string.IsNullOrWhiteSpace(editSite.Location))
        {
            NotificationService.RaiseNotification("Error", "Please fill in all required fields (Name, Description, Location)");
            return;
        }

        isSaving = true;
        try
        {
            if (isEditing)
            {
                // Update existing site
                await HeritageSiteService.UpdateAsync(editSite);
                var originalSite = sites.FirstOrDefault(s => s.Id == selectedSite!.Id);
                if (originalSite != null)
                {
                    originalSite.Name = editSite.Name;
                    originalSite.Description = editSite.Description;
                    originalSite.Location = editSite.Location;
                    originalSite.Latitude = editSite.Latitude;
                    originalSite.Longitude = editSite.Longitude;
                    originalSite.Category = editSite.Category;
                    originalSite.HistoricalPeriod = editSite.HistoricalPeriod;
                    originalSite.ImageUrl = editSite.ImageUrl;
                    originalSite.IsActive = editSite.IsActive;
                    originalSite.UpdatedAt = DateTime.Now;
                }
                NotificationService.RaiseNotification("Success", $"Site '{editSite.Name}' updated successfully");
                // Reload sites to reflect latest status
                await LoadSites();
            }
            else
            {
                // Add new site
                editSite.CreatedAt = DateTime.Now;
                await HeritageSiteService.AddAsync(editSite);
                sites.Add(editSite);
                NotificationService.RaiseNotification("Success", $"Site '{editSite.Name}' added successfully");
                await LoadSites();
            }

            CloseModal();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            NotificationService.RaiseNotification("Error", $"Failed to save site: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ApproveSite(PenangGoApp.DataAccess.HeritageSite site)
    {
        OpenConfirm("Approve Site",
            $"Approve '{site.Name}'?\nLocation: {site.Location}\nSubmitted by: {site.Submitter?.Name ?? "Unknown User"}",
            () => ApproveSiteConfirmed(site),
            destructive: false);
    }

    private async Task ApproveSiteConfirmed(PenangGoApp.DataAccess.HeritageSite site)
    {
        try
        {
            await HeritageSiteService.ApproveSiteAsync(site.Id);
            currentPage = 1;
            NotificationService.RaiseNotification("Success", $"Site '{site.Name}' approved successfully");
            await LoadSites();
            StateHasChanged();
            CloseDetailsModal();
        }
        catch (Exception ex)
        {
            NotificationService.RaiseNotification("Error", $"Failed to approve site: {ex.Message}");
        }
    }

    private async Task RejectSite(PenangGoApp.DataAccess.HeritageSite site)
    {
        var reason = await JSRuntime.InvokeAsync<string>("prompt",
            $"Please provide a reason for rejecting '{site.Name}':\n\n" +
            $"Location: {site.Location}\n" +
            $"Submitted by: {site.Submitter?.Name ?? "Unknown User"}");

        if (reason == null) return; // User cancelled

        try
        {
            await HeritageSiteService.RejectSiteAsync(site.Id, reason);
            NotificationService.RaiseNotification("Success", $"Site '{site.Name}' rejected successfully");
            await LoadSites();
            StateHasChanged();
            CloseDetailsModal();
        }
        catch (Exception ex)
        {
            NotificationService.RaiseNotification("Error", $"Failed to reject site: {ex.Message}");
        }
    }

    private void DeleteSite(PenangGoApp.DataAccess.HeritageSite site)
    {
        OpenConfirm("Delete Site",
            $"Delete '{site.Name}'?\nLocation: {site.Location}\nThis action cannot be undone.",
            () => DeleteSiteConfirmed(site));
    }

    private async Task DeleteSiteConfirmed(PenangGoApp.DataAccess.HeritageSite site)
    {
        // Optimistically remove from UI
        var originalSites = sites.ToList();
        sites.Remove(site);
        StateHasChanged();

        try
        {
            await HeritageSiteService.DeleteAsync(site.Id);
            currentPage = 1;
            NotificationService.RaiseNotification("Success", $"Site '{site.Name}' deleted successfully");
        }
        catch (Exception ex)
        {
            // Revert on error
            sites = originalSites;
            StateHasChanged();
            NotificationService.RaiseNotification("Error", $"Failed to delete site: {ex.Message}");
        }
    }

    private void ClearFilters()
    {
        searchTerm = "";
        statusFilter = null;
        currentPage = 1;
    }
}
