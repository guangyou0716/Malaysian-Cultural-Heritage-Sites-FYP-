@page "/submit-content"
@inject PenangGoAppFresh.Services.HeritageSiteService HeritageSiteService
@inject PenangGoAppFresh.Services.PanoramaContentService PanoramaService
@inject PenangGoAppFresh.Auth.AuthService AuthService
@inject PenangGoAppFresh.Services.NotificationService NotificationService
@inject NavigationManager Navigation

<div style="max-width:640px;margin:0 auto;">
    <PenangGoAppFresh.Components.Shared.PageHeader Title="Submit Content" Subtitle="Contribute to Penang's heritage archive" />

    @if (!AuthService.IsLoggedIn)
    {
        <PenangGoAppFresh.Components.Shared.EmptyState Title="Login required" Description="Please log in to submit content.">
            <button class="btn-glass btn-primary-heritage" @onclick="@(() => Navigation.NavigateTo("/login"))">Login</button>
        </PenangGoAppFresh.Components.Shared.EmptyState>
    }
    else
    {
        <!-- Submission Type -->
        <div class="d-flex gap-8 mb-24">
            <PenangGoAppFresh.Components.Shared.FilterChip Label="Heritage Site" IsActive="@(submissionType == "site")" IsActiveChanged="@((v) => { if (v) submissionType = "site"; })" />
            <PenangGoAppFresh.Components.Shared.FilterChip Label="Panorama" IsActive="@(submissionType == "panorama")" IsActiveChanged="@((v) => { if (v) submissionType = "panorama"; })" />
        </div>

        <div class="l1-material" style="padding:var(--space-24);">
            <div class="d-flex flex-col gap-16">
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:var(--space-4);">Title *</label>
                    <input class="input-glass" @bind="title" placeholder="Name of the site or panorama" />
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:var(--space-4);">Description *</label>
                    <textarea class="input-glass" rows="4" @bind="description" placeholder="Describe the cultural significance..."></textarea>
                </div>
                @if (submissionType == "site")
                {
                    <div>
                        <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:var(--space-4);">Category</label>
                        <select class="input-glass" @bind="category">
                            <option value="">Select category</option>
                            <option value="Temple">Temple</option>
                            <option value="Mosque">Mosque</option>
                            <option value="Church">Church</option>
                            <option value="Mansion">Mansion</option>
                            <option value="Fort">Fort</option>
                            <option value="Museum">Museum</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:var(--space-4);">Image URL</label>
                        <input class="input-glass" @bind="imageUrl" placeholder="https://example.com/image.jpg" />
                    </div>
                }
                else
                {
                    <div>
                        <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:var(--space-4);">Panorama Image URL *</label>
                        <input class="input-glass" @bind="panoramaUrl" placeholder="https://example.com/panorama.jpg" />
                    </div>
                    <div>
                        <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:var(--space-4);">Heritage Site ID</label>
                        <input class="input-glass" type="number" @bind="linkedSiteId" placeholder="Linked site ID" />
                    </div>
                }

                <button class="btn-glass btn-primary-heritage btn-lg" @onclick="SubmitAsync" disabled="@isSubmitting">
                    @(isSubmitting ? "Submitting..." : "Submit for Review")
                </button>
            </div>
        </div>
    }
</div>

@code {
    private string submissionType = "site";
    private string title = "", description = "", imageUrl = "", panoramaUrl = "", category = "";
    private int linkedSiteId;
    private bool isSubmitting;

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(description))
        {
            NotificationService.RaiseNotification("Error", "Title and description are required."); return;
        }
        isSubmitting = true;
        try
        {
            if (submissionType == "site")
            {
                var site = new PenangGoApp.DataAccess.HeritageSite
                {
                    Name = title, Description = description, Category = category, ImageUrl = imageUrl
                };
                await HeritageSiteService.SubmitForApprovalAsync(site);
                NotificationService.RaiseNotification("Success", "Site submitted for review!");
            }
            else
            {
                if (string.IsNullOrWhiteSpace(panoramaUrl))
                {
                    NotificationService.RaiseNotification("Error", "Panorama URL is required."); isSubmitting = false; return;
                }
                await PanoramaService.SubmitForApprovalAsync(title, description, panoramaUrl, AuthService.CurrentUser?.Id ?? 0, linkedSiteId);
                NotificationService.RaiseNotification("Success", "Panorama submitted for review!");
            }
            title = ""; description = ""; imageUrl = ""; panoramaUrl = "";
        }
        catch { NotificationService.RaiseNotification("Error", "Submission failed."); }
        finally { isSubmitting = false; }
    }
}
