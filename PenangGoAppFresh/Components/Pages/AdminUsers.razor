@page "/adminusers"
@inject PenangGoAppFresh.Auth.AuthService AuthService
@inject PenangGoAppFresh.Services.IUserService UserService
@inject PenangGoAppFresh.Services.NotificationService NotificationService
@inject NavigationManager Navigation

<div>
    <PenangGoAppFresh.Components.Shared.PageHeader Title="User Management" Subtitle="Manage user accounts, roles, and permissions">
        <PenangGoAppFresh.Components.Shared.StatusBadge Text="Admin" Variant="gold" />
    </PenangGoAppFresh.Components.Shared.PageHeader>

    @if (!AuthService.IsLoggedIn)
    {
        <PenangGoAppFresh.Components.Shared.EmptyState Title="Authentication Required" Description="Please log in to access admin features.">
            <button class="btn-glass btn-primary-heritage" @onclick="@(() => Navigation.NavigateTo("/login"))">Login Now</button>
        </PenangGoAppFresh.Components.Shared.EmptyState>
    }
    else if (!AuthService.IsAdmin)
    {
        <PenangGoAppFresh.Components.Shared.EmptyState Title="Access Denied" Description="You do not have admin privileges to access this page.">
            <button class="btn-glass btn-primary-heritage" @onclick="@(() => Navigation.NavigateTo("/dashboard"))">Go to Dashboard</button>
        </PenangGoAppFresh.Components.Shared.EmptyState>
    }
    else if (users == null)
    {
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:var(--space-16);">
            @for (int i = 0; i < 6; i++) { <PenangGoAppFresh.Components.Shared.Skeleton Variant="image" Style="height:120px;" /> }
        </div>
    }
    else if (users.Count == 0)
    {
        <PenangGoAppFresh.Components.Shared.EmptyState Title="No Users Found" Description="There are no users registered in the system yet." />
    }
    else
    {
        <!-- Statistics -->
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:var(--space-16);margin-bottom:var(--space-24);">
            <div class="l1-material" style="padding:var(--space-16);text-align:center;">
                <div class="text-xl font-bold" style="color:var(--heritage-teal);">@users.Count</div>
                <div class="text-sm text-secondary mt-4">Total Users</div>
            </div>
            <div class="l1-material" style="padding:var(--space-16);text-align:center;">
                <div class="text-xl font-bold" style="color:var(--heritage-teal);">@users.Count(u => u.IsAdmin)</div>
                <div class="text-sm text-secondary mt-4">Admins</div>
            </div>
            <div class="l1-material" style="padding:var(--space-16);text-align:center;">
                <div class="text-xl font-bold" style="color:var(--heritage-teal);">@users.Count(u => u.IsActive)</div>
                <div class="text-sm text-secondary mt-4">Active Users</div>
            </div>
        </div>

        <!-- Users Table -->
        <div class="l1-material" style="overflow:hidden;">
            <table style="width:100%;border-collapse:collapse;">
                <thead>
                    <tr style="border-bottom:1px solid var(--border-subtle, rgba(255,255,255,0.08));">
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:left;">User</th>
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:left;">Email</th>
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:center;">Role</th>
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:center;">Status</th>
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:center;">Joined</th>
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in pagedItems)
                    {
                        <tr style="border-bottom:1px solid var(--border-subtle, rgba(255,255,255,0.06));">
                            <td style="padding:var(--space-12) var(--space-16);">
                                <div class="d-flex items-center gap-8">
                                    <div style="width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:var(--text-sm);font-weight:600;"
                                         class="@(user.IsAdmin ? "badge-gold" : "badge-neutral")">
                                        @user.Name[0].ToString().ToUpper()
                                    </div>
                                    <div>
                                        <div class="text-md font-medium text-primary">@user.Name</div>
                                    </div>
                                </div>
                            </td>
                            <td style="padding:var(--space-12) var(--space-16);">
                                <span class="text-sm text-secondary">@user.Email</span>
                            </td>
                            <td style="padding:var(--space-12) var(--space-16);text-align:center;">
                                @if (user.IsAdmin)
                                {
                                    <PenangGoAppFresh.Components.Shared.StatusBadge Text="Admin" Variant="gold" />
                                }
                                else
                                {
                                    <PenangGoAppFresh.Components.Shared.StatusBadge Text="User" Variant="neutral" />
                                }
                            </td>
                            <td style="padding:var(--space-12) var(--space-16);text-align:center;">
                                @if (user.IsActive)
                                {
                                    <PenangGoAppFresh.Components.Shared.StatusBadge Text="Active" Variant="teal" />
                                }
                                else
                                {
                                    <PenangGoAppFresh.Components.Shared.StatusBadge Text="Inactive" Variant="terracotta" />
                                }
                            </td>
                            <td style="padding:var(--space-12) var(--space-16);text-align:center;">
                                <span class="text-sm text-secondary">@user.CreatedAt.ToString("MMM dd, yyyy")</span>
                            </td>
                            <td style="padding:var(--space-12) var(--space-16);text-align:right;">
                                <div class="d-flex gap-8" style="justify-content:flex-end;">
                                    <button class="btn-glass btn-sm" @onclick="@(() => EditUser(user))" @onclick:stopPropagation="true">Edit</button>
                                    <button class="btn-glass btn-sm btn-primary-heritage" @onclick="@(() => ToggleRole(user))" @onclick:stopPropagation="true">
                                        @(user.IsAdmin ? "Demote" : "Promote")
                                    </button>
                                    <button class="btn-glass btn-sm @(user.IsActive ? "btn-accent-heritage" : "btn-primary-heritage")" @onclick="@(() => ToggleActive(user))" @onclick:stopPropagation="true">
                                        @(user.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                    @if (user.Id != AuthService.CurrentUser?.Id)
                                    {
                                        <button class="btn-glass btn-sm btn-accent-heritage" @onclick="@(() => DeleteUser(user))" @onclick:stopPropagation="true">Delete</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (TotalPages > 1)
            {
                <div class="d-flex justify-between items-center p-16" style="border-top:1px solid var(--border-subtle);">
                    <span class="text-xs text-secondary">Showing @((ClampedPage - 1) * PageSize + 1)–@Math.Min(ClampedPage * PageSize, users.Count) of @users.Count</span>
                    <div class="d-flex gap-8 items-center">
                        <button class="btn-glass btn-sm" @onclick="PrevPage" disabled="@(currentPage <= 1)">Previous</button>
                        <span class="text-xs text-secondary">Page @ClampedPage of @TotalPages</span>
                        <button class="btn-glass btn-sm" @onclick="NextPage" disabled="@(currentPage >= TotalPages)">Next</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Edit User Modal -->
@if (showEditModal && selectedUser != null)
{
    <div class="dialog-overlay" @onclick="CloseEditModal">
        <div class="dialog-panel" @onclick:stopPropagation="true" style="max-width:480px;width:100%;">
            <h3 class="dialog-title">Edit User: @selectedUser.Name</h3>
            <div style="display:grid;gap:var(--space-12);margin:var(--space-16) 0;">
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Name</label>
                    <input type="text" class="input-glass w-full" @bind="editUser.Name" />
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Email</label>
                    <input type="email" class="input-glass w-full" @bind="editUser.Email" />
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Phone Number</label>
                    <input type="text" class="input-glass w-full" @bind="editUser.PhoneNumber" />
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Bio</label>
                    <textarea class="input-glass w-full" @bind="editUser.Bio" rows="3"></textarea>
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Role</label>
                    <select class="input-glass w-full" @bind="editUser.IsAdmin">
                        <option value="@false">Regular User</option>
                        <option value="@true">Administrator</option>
                    </select>
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Status</label>
                    <select class="input-glass w-full" @bind="editUser.IsActive">
                        <option value="@true">Active</option>
                        <option value="@false">Inactive</option>
                    </select>
                </div>
            </div>
            <div class="dialog-actions">
                <button class="btn-glass btn-sm" @onclick="CloseEditModal">Cancel</button>
                <button class="btn-glass btn-sm btn-primary-heritage" @onclick="SaveUserChanges" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save Changes")
                </button>
            </div>
        </div>
    </div>
}

<!-- Confirm Dialog -->
<PenangGoAppFresh.Components.Shared.ConfirmDialog IsVisible="showConfirm" Title="@confirmTitle" Message="@confirmMessage" IsDestructive="@confirmDestructive" OnConfirm="RunConfirm" OnCancel="CancelConfirm" />

@code {
    private List<PenangGoApp.DataAccess.User> users;
    private bool showEditModal = false;
    private PenangGoApp.DataAccess.User? selectedUser;
    private PenangGoApp.DataAccess.User editUser = new();
    private bool isSaving = false;

    // Pagination
    private const int PageSize = 10;
    private int currentPage = 1;
    private int ClampedPage => Math.Min(currentPage, TotalPages);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(users.Count() / (double)PageSize));
    private IEnumerable<PenangGoApp.DataAccess.User> pagedItems =>
        users.Skip((ClampedPage - 1) * PageSize).Take(PageSize);
    private void NextPage() { if (currentPage < TotalPages) currentPage++; }
    private void PrevPage() { if (currentPage > 1) currentPage--; }

    // Shared confirm dialog
    private bool showConfirm;
    private string confirmTitle = "Confirm";
    private string confirmMessage = "";
    private bool confirmDestructive = true;
    private Func<Task>? confirmAction;

    private void OpenConfirm(string title, string message, Func<Task> action, bool destructive = true)
    {
        confirmTitle = title;
        confirmMessage = message;
        confirmAction = action;
        confirmDestructive = destructive;
        showConfirm = true;
    }

    private async Task RunConfirm()
    {
        showConfirm = false;
        if (confirmAction != null)
            await confirmAction();
    }

    private void CancelConfirm() => showConfirm = false;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsLoggedIn && AuthService.IsAdmin)
        {
            try
            {
                users = await UserService.GetAllUsersAsync();
            }
            catch (Exception ex)
            {
                NotificationService.RaiseNotification("Error", "Failed to load users: " + ex.Message);
                users = new List<PenangGoApp.DataAccess.User>();
            }
        }
    }

    private void EditUser(PenangGoApp.DataAccess.User user)
    {
        selectedUser = user;
        editUser = new PenangGoApp.DataAccess.User
        {
            Id = user.Id,
            Name = user.Name,
            Email = user.Email,
            PhoneNumber = user.PhoneNumber,
            Bio = user.Bio,
            IsAdmin = user.IsAdmin,
            IsActive = user.IsActive
        };
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        selectedUser = null;
        editUser = new();
    }

    private async Task SaveUserChanges()
    {
        if (selectedUser == null) return;

        isSaving = true;
        try
        {
            // Optimistically update the UI
            var originalUser = users.FirstOrDefault(u => u.Id == selectedUser.Id);
            if (originalUser != null)
            {
                originalUser.Name = editUser.Name;
                originalUser.Email = editUser.Email;
                originalUser.PhoneNumber = editUser.PhoneNumber;
                originalUser.Bio = editUser.Bio;
                originalUser.IsAdmin = editUser.IsAdmin;
                originalUser.IsActive = editUser.IsActive;
            }

            // Update the API
            var updatedUser = await UserService.UpdateUserAsync(editUser);
            if (updatedUser != null)
            {
                NotificationService.RaiseNotification("Success", $"User {editUser.Name} updated successfully");
                CloseEditModal();
                StateHasChanged();
            }
            else
            {
                // Revert optimistic update on failure
                await RefreshUsers();
                NotificationService.RaiseNotification("Error", "Failed to update user");
            }
        }
        catch (Exception ex)
        {
            // Revert optimistic update on error
            await RefreshUsers();
            NotificationService.RaiseNotification("Error", "Failed to update user: " + ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleRole(PenangGoApp.DataAccess.User user)
    {
        // Optimistically update the UI
        var originalIsAdmin = user.IsAdmin;
        user.IsAdmin = !user.IsAdmin;
        StateHasChanged();

        try
        {
            var success = await UserService.ToggleUserRoleAsync(user.Id, user.IsAdmin);
            if (success)
            {
                NotificationService.RaiseNotification("Success", $"User {user.Name} {(user.IsAdmin ? "promoted to admin" : "demoted to user")}");
            }
            else
            {
                // Revert on failure
                user.IsAdmin = originalIsAdmin;
                StateHasChanged();
                NotificationService.RaiseNotification("Error", "Failed to update user role");
            }
        }
        catch (Exception ex)
        {
            // Revert on error
            user.IsAdmin = originalIsAdmin;
            StateHasChanged();
            NotificationService.RaiseNotification("Error", "Failed to update user role: " + ex.Message);
        }
    }

    private async Task ToggleActive(PenangGoApp.DataAccess.User user)
    {
        // Optimistically update the UI
        var originalIsActive = user.IsActive;
        user.IsActive = !user.IsActive;
        StateHasChanged();

        try
        {
            var success = await UserService.ToggleUserStatusAsync(user.Id, user.IsActive);
            if (success)
            {
                NotificationService.RaiseNotification("Success", $"User {user.Name} {(user.IsActive ? "activated" : "deactivated")}");
            }
            else
            {
                // Revert on failure
                user.IsActive = originalIsActive;
                StateHasChanged();
                NotificationService.RaiseNotification("Error", "Failed to update user status");
            }
        }
        catch (Exception ex)
        {
            // Revert on error
            user.IsActive = originalIsActive;
            StateHasChanged();
            NotificationService.RaiseNotification("Error", "Failed to update user status: " + ex.Message);
        }
    }

    private void DeleteUser(PenangGoApp.DataAccess.User user)
    {
        OpenConfirm("Delete User",
            $"Delete the account of '{user.Name}' ({user.Email})?\nThis action cannot be undone.",
            () => DeleteUserConfirmed(user));
    }

    private async Task DeleteUserConfirmed(PenangGoApp.DataAccess.User user)
    {
        // Optimistically remove from UI
        var originalUsers = users.ToList();
        users.Remove(user);
        currentPage = 1;
        StateHasChanged();

        try
        {
            var success = await UserService.DeleteUserAsync(user.Id);
            if (success)
            {
                NotificationService.RaiseNotification("Success", $"User {user.Name} deleted successfully");
            }
            else
            {
                // Revert on failure
                users = originalUsers;
                StateHasChanged();
                NotificationService.RaiseNotification("Error", "Failed to delete user");
            }
        }
        catch (Exception ex)
        {
            // Revert on error
            users = originalUsers;
            StateHasChanged();
            NotificationService.RaiseNotification("Error", "Failed to delete user: " + ex.Message);
        }
    }

    private async Task RefreshUsers()
    {
        try
        {
            users = await UserService.GetAllUsersAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            NotificationService.RaiseNotification("Error", "Failed to refresh users: " + ex.Message);
        }
    }
}
