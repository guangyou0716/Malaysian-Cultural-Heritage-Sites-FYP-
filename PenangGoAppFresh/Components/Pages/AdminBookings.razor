@page "/adminbookings"
@using Microsoft.JSInterop
@inject PenangGoAppFresh.Auth.AuthService AuthService
@inject PenangGoAppFresh.Services.IApiBookingService BookingService
@inject PenangGoAppFresh.Services.NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<div class="admin-bookings-container fade-in">
    <!-- Header Section -->
    <div class="admin-header">
        <div class="header-content">
            <h1 class="page-title">
                <span class="title-icon">📅</span>
                Booking Management
            </h1>
            <p class="page-subtitle">Manage all event bookings and reservations</p>
        </div>
    </div>

    @if (!AuthService.IsAdmin)
    {
        <div class="access-denied-section">
            <div class="access-denied-card">
                <div class="access-denied-icon">🚫</div>
                <h3>Access Denied</h3>
                <p>You do not have admin privileges to access this page</p>
                <button class="btn btn-primary" @onclick="@(() => NavigationManager.NavigateTo("/dashboard"))">
                    <span class="btn-icon">🏠</span>
                    Go to Dashboard
                </button>
            </div>
        </div>
    }
    else if (bookings == null)
    {
        <div class="loading-section">
            <div class="loading-spinner">
                <div class="spinner"></div>
            </div>
            <p>Loading bookings...</p>
        </div>
    }
    else if (bookings.Count == 0)
    {
        <div class="empty-state-section">
            <div class="empty-state-card">
                <div class="empty-icon">📅</div>
                <h3>No Bookings Found</h3>
                <p>There are no bookings in the system yet.</p>
            </div>
        </div>
    }
    else
    {
        <div class="bookings-content">
            <!-- Statistics Section -->
            <div class="bookings-stats">
                <div class="stat-card">
                    <div class="stat-icon">📅</div>
                    <div class="stat-info">
                        <span class="stat-number">@bookings.Count</span>
                        <span class="stat-label">Total Bookings</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">✅</div>
                    <div class="stat-info">
                        <span class="stat-number">@bookings.Count(b => b.Status == BookingStatus.Confirmed)</span>
                        <span class="stat-label">Confirmed</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">⏳</div>
                    <div class="stat-info">
                        <span class="stat-number">@bookings.Count(b => b.Status == BookingStatus.Pending)</span>
                        <span class="stat-label">Pending</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">❌</div>
                    <div class="stat-info">
                        <span class="stat-number">@bookings.Count(b => b.Status == BookingStatus.Cancelled)</span>
                        <span class="stat-label">Cancelled</span>
                    </div>
                </div>
            </div>

            <!-- Filter Section -->
            <div class="filter-section">
                <div class="filter-controls">
                    <select class="form-control" @bind="statusFilter">
                        <option value="">All Statuses</option>
                        <option value="@BookingStatus.Pending">Pending</option>
                        <option value="@BookingStatus.Confirmed">Confirmed</option>
                        <option value="@BookingStatus.Cancelled">Cancelled</option>
                    </select>
                    <input type="text" class="form-control" placeholder="Search by user or event..." @bind="searchTerm" />
                    <button class="btn btn-outline" @onclick="ClearFilters">
                        <span class="btn-icon">🔄</span>
                        Clear Filters
                    </button>
                </div>
            </div>

            <!-- Event Groups View -->
            <div class="event-groups">
                @foreach (var eventGroup in eventGroups)
                {
                    <div class="event-group-card fade-in">
                        <div class="event-group-header">
                            <div class="event-info">
                                <h3 class="event-title">@eventGroup.EventTitle</h3>
                                <div class="event-meta">
                                    <span class="event-date">@eventGroup.EventDate.ToString("MMM dd, yyyy HH:mm")</span>
                                    <span class="event-location">📍 @eventGroup.EventLocation</span>
                                    <span class="event-price">💰 RM @eventGroup.EventPrice?.ToString("F2")</span>
                                </div>
                            </div>
                            <div class="event-stats">
                                <span class="stat-badge">@eventGroup.Bookings.Count bookings</span>
                                <span class="stat-badge confirmed">@eventGroup.Bookings.Count(b => b.Status == BookingStatus.Confirmed) confirmed</span>
                                <span class="stat-badge pending">@eventGroup.Bookings.Count(b => b.Status == BookingStatus.Pending) pending</span>
                            </div>
                        </div>
                        
                        <div class="event-actions">
                            @if (eventGroup.Bookings.Any(b => b.Status != BookingStatus.Cancelled))
                            {
                                <button class="btn btn-danger" @onclick="@(() => CancelEventForAllUsers(eventGroup.EventId, eventGroup.EventTitle))">
                                    <span class="btn-icon">🚫</span>
                                    Cancel Event for All Users
                                </button>
                            }
                        </div>
                        
                        <div class="bookings-list">
                            @foreach (var booking in eventGroup.Bookings.OrderByDescending(b => b.BookingTime))
                            {
                                <div class="booking-item">
                                    <div class="booking-user">
                                        <span class="user-icon">👤</span>
                                        <span class="user-name">@(booking.User?.Name ?? "Unknown User")</span>
                                        <span class="user-email">@(booking.User?.Email ?? "")</span>
                                    </div>
                                    <div class="booking-status">
                                        <span class="status-badge @GetStatusClass(booking.Status)">
                                            @GetStatusIcon(booking.Status) @booking.Status.ToString()
                                        </span>
                                    </div>
                                    <div class="booking-time">
                                        Booked: @booking.BookingTime.ToString("MMM dd, yyyy HH:mm")
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<PenangGoApp.DataAccess.Booking> bookings;
    private BookingStatus? statusFilter;
    private string searchTerm = "";

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAdmin)
        {
            try
            {
                bookings = await BookingService.GetAllBookingsAsync();
            }
            catch (Exception ex)
            {
                NotificationService.RaiseNotification("Error", "Failed to load bookings: " + ex.Message);
                bookings = new List<PenangGoApp.DataAccess.Booking>();
            }
        }
    }

    private IEnumerable<EventGroup> eventGroups
    {
        get
        {
            return filteredBookings
                .GroupBy(b => b.EventId)
                .Select(g => new EventGroup
                {
                    EventId = g.Key,
                    EventTitle = g.First().Event?.Title ?? "Unknown Event",
                    EventDate = g.First().Event?.StartTime ?? DateTime.MinValue,
                    EventLocation = g.First().Event?.Location ?? "Location TBD",
                    EventPrice = g.First().Event?.Price,
                    Bookings = g.ToList()
                })
                .OrderByDescending(eg => eg.EventDate);
        }
    }

    private IEnumerable<PenangGoApp.DataAccess.Booking> filteredBookings
    {
        get
        {
            var filtered = bookings.AsEnumerable();

            if (statusFilter.HasValue)
            {
                filtered = filtered.Where(b => b.Status == statusFilter.Value);
            }

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                filtered = filtered.Where(b => 
                    (b.User?.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true) ||
                    (b.Event?.Title?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true));
            }

            return filtered.OrderByDescending(b => b.BookingTime);
        }
    }

    private async Task CancelEventForAllUsers(int eventId, string eventTitle)
    {
        try
        {
            // Get all bookings for this event that are not already cancelled
            var eventBookings = bookings.Where(b => b.EventId == eventId && b.Status != BookingStatus.Cancelled).ToList();
            
            if (!eventBookings.Any())
            {
                NotificationService.RaiseNotification("Info", "No active bookings found for this event");
                return;
            }

            // Show confirmation dialog
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
                $"Are you sure you want to cancel the event '{eventTitle}' for all {eventBookings.Count} users? This action cannot be undone.");

            if (!confirmed) return;

            // Cancel all bookings for this event
            var successCount = 0;
            var failureCount = 0;

            foreach (var booking in eventBookings)
            {
                try
                {
                    var success = await BookingService.UpdateBookingStatusAsync(booking.Id, BookingStatus.Cancelled);
                    if (success)
                    {
                        successCount++;
                        booking.Status = BookingStatus.Cancelled; // Update UI optimistically
                    }
                    else
                    {
                        failureCount++;
                    }
                }
                catch (Exception ex)
                {
                    failureCount++;
                    Console.WriteLine($"Failed to cancel booking {booking.Id}: {ex.Message}");
                }
            }

            // Refresh the bookings list
            bookings = await BookingService.GetAllBookingsAsync();
            StateHasChanged();

            if (failureCount == 0)
            {
                NotificationService.RaiseNotification("Success", 
                    $"Successfully cancelled event '{eventTitle}' for all {successCount} users");
            }
            else
            {
                NotificationService.RaiseNotification("Warning", 
                    $"Cancelled {successCount} bookings, but {failureCount} failed. Please check the logs.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.RaiseNotification("Error", "Failed to cancel event: " + ex.Message);
        }
    }

    private void ClearFilters()
    {
        statusFilter = null;
        searchTerm = "";
    }

    private string GetStatusClass(BookingStatus status)
    {
        return status switch
        {
            BookingStatus.Pending => "status-pending",
            BookingStatus.Confirmed => "status-confirmed",
            BookingStatus.Cancelled => "status-cancelled",
            _ => "status-unknown"
        };
    }

    private string GetStatusIcon(BookingStatus status)
    {
        return status switch
        {
            BookingStatus.Pending => "⏳",
            BookingStatus.Confirmed => "✅",
            BookingStatus.Cancelled => "❌",
            _ => "❓"
        };
    }

    public class EventGroup
    {
        public int EventId { get; set; }
        public string EventTitle { get; set; } = string.Empty;
        public DateTime EventDate { get; set; }
        public string EventLocation { get; set; } = string.Empty;
        public decimal? EventPrice { get; set; }
        public List<PenangGoApp.DataAccess.Booking> Bookings { get; set; } = new();
    }
} 