@using PenangGoApp.DataAccess
@inject PenangGoAppFresh.Services.PanoramaContentService PanoramaService
@inject PenangGoAppFresh.Services.NotificationService NotificationService
@inject PenangGoAppFresh.Auth.AuthService AuthService
@inject IJSRuntime JSRuntime

<div class="dialog-overlay" @onclick="() => OnClose.InvokeAsync()">
    <div class="dialog-panel" style="max-width:600px;max-height:80vh;overflow-y:auto;" @onclick:stopPropagation="true">
        <div class="d-flex justify-between items-center mb-24">
            <h3 class="text-lg font-semibold m-0">Panoramas: @SelectedSite?.Name</h3>
            <button class="btn-glass btn-sm" @onclick="() => OnClose.InvokeAsync()">Close</button>
        </div>

        @if (Panoramas == null)
        {
            <div class="d-flex flex-col gap-12">
                <PenangGoAppFresh.Components.Shared.Skeleton Variant="title" />
                <PenangGoAppFresh.Components.Shared.Skeleton Variant="text" />
                <PenangGoAppFresh.Components.Shared.Skeleton Variant="text" />
            </div>
        }
        else
        {
            @if (Panoramas.Count == 0)
            {
                <div class="l1-material" style="padding:var(--space-20);margin-bottom:var(--space-16);">
                    <h4 class="text-md font-semibold mb-12">Add Panorama</h4>
                    <div class="d-flex flex-col gap-12">
                        <input class="input-glass" placeholder="Title *" @bind="newTitle" />
                        <textarea class="input-glass" placeholder="Description" rows="2" @bind="newDescription"></textarea>
                        <input class="input-glass" type="url" placeholder="Panorama image URL *" @bind="newUrl" />
                        <button class="btn-glass btn-primary-heritage" @onclick="AddPanorama" disabled="@isAdding">
                            @(isAdding ? "Adding..." : "Add Panorama")
                        </button>
                    </div>
                </div>
            }

            @foreach (var pano in Panoramas)
            {
                <div class="l1-material" style="padding:var(--space-16);margin-bottom:var(--space-12);">
                    @if (editingId == pano.Id)
                    {
                        <div class="d-flex flex-col gap-8">
                            <input class="input-glass" @bind="editTitle" />
                            <textarea class="input-glass" rows="2" @bind="editDescription"></textarea>
                            <input class="input-glass" type="url" @bind="editUrl" />
                            <div class="d-flex gap-8">
                                <button class="btn-glass btn-primary-heritage btn-sm" @onclick="SaveEdit">Save</button>
                                <button class="btn-glass btn-sm" @onclick="CancelEdit">Cancel</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-between items-center">
                            <div>
                                <h5 class="text-md font-medium m-0">@pano.Title</h5>
                                @if (!string.IsNullOrEmpty(pano.Description))
                                {
                                    <p class="text-sm text-secondary m-0 mt-4">@pano.Description</p>
                                }
                                <span class="text-xs text-tertiary">@pano.UploadedAt.ToString("MMM dd, yyyy")</span>
                            </div>
                            <div class="d-flex gap-8">
                                <button class="btn-glass btn-sm" @onclick="() => StartEdit(pano)">Edit</button>
                                <button class="btn-glass btn-sm btn-accent-heritage" @onclick="() => DeletePanorama(pano)">Delete</button>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public List<PanoramaContent>? Panoramas { get; set; }
    [Parameter] public HeritageSite? SelectedSite { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }

    private string newTitle = "", newDescription = "", newUrl = "";
    private bool isAdding;
    private int? editingId;
    private string editTitle = "", editDescription = "", editUrl = "";

    private async Task AddPanorama()
    {
        if (string.IsNullOrWhiteSpace(newTitle) || string.IsNullOrWhiteSpace(newUrl))
        {
            NotificationService.RaiseNotification("Error", "Title and URL are required");
            return;
        }
        isAdding = true;
        try
        {
            await PanoramaService.AddAsync(newTitle, newDescription, newUrl, AuthService.CurrentUser?.Id ?? 0, SelectedSite!.Id);
            NotificationService.RaiseNotification("Success", "Panorama added");
            newTitle = ""; newDescription = ""; newUrl = "";
            if (OnRefresh.HasDelegate) await OnRefresh.InvokeAsync();
        }
        catch (Exception ex) { NotificationService.RaiseNotification("Error", $"Failed: {ex.Message}"); }
        finally { isAdding = false; }
    }

    private void StartEdit(PanoramaContent p)
    {
        editingId = p.Id; editTitle = p.Title; editDescription = p.Description ?? ""; editUrl = p.PanoramaUrl;
    }

    private async Task SaveEdit()
    {
        if (editingId == null) return;
        try
        {
            var updated = new PanoramaContent { Id = editingId.Value, Title = editTitle, Description = editDescription, PanoramaUrl = editUrl };
            await PanoramaService.UpdateAsync(updated);
            NotificationService.RaiseNotification("Success", "Updated");
            editingId = null;
            if (OnRefresh.HasDelegate) await OnRefresh.InvokeAsync();
        }
        catch (Exception ex) { NotificationService.RaiseNotification("Error", $"Failed: {ex.Message}"); }
    }

    private void CancelEdit() => editingId = null;

    private async Task DeletePanorama(PanoramaContent p)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete '{p.Title}'?");
        if (!confirmed) return;
        try
        {
            await PanoramaService.DeleteAsync(p.Id);
            NotificationService.RaiseNotification("Success", "Deleted");
            if (OnRefresh.HasDelegate) await OnRefresh.InvokeAsync();
        }
        catch (Exception ex) { NotificationService.RaiseNotification("Error", $"Failed: {ex.Message}"); }
    }
}
