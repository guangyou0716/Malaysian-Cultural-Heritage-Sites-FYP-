@page "/panoramas"
@inject PenangGoAppFresh.Services.PanoramaContentService PanoramaService
@inject PenangGoAppFresh.Services.HeritageSiteService HeritageSiteService
@inject PenangGoAppFresh.Auth.AuthService AuthService

<div style="max-width:900px;margin:0 auto;">
    <PenangGoAppFresh.Components.Shared.PageHeader Title="360° Panorama Experiences" Subtitle="Immerse yourself in Penang's heritage" />

    @if (!AuthService.IsLoggedIn)
    {
        <PenangGoAppFresh.Components.Shared.EmptyState Title="Login required" Description="Please log in to view panorama content." Icon="🔐">
            <button class="btn-glass btn-primary-heritage" @onclick="@(() => Navigation.NavigateTo("/login"))">Login</button>
        </PenangGoAppFresh.Components.Shared.EmptyState>
    }
    else if (panoramas == null)
    {
        <div class="d-flex flex-col gap-16">
            <PenangGoAppFresh.Components.Shared.Skeleton Variant="image" Style="height:300px;" />
            <PenangGoAppFresh.Components.Shared.Skeleton Variant="title" />
            <PenangGoAppFresh.Components.Shared.Skeleton Variant="text" />
        </div>
    }
    else if (panoramas.Count == 0)
    {
        <PenangGoAppFresh.Components.Shared.EmptyState Title="No panoramas yet" Description="360° panorama content will appear here." Icon="📷" />
    }
    else
    {
        @foreach (var pano in panoramas)
        {
            <div class="l1-material" style="margin-bottom:var(--space-24);overflow:hidden;">
                <div style="padding:var(--space-16) var(--space-20);">
                    <h3 class="text-lg font-semibold m-0 mb-4">@pano.Title</h3>
                    @if (!string.IsNullOrEmpty(pano.Description))
                    {
                        <p class="text-sm text-secondary m-0 mb-12">@pano.Description</p>
                    }
                </div>
                <PenangGoAppFresh.Components.Shared.PanoramaViewer ImageUrl="@pano.PanoramaUrl" Height="350" />
            </div>
        }
    }
</div>

@code {
    [Inject] NavigationManager Navigation { get; set; }
    private List<PenangGoApp.DataAccess.PanoramaContent>? panoramas;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsLoggedIn)
        {
            try { panoramas = await PanoramaService.GetAllAsync(); }
            catch { panoramas = new(); }
        }
    }
}
