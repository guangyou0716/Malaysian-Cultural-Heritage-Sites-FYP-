@page "/admin-panoramas"
@using PenangGoApp.DataAccess
@inject PenangGoAppFresh.Services.PanoramaContentService PanoramaContentService
@inject PenangGoAppFresh.Services.HeritageSiteService HeritageSiteService
@inject PenangGoAppFresh.Services.NotificationService NotificationService
@inject PenangGoAppFresh.Auth.AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="admin-panoramas-container fade-in">
    <!-- Header Section -->
    <div class="admin-header">
        <div class="header-content">
            <h1 class="page-title">
                <span class="title-icon">🖼️</span>
                Panorama Content Management
            </h1>
            <p class="page-subtitle">Manage 360° panorama content for heritage sites</p>
        </div>
    </div>

    @if (!AuthService.IsAdmin)
    {
        <div class="access-denied-section">
            <div class="access-denied-card">
                <div class="access-denied-icon">🚫</div>
                <h3>Access Denied</h3>
                <p>You do not have admin privileges to access this page</p>
                <button class="btn btn-primary" @onclick="@(() => Navigation.NavigateTo("/dashboard"))">
                    <span class="btn-icon">🏠</span>
                    Go to Dashboard
                </button>
            </div>
        </div>
    }
    else if (panoramas == null)
    {
        <div class="loading-section">
            <div class="loading-spinner">
                <div class="spinner"></div>
            </div>
            <p>Loading panoramas...</p>
        </div>
    }
    else
    {
        <div class="panoramas-content">
            <!-- Statistics Section -->
            <div class="panoramas-stats">
                <div class="stat-card">
                    <div class="stat-icon">🖼️</div>
                    <div class="stat-info">
                        <span class="stat-number">@panoramas.Count</span>
                        <span class="stat-label">Total Panoramas</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">✅</div>
                    <div class="stat-info">
                        <span class="stat-number">@panoramas.Count(p => p.ApprovalStatus == ApprovalStatus.Approved)</span>
                        <span class="stat-label">Approved</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">⏳</div>
                    <div class="stat-info">
                        <span class="stat-number">@panoramas.Count(p => p.ApprovalStatus == ApprovalStatus.Pending)</span>
                        <span class="stat-label">Pending Approval</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">❌</div>
                    <div class="stat-info">
                        <span class="stat-number">@panoramas.Count(p => p.ApprovalStatus == ApprovalStatus.Rejected)</span>
                        <span class="stat-label">Rejected</span>
                    </div>
                </div>
            </div>

            <!-- Filter Section -->
            <div class="filter-section">
                <div class="filter-controls">
                    <select class="form-control" @bind="selectedSiteId">
                        <option value="0">All Sites</option>
                        @foreach (var site in heritageSites)
                        {
                            <option value="@site.Id">@site.Name</option>
                        }
                    </select>
                    <select class="form-control" @bind="statusFilter">
                        <option value="">All Statuses</option>
                        <option value="@ApprovalStatus.Approved">Approved</option>
                        <option value="@ApprovalStatus.Pending">Pending</option>
                        <option value="@ApprovalStatus.Rejected">Rejected</option>
                    </select>
                    <button class="btn btn-outline" @onclick="ClearFilters">
                        <span class="btn-icon">🔄</span>
                        Clear Filters
                    </button>
                </div>
            </div>

            <!-- Action Bar -->
            <div class="action-bar">
                <button class="btn btn-primary" @onclick="ShowAddModal">
                    <span class="btn-icon">➕</span>
                    Add Panorama
                </button>
            </div>

            <!-- Panoramas Grid -->
            <div class="panoramas-grid">
                @foreach (var panorama in filteredPanoramas)
                {
                    <div class="panorama-card fade-in">
                        <div class="panorama-header">
                            <div class="panorama-status-badges">
                                @if (panorama.ApprovalStatus == ApprovalStatus.Pending)
                                {
                                    <span class="status-badge status-pending">Pending Approval</span>
                                }
                                else if (panorama.ApprovalStatus == ApprovalStatus.Rejected)
                                {
                                    <span class="status-badge status-rejected">Rejected</span>
                                }
                                else
                                {
                                    <span class="status-badge status-approved">Approved</span>
                                }
                            </div>
                            <div class="panorama-id">#@panorama.Id</div>
                        </div>
                        
                        <div class="panorama-body">
                            <div class="panorama-info">
                                <h3 class="panorama-title">@panorama.Title</h3>
                                <div class="panorama-site">
                                    <span class="site-icon">🏛️</span>
                                    <span class="site-name">@(heritageSites.FirstOrDefault(s => s.Id == panorama.HeritageSiteId)?.Name ?? "Unknown Site")</span>
                                </div>
                                <div class="panorama-description">
                                    @(string.IsNullOrEmpty(panorama.Description) ? "No description provided" : 
                                      panorama.Description.Length > 150 ? panorama.Description.Substring(0, 150) + "..." : panorama.Description)
                                </div>
                                
                                @if (panorama.ApprovalStatus == ApprovalStatus.Pending)
                                {
                                    <div class="submission-info">
                                        <div class="submitter-info">
                                            <span class="submitter-icon">👤</span>
                                            <span class="submitter-name">Submitted by: @(panorama.Uploader?.Name ?? "Unknown User")</span>
                                        </div>
                                        <div class="submission-date">
                                            <span class="date-icon">📅</span>
                                            <span class="date-text">Submitted: @panorama.UploadedAt.ToString("MMM dd, yyyy HH:mm")</span>
                                        </div>
                                    </div>
                                }
                                
                                <div class="panorama-details">
                                    <div class="detail-item">
                                        <span class="detail-icon">🔗</span>
                                        <span class="detail-text">@panorama.PanoramaUrl</span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-icon">📅</span>
                                        <span class="detail-text">Uploaded: @panorama.UploadedAt.ToString("MMM dd, yyyy HH:mm")</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="panorama-actions">
                                @if (panorama.ApprovalStatus == ApprovalStatus.Pending)
                                {
                                    <button class="btn btn-sm btn-success" @onclick="@(() => ApprovePanorama(panorama))" @onclick:stopPropagation="true">
                                        <span class="btn-icon">✅</span>
                                        Approve
                                    </button>
                                    <button class="btn btn-sm btn-danger" @onclick="@(() => RejectPanorama(panorama))" @onclick:stopPropagation="true">
                                        <span class="btn-icon">❌</span>
                                        Reject
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-warning" @onclick="@(() => EditPanorama(panorama))" @onclick:stopPropagation="true">
                                        <span class="btn-icon">✏️</span>
                                        Edit
                                    </button>
                                    <button class="btn btn-sm btn-danger" @onclick="@(() => DeletePanorama(panorama))" @onclick:stopPropagation="true">
                                        <span class="btn-icon">🗑️</span>
                                        Delete
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Add/Edit Modal -->
@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(isEditing ? "Edit Panorama" : "Add Panorama")</h3>
                <button class="modal-close" @onclick="CloseModal">×</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Title *:</label>
                    <input type="text" class="form-control" @bind="editPanorama.Title" />
                </div>
                <div class="form-group">
                    <label>Description:</label>
                    <textarea class="form-control" @bind="editPanorama.Description"></textarea>
                </div>
                <div class="form-group">
                    <label>Panorama URL *:</label>
                    <input type="url" class="form-control" @bind="editPanorama.PanoramaUrl" />
                </div>
                <div class="form-group">
                    <label>Heritage Site *:</label>
                    <select class="form-control" @bind="editPanorama.HeritageSiteId">
                        @foreach (var site in heritageSites)
                        {
                            <option value="@site.Id">@site.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SavePanorama" disabled="@isSaving">
                    @if (isSaving) 
                    { 
                        <span class="btn-icon">⏳</span>
                        <span>Saving...</span> 
                    } 
                    else 
                    { 
                        <span class="btn-icon">💾</span>
                        <span>@(isEditing ? "Update" : "Add")</span> 
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<PanoramaContent>? panoramas;
    private List<HeritageSite> heritageSites = new();
    private int selectedSiteId = 0;
    private ApprovalStatus? statusFilter;
    private bool showModal = false;
    private bool isEditing = false;
    private bool isSaving = false;
    private PanoramaContent editPanorama = new();

    private List<PanoramaContent>? filteredPanoramas => panoramas == null ? null :
        panoramas.Where(p => 
            (selectedSiteId == 0 || p.HeritageSiteId == selectedSiteId) &&
            (!statusFilter.HasValue || p.ApprovalStatus == statusFilter.Value)
        ).OrderByDescending(p => p.ApprovalStatus == ApprovalStatus.Pending)
         .ThenBy(p => p.Title)
         .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAdmin)
        {
            heritageSites = await HeritageSiteService.GetAllAsync();
            await LoadPanoramas();
        }
    }

    private async Task LoadPanoramas()
    {
        try
        {
            panoramas = await PanoramaContentService.GetAllAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            NotificationService.RaiseNotification("Error", "Failed to load panoramas: " + ex.Message);
            panoramas = new List<PanoramaContent>();
        }
    }

    private void ShowAddModal()
    {
        isEditing = false;
        editPanorama = new PanoramaContent
        {
            HeritageSiteId = heritageSites.FirstOrDefault()?.Id ?? 0,
            ApprovalStatus = ApprovalStatus.Approved // Admin-created panoramas are auto-approved
        };
        showModal = true;
    }

    private void EditPanorama(PanoramaContent panorama)
    {
        isEditing = true;
        editPanorama = new PanoramaContent
        {
            Id = panorama.Id,
            Title = panorama.Title,
            Description = panorama.Description,
            PanoramaUrl = panorama.PanoramaUrl,
            HeritageSiteId = panorama.HeritageSiteId,
            UploadedBy = panorama.UploadedBy,
            UploadedAt = panorama.UploadedAt,
            ApprovalStatus = panorama.ApprovalStatus
        };
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        editPanorama = new();
    }

    private async Task SavePanorama()
    {
        if (string.IsNullOrWhiteSpace(editPanorama.Title) || 
            string.IsNullOrWhiteSpace(editPanorama.PanoramaUrl) || 
            editPanorama.HeritageSiteId == 0)
        {
            NotificationService.RaiseNotification("Error", "Please fill in all required fields");
            return;
        }

        isSaving = true;
        try
        {
            if (isEditing)
            {
                await PanoramaContentService.UpdateAsync(editPanorama);
                NotificationService.RaiseNotification("Success", "Panorama updated successfully");
            }
            else
            {
                await PanoramaContentService.AddAsync(
                    editPanorama.Title,
                    editPanorama.Description ?? "",
                    editPanorama.PanoramaUrl,
                    AuthService.CurrentUser?.Id ?? 0,
                    editPanorama.HeritageSiteId ?? 0
                );
                NotificationService.RaiseNotification("Success", "Panorama added successfully");
            }
            
            await LoadPanoramas();
            heritageSites = await HeritageSiteService.GetAllAsync();
            StateHasChanged();
            CloseModal();
        }
        catch (Exception ex)
        {
            NotificationService.RaiseNotification("Error", $"Failed to save panorama: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ApprovePanorama(PanoramaContent panorama)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"Are you sure you want to approve '{panorama.Title}'?\n\n" +
            $"Site: {heritageSites.FirstOrDefault(s => s.Id == panorama.HeritageSiteId)?.Name ?? "Unknown"}\n" +
            $"Submitted by: {panorama.Uploader?.Name ?? "Unknown User"}");

        if (!confirmed) return;

        try
        {
            // Update approval status
            panorama.ApprovalStatus = ApprovalStatus.Approved;
            panorama.ApprovedBy = AuthService.CurrentUser?.Id;
            panorama.ApprovedAt = DateTime.UtcNow;

            await PanoramaContentService.UpdateAsync(panorama);
            NotificationService.RaiseNotification("Success", $"Panorama '{panorama.Title}' approved successfully");
            await LoadPanoramas();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            NotificationService.RaiseNotification("Error", $"Failed to approve panorama: {ex.Message}");
        }
    }

    private async Task RejectPanorama(PanoramaContent panorama)
    {
        var reason = await JSRuntime.InvokeAsync<string>("prompt", 
            $"Please provide a reason for rejecting '{panorama.Title}':\n\n" +
            $"Site: {heritageSites.FirstOrDefault(s => s.Id == panorama.HeritageSiteId)?.Name ?? "Unknown"}\n" +
            $"Submitted by: {panorama.Uploader?.Name ?? "Unknown User"}");

        if (reason == null) return; // User cancelled

        try
        {
            // Update approval status
            panorama.ApprovalStatus = ApprovalStatus.Rejected;
            panorama.ApprovedBy = AuthService.CurrentUser?.Id;
            panorama.ApprovedAt = DateTime.UtcNow;
            panorama.ApprovalNotes = reason;

            await PanoramaContentService.UpdateAsync(panorama);
            NotificationService.RaiseNotification("Success", $"Panorama '{panorama.Title}' rejected successfully");
            await LoadPanoramas();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            NotificationService.RaiseNotification("Error", $"Failed to reject panorama: {ex.Message}");
        }
    }

    private async Task DeletePanorama(PanoramaContent panorama)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            panorama.Title != null ? 
            $"Are you sure you want to delete '{panorama.Title}'?\n\nThis action cannot be undone." : 
            "Are you sure you want to delete this panorama?\n\nThis action cannot be undone.");
            
        if (!confirmed) return;
        
        try
        {
            await PanoramaContentService.DeleteAsync(panorama.Id);
            NotificationService.RaiseNotification("Success", "Panorama deleted successfully");
            await LoadPanoramas();
        }
        catch (Exception ex)
        {
            NotificationService.RaiseNotification("Error", $"Failed to delete panorama: {ex.Message}");
        }
    }

    private void ClearFilters()
    {
        selectedSiteId = 0;
        statusFilter = null;
    }
} 