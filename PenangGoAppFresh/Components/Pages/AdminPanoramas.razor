@page "/admin-panoramas"
@using PenangGoApp.DataAccess
@inject PenangGoAppFresh.Services.PanoramaContentService PanoramaContentService
@inject PenangGoAppFresh.Services.HeritageSiteService HeritageSiteService
@inject PenangGoAppFresh.Services.NotificationService NotificationService
@inject PenangGoAppFresh.Auth.AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div>
    <PenangGoAppFresh.Components.Shared.PageHeader Title="Panorama Content Management" Subtitle="Manage 360° panorama content for heritage sites">
        <button class="btn-glass btn-sm btn-primary-heritage" @onclick="ShowAddModal">Add Panorama</button>
        <PenangGoAppFresh.Components.Shared.StatusBadge Text="Admin" Variant="gold" />
    </PenangGoAppFresh.Components.Shared.PageHeader>

    @if (!AuthService.IsAdmin)
    {
        <PenangGoAppFresh.Components.Shared.EmptyState Title="Access Denied" Description="You do not have admin privileges to access this page.">
            <button class="btn-glass btn-primary-heritage" @onclick="@(() => Navigation.NavigateTo("/dashboard"))">Go to Dashboard</button>
        </PenangGoAppFresh.Components.Shared.EmptyState>
    }
    else if (panoramas == null)
    {
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:var(--space-16);">
            @for (int i = 0; i < 4; i++) { <PenangGoAppFresh.Components.Shared.Skeleton Variant="image" Style="height:160px;" /> }
        </div>
    }
    else
    {
        <!-- Statistics -->
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:var(--space-16);margin-bottom:var(--space-24);">
            <div class="l1-material" style="padding:var(--space-16);text-align:center;">
                <div class="text-xl font-bold" style="color:var(--heritage-teal);">@panoramas.Count</div>
                <div class="text-sm text-secondary mt-4">Total Panoramas</div>
            </div>
            <div class="l1-material" style="padding:var(--space-16);text-align:center;">
                <div class="text-xl font-bold" style="color:var(--heritage-teal);">@panoramas.Count(p => p.ApprovalStatus == ApprovalStatus.Approved)</div>
                <div class="text-sm text-secondary mt-4">Approved</div>
            </div>
            <div class="l1-material" style="padding:var(--space-16);text-align:center;">
                <div class="text-xl font-bold" style="color:var(--heritage-teal);">@panoramas.Count(p => p.ApprovalStatus == ApprovalStatus.Pending)</div>
                <div class="text-sm text-secondary mt-4">Pending Approval</div>
            </div>
            <div class="l1-material" style="padding:var(--space-16);text-align:center;">
                <div class="text-xl font-bold" style="color:var(--heritage-teal);">@panoramas.Count(p => p.ApprovalStatus == ApprovalStatus.Rejected)</div>
                <div class="text-sm text-secondary mt-4">Rejected</div>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="d-flex gap-12 mb-24 items-center" style="flex-wrap:wrap;">
            <select class="input-glass" @bind="selectedSiteId" style="min-width:180px;">
                <option value="0">All Sites</option>
                @foreach (var site in heritageSites)
                {
                    <option value="@site.Id">@site.Name</option>
                }
            </select>
            <select class="input-glass" @bind="statusFilter" style="min-width:160px;">
                <option value="">All Statuses</option>
                <option value="@ApprovalStatus.Approved">Approved</option>
                <option value="@ApprovalStatus.Pending">Pending</option>
                <option value="@ApprovalStatus.Rejected">Rejected</option>
            </select>
            <button class="btn-glass btn-sm" @onclick="ClearFilters">Clear Filters</button>
        </div>

        <!-- Panoramas Table -->
        <div class="l1-material" style="overflow:hidden;">
            <table style="width:100%;border-collapse:collapse;">
                <thead>
                    <tr style="border-bottom:1px solid var(--border-subtle, rgba(255,255,255,0.08));">
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:left;">Panorama</th>
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:left;">Heritage Site</th>
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:left;">URL</th>
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:center;">Uploaded</th>
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:center;">Status</th>
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var panorama in pagedItems)
                    {
                        <tr style="border-bottom:1px solid var(--border-subtle, rgba(255,255,255,0.06));">
                            <td style="padding:var(--space-12) var(--space-16);">
                                <div class="text-md font-medium text-primary">@panorama.Title</div>
                                <div class="text-xs text-tertiary">#@panorama.Id</div>
                                @if (!string.IsNullOrEmpty(panorama.Description))
                                {
                                    <div class="text-xs text-secondary mt-4" style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                        @(panorama.Description.Length > 80 ? panorama.Description.Substring(0, 80) + "..." : panorama.Description)
                                    </div>
                                }
                            </td>
                            <td style="padding:var(--space-12) var(--space-16);">
                                <span class="text-sm text-secondary">@(heritageSites.FirstOrDefault(s => s.Id == panorama.HeritageSiteId)?.Name ?? "Unknown Site")</span>
                            </td>
                            <td style="padding:var(--space-12) var(--space-16);">
                                <span class="text-xs text-tertiary" style="max-width:200px;display:inline-block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@panorama.PanoramaUrl</span>
                            </td>
                            <td style="padding:var(--space-12) var(--space-16);text-align:center;">
                                <div class="text-sm text-secondary">@panorama.UploadedAt.ToString("MMM dd, yyyy")</div>
                                <div class="text-xs text-tertiary">@panorama.UploadedAt.ToString("HH:mm")</div>
                                @if (panorama.ApprovalStatus == ApprovalStatus.Pending && panorama.Uploader != null)
                                {
                                    <div class="text-xs text-tertiary mt-4">by @panorama.Uploader.Name</div>
                                }
                            </td>
                            <td style="padding:var(--space-12) var(--space-16);text-align:center;">
                                @if (panorama.ApprovalStatus == ApprovalStatus.Pending)
                                {
                                    <PenangGoAppFresh.Components.Shared.StatusBadge Text="Pending" Variant="gold" />
                                }
                                else if (panorama.ApprovalStatus == ApprovalStatus.Rejected)
                                {
                                    <PenangGoAppFresh.Components.Shared.StatusBadge Text="Rejected" Variant="terracotta" />
                                }
                                else
                                {
                                    <PenangGoAppFresh.Components.Shared.StatusBadge Text="Approved" Variant="teal" />
                                }
                            </td>
                            <td style="padding:var(--space-12) var(--space-16);text-align:right;">
                                <div class="d-flex gap-8" style="justify-content:flex-end;">
                                    @if (panorama.ApprovalStatus == ApprovalStatus.Pending)
                                    {
                                        <button class="btn-glass btn-sm btn-primary-heritage" @onclick="@(() => ApprovePanorama(panorama))" @onclick:stopPropagation="true">Approve</button>
                                        <button class="btn-glass btn-sm btn-accent-heritage" @onclick="@(() => RejectPanorama(panorama))" @onclick:stopPropagation="true">Reject</button>
                                    }
                                    else
                                    {
                                        <button class="btn-glass btn-sm" @onclick="@(() => EditPanorama(panorama))" @onclick:stopPropagation="true">Edit</button>
                                        <button class="btn-glass btn-sm btn-accent-heritage" @onclick="@(() => DeletePanorama(panorama))" @onclick:stopPropagation="true">Delete</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!(filteredPanoramas?.Any() ?? false))
            {
                <div style="padding:var(--space-32);text-align:center;">
                    <PenangGoAppFresh.Components.Shared.EmptyState Title="No panoramas found" Description="Try adjusting your filter criteria." />
                </div>
            }
            @if (TotalPages > 1)
            {
                <div class="d-flex justify-between items-center p-16" style="border-top:1px solid var(--border-subtle);">
                    <span class="text-xs text-secondary">Showing @((ClampedPage - 1) * PageSize + 1)–@Math.Min(ClampedPage * PageSize, FilteredItems.Count()) of @FilteredItems.Count()</span>
                    <div class="d-flex gap-8 items-center">
                        <button class="btn-glass btn-sm" @onclick="PrevPage" disabled="@(currentPage <= 1)">Previous</button>
                        <span class="text-xs text-secondary">Page @ClampedPage of @TotalPages</span>
                        <button class="btn-glass btn-sm" @onclick="NextPage" disabled="@(currentPage >= TotalPages)">Next</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Add/Edit Modal -->
@if (showModal)
{
    <div class="dialog-overlay" @onclick="CloseModal">
        <div class="dialog-panel" @onclick:stopPropagation="true" style="max-width:480px;width:100%;">
            <h3 class="dialog-title">@(isEditing ? "Edit Panorama" : "Add Panorama")</h3>
            <div style="display:grid;gap:var(--space-12);margin:var(--space-16) 0;">
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Title *</label>
                    <input type="text" class="input-glass w-full" @bind="editPanorama.Title" />
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Description</label>
                    <textarea class="input-glass w-full" @bind="editPanorama.Description"></textarea>
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Panorama URL *</label>
                    <input type="url" class="input-glass w-full" @bind="editPanorama.PanoramaUrl" />
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Heritage Site *</label>
                    <select class="input-glass w-full" @bind="editPanorama.HeritageSiteId">
                        @foreach (var site in heritageSites)
                        {
                            <option value="@site.Id">@site.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="dialog-actions">
                <button class="btn-glass btn-sm" @onclick="CloseModal">Cancel</button>
                <button class="btn-glass btn-sm btn-primary-heritage" @onclick="SavePanorama" disabled="@isSaving">
                    @(isSaving ? "Saving..." : (isEditing ? "Update" : "Add"))
                </button>
            </div>
        </div>
    </div>
}

<!-- Confirm Dialog -->
<PenangGoAppFresh.Components.Shared.ConfirmDialog IsVisible="showConfirm" Title="@confirmTitle" Message="@confirmMessage" IsDestructive="@confirmDestructive" OnConfirm="RunConfirm" OnCancel="CancelConfirm" />

@code {
    private List<PanoramaContent>? panoramas;
    private List<HeritageSite> heritageSites = new();
    private int selectedSiteId = 0;
    private ApprovalStatus? statusFilter;
    private bool showModal = false;
    private bool isEditing = false;
    private bool isSaving = false;
    private PanoramaContent editPanorama = new();

    // Pagination
    private const int PageSize = 10;
    private int currentPage = 1;
    private IEnumerable<PanoramaContent> FilteredItems => filteredPanoramas ?? new List<PanoramaContent>();
    private int ClampedPage => Math.Min(currentPage, TotalPages);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredItems.Count() / (double)PageSize));
    private IEnumerable<PanoramaContent> pagedItems =>
        FilteredItems.Skip((ClampedPage - 1) * PageSize).Take(PageSize);
    private void NextPage() { if (currentPage < TotalPages) currentPage++; }
    private void PrevPage() { if (currentPage > 1) currentPage--; }

    // Shared confirm dialog
    private bool showConfirm;
    private string confirmTitle = "Confirm";
    private string confirmMessage = "";
    private bool confirmDestructive = true;
    private Func<Task>? confirmAction;

    private void OpenConfirm(string title, string message, Func<Task> action, bool destructive = true)
    {
        confirmTitle = title;
        confirmMessage = message;
        confirmAction = action;
        confirmDestructive = destructive;
        showConfirm = true;
    }

    private async Task RunConfirm()
    {
        showConfirm = false;
        if (confirmAction != null)
            await confirmAction();
    }

    private void CancelConfirm() => showConfirm = false;

    private List<PanoramaContent>? filteredPanoramas => panoramas == null ? null :
        panoramas.Where(p =>
            (selectedSiteId == 0 || p.HeritageSiteId == selectedSiteId) &&
            (!statusFilter.HasValue || p.ApprovalStatus == statusFilter.Value)
        ).OrderByDescending(p => p.ApprovalStatus == ApprovalStatus.Pending)
         .ThenBy(p => p.Title)
         .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAdmin)
        {
            heritageSites = await HeritageSiteService.GetAllForManagementAsync();
            await LoadPanoramas();
        }
    }

    private async Task LoadPanoramas()
    {
        try
        {
            panoramas = await PanoramaContentService.GetAllAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            NotificationService.RaiseNotification("Error", "Failed to load panoramas: " + ex.Message);
            panoramas = new List<PanoramaContent>();
        }
    }

    private void ShowAddModal()
    {
        isEditing = false;
        editPanorama = new PanoramaContent
        {
            HeritageSiteId = heritageSites.FirstOrDefault()?.Id ?? 0,
            ApprovalStatus = ApprovalStatus.Approved // Admin-created panoramas are auto-approved
        };
        showModal = true;
    }

    private void EditPanorama(PanoramaContent panorama)
    {
        isEditing = true;
        editPanorama = new PanoramaContent
        {
            Id = panorama.Id,
            Title = panorama.Title,
            Description = panorama.Description,
            PanoramaUrl = panorama.PanoramaUrl,
            HeritageSiteId = panorama.HeritageSiteId,
            UploadedBy = panorama.UploadedBy,
            UploadedAt = panorama.UploadedAt,
            ApprovalStatus = panorama.ApprovalStatus
        };
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        editPanorama = new();
    }

    private async Task SavePanorama()
    {
        if (string.IsNullOrWhiteSpace(editPanorama.Title) ||
            string.IsNullOrWhiteSpace(editPanorama.PanoramaUrl) ||
            editPanorama.HeritageSiteId == 0)
        {
            NotificationService.RaiseNotification("Error", "Please fill in all required fields");
            return;
        }

        isSaving = true;
        try
        {
            if (isEditing)
            {
                await PanoramaContentService.UpdateAsync(editPanorama);
                NotificationService.RaiseNotification("Success", "Panorama updated successfully");
            }
            else
            {
                await PanoramaContentService.AddAsync(
                    editPanorama.Title,
                    editPanorama.Description ?? "",
                    editPanorama.PanoramaUrl,
                    AuthService.CurrentUser?.Id ?? 0,
                    editPanorama.HeritageSiteId ?? 0
                );
                NotificationService.RaiseNotification("Success", "Panorama added successfully");
            }

            await LoadPanoramas();
            heritageSites = await HeritageSiteService.GetAllForManagementAsync();
            StateHasChanged();
            CloseModal();
        }
        catch (Exception ex)
        {
            NotificationService.RaiseNotification("Error", $"Failed to save panorama: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ApprovePanorama(PanoramaContent panorama)
    {
        OpenConfirm("Approve Panorama",
            $"Approve '{panorama.Title}'?\nSite: {heritageSites.FirstOrDefault(s => s.Id == panorama.HeritageSiteId)?.Name ?? "Unknown"}\nSubmitted by: {panorama.Uploader?.Name ?? "Unknown User"}",
            () => ApprovePanoramaConfirmed(panorama),
            destructive: false);
    }

    private async Task ApprovePanoramaConfirmed(PanoramaContent panorama)
    {
        try
        {
            // Update approval status
            panorama.ApprovalStatus = ApprovalStatus.Approved;
            panorama.ApprovedBy = AuthService.CurrentUser?.Id;
            panorama.ApprovedAt = DateTime.UtcNow;

            await PanoramaContentService.UpdateAsync(panorama);
            NotificationService.RaiseNotification("Success", $"Panorama '{panorama.Title}' approved successfully");
            currentPage = 1;
            await LoadPanoramas();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            NotificationService.RaiseNotification("Error", $"Failed to approve panorama: {ex.Message}");
        }
    }

    private async Task RejectPanorama(PanoramaContent panorama)
    {
        var reason = await JSRuntime.InvokeAsync<string>("prompt",
            $"Please provide a reason for rejecting '{panorama.Title}':\n\n" +
            $"Site: {heritageSites.FirstOrDefault(s => s.Id == panorama.HeritageSiteId)?.Name ?? "Unknown"}\n" +
            $"Submitted by: {panorama.Uploader?.Name ?? "Unknown User"}");

        if (reason == null) return; // User cancelled

        try
        {
            // Update approval status
            panorama.ApprovalStatus = ApprovalStatus.Rejected;
            panorama.ApprovedBy = AuthService.CurrentUser?.Id;
            panorama.ApprovedAt = DateTime.UtcNow;
            panorama.ApprovalNotes = reason;

            await PanoramaContentService.UpdateAsync(panorama);
            NotificationService.RaiseNotification("Success", $"Panorama '{panorama.Title}' rejected successfully");
            await LoadPanoramas();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            NotificationService.RaiseNotification("Error", $"Failed to reject panorama: {ex.Message}");
        }
    }

    private void DeletePanorama(PanoramaContent panorama)
    {
        OpenConfirm("Delete Panorama",
            panorama.Title != null
                ? $"Delete '{panorama.Title}'?\nThis action cannot be undone."
                : "Delete this panorama?\nThis action cannot be undone.",
            () => DeletePanoramaConfirmed(panorama));
    }

    private async Task DeletePanoramaConfirmed(PanoramaContent panorama)
    {
        try
        {
            await PanoramaContentService.DeleteAsync(panorama.Id);
            NotificationService.RaiseNotification("Success", "Panorama deleted successfully");
            currentPage = 1;
            await LoadPanoramas();
        }
        catch (Exception ex)
        {
            NotificationService.RaiseNotification("Error", $"Failed to delete panorama: {ex.Message}");
        }
    }

    private void ClearFilters()
    {
        selectedSiteId = 0;
        statusFilter = null;
        currentPage = 1;
    }
}
