@page "/mybookmarks"
@inject PenangGoAppFresh.Services.BookmarkService BookmarkService
@inject PenangGoAppFresh.Auth.AuthService AuthService
@inject NavigationManager Navigation

<div>
    <PenangGoAppFresh.Components.Shared.PageHeader Title="My Bookmarks" Subtitle="Your saved heritage sites" />

    @if (!AuthService.IsLoggedIn)
    {
        <PenangGoAppFresh.Components.Shared.EmptyState Title="Login required" Description="Please log in to view your bookmarks.">
            <button class="btn-glass btn-primary-heritage" @onclick="@(() => Navigation.NavigateTo("/login"))">Login</button>
        </PenangGoAppFresh.Components.Shared.EmptyState>
    }
    else if (bookmarks == null)
    {
        <div class="grid-auto-fill">
            @for (int i = 0; i < 4; i++) { <PenangGoAppFresh.Components.Shared.Skeleton Variant="image" /> }
        </div>
    }
    else if (bookmarks.Count == 0)
    {
        <PenangGoAppFresh.Components.Shared.EmptyState Title="No bookmarks yet" Description="Save heritage sites to find them here." Icon="★">
            <button class="btn-glass btn-primary-heritage" @onclick="@(() => Navigation.NavigateTo("/map"))">Explore Map</button>
        </PenangGoAppFresh.Components.Shared.EmptyState>
    }
    else
    {
        <div class="grid-auto-fill">
            @foreach (var bm in bookmarks)
            {
                <PenangGoAppFresh.Components.Shared.SiteCard Site="bm" />
            }
        </div>
    }
</div>

@code {
    private List<PenangGoApp.DataAccess.HeritageSite>? bookmarks;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsLoggedIn && AuthService.CurrentUser != null)
        {
            try
            {
                var bmList = await BookmarkService.GetUserBookmarksAsync(AuthService.CurrentUser.Id);
                bookmarks = bmList.Select(b => b.Site ?? new PenangGoApp.DataAccess.HeritageSite { Id = b.SiteId }).ToList();
            }
            catch { bookmarks = new(); }
        }
    }
}
