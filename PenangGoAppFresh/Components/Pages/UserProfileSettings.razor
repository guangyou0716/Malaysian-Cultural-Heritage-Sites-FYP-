@page "/profile"
@inject PenangGoAppFresh.Auth.AuthService AuthService
@inject PenangGoAppFresh.Services.NotificationService NotificationService
@inject NavigationManager Navigation
@inject PenangGoAppFresh.Services.IUserService UserService
@using PenangGoApp.DataAccess

<div style="max-width:640px;margin:0 auto;">
    <PenangGoAppFresh.Components.Shared.PageHeader Title="Profile Settings" Subtitle="Manage your account and preferences" />

    @if (!AuthService.IsLoggedIn)
    {
        <PenangGoAppFresh.Components.Shared.EmptyState Title="Login required" Description="Please log in to access your profile." Icon="🔒">
            <button class="btn-glass btn-primary-heritage" @onclick="@(() => Navigation.NavigateTo("/login"))">Go to Login</button>
        </PenangGoAppFresh.Components.Shared.EmptyState>
    }
    else
    {
        <!-- Personal Information -->
        <div class="l1-material" style="padding:var(--space-24);margin-bottom:var(--space-24);">
            <h3 class="text-md font-semibold mb-16">Personal Information</h3>
            <div class="d-flex flex-col gap-16">
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:var(--space-4);">Full Name</label>
                    <input class="input-glass" @bind="profile.Name" placeholder="Your name" />
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:var(--space-4);">Email</label>
                    <input class="input-glass" type="email" @bind="profile.Email" placeholder="your@email.com" />
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:var(--space-4);">Phone</label>
                    <input class="input-glass" type="tel" @bind="profile.PhoneNumber" placeholder="+60..." />
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:var(--space-4);">Bio</label>
                    <textarea class="input-glass" rows="3" @bind="profile.Bio" placeholder="Tell us about yourself..."></textarea>
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:var(--space-4);">Accessibility preference</label>
                    <select class="input-glass" @bind="profile.AccessibilityPreference">
                        <option value="">None</option>
                        <option value="Visual">Visual</option>
                        <option value="Hearing">Hearing</option>
                        <option value="Mobility">Mobility</option>
                        <option value="Cognitive">Cognitive</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Notification Preferences -->
        <div class="l1-material" style="padding:var(--space-24);margin-bottom:var(--space-24);">
            <h3 class="text-md font-semibold mb-16">Notifications</h3>
            <div class="d-flex flex-col gap-12">
                <label class="d-flex items-center gap-12" style="cursor:pointer;">
                    <input type="checkbox" @bind="profile.EmailNotificationsEnabled" style="width:18px;height:18px;" />
                    <div>
                        <div class="text-sm font-medium">Email notifications</div>
                        <div class="text-xs text-secondary">Booking confirmations and event updates</div>
                    </div>
                </label>
                <label class="d-flex items-center gap-12" style="cursor:pointer;">
                    <input type="checkbox" @bind="profile.PushNotificationsEnabled" style="width:18px;height:18px;" />
                    <div>
                        <div class="text-sm font-medium">Push notifications</div>
                        <div class="text-xs text-secondary">In-app alerts for important updates</div>
                    </div>
                </label>
            </div>
        </div>

        <!-- Change Password -->
        <div class="l1-material" style="padding:var(--space-24);margin-bottom:var(--space-24);">
            <h3 class="text-md font-semibold mb-16">Change Password</h3>
            <div class="d-flex flex-col gap-16">
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:var(--space-4);">Current Password</label>
                    <input class="input-glass" type="password" @bind="currentPassword" />
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:var(--space-4);">New Password</label>
                    <input class="input-glass" type="password" @bind="newPassword" />
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:var(--space-4);">Confirm New Password</label>
                    <input class="input-glass" type="password" @bind="confirmPassword" />
                </div>
                <div class="text-xs text-tertiary">
                    Min 8 chars, uppercase, lowercase, number, special character
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="d-flex gap-12" style="margin-bottom:var(--space-24);">
            <button class="btn-glass btn-primary-heritage btn-lg flex-1" @onclick="SaveProfile" disabled="@isSaving">
                @(isSaving ? "Saving..." : "Save Changes")
            </button>
        </div>

        <!-- Danger Zone -->
        <div class="l1-material" style="padding:var(--space-24);border-color:rgba(196,58,58,0.2);">
            <h3 class="text-md font-semibold mb-8" style="color:var(--color-error);">Danger Zone</h3>
            <p class="text-sm text-secondary mb-16">Permanently delete your account and all data. This cannot be undone.</p>
            <button class="btn-glass btn-accent-heritage btn-sm" @onclick="ShowDeleteModal">Delete Account</button>
        </div>
    }
</div>

@if (showDeleteModal)
{
    <PenangGoAppFresh.Components.Shared.ConfirmDialog
        IsVisible="true"
        Title="Delete Account"
        Message="This will permanently delete your account and all associated data. This action cannot be undone."
        ConfirmText="Delete"
        CancelText="Cancel"
        IsDestructive="true"
        OnConfirm="DeleteAccount"
        OnCancel="CancelDelete" />
}

@code {
    private User profile = new();
    private string currentPassword = "", newPassword = "", confirmPassword = "";
    private bool isSaving, showDeleteModal;

    protected override void OnInitialized()
    {
        if (AuthService.IsLoggedIn && AuthService.CurrentUser != null)
        {
            profile = AuthService.CurrentUser;
        }
    }

    private async Task SaveProfile()
    {
        if (!AuthService.IsLoggedIn || AuthService.CurrentUser == null) return;

        if (!string.IsNullOrEmpty(newPassword))
        {
            if (newPassword != confirmPassword)
            {
                NotificationService.RaiseNotification("Error", "Passwords do not match"); return;
            }
            var changeResult = await AuthService.ChangePasswordAsync(AuthService.CurrentUser.Id, currentPassword, newPassword);
            if (!changeResult)
            {
                NotificationService.RaiseNotification("Error", "Password change failed. Check your current password."); return;
            }
            currentPassword = newPassword = confirmPassword = "";
        }

        isSaving = true;
        try
        {
            var result = await AuthService.UpdateProfileAsync(profile.Id, profile.Name, profile.PhoneNumber, profile.Bio, profile.AccessibilityPreference);
            await AuthService.UpdateNotificationSettingsAsync(profile.Id, profile.EmailNotificationsEnabled, profile.PushNotificationsEnabled);
            if (result)
                NotificationService.RaiseNotification("Success", "Profile updated");
            else
                NotificationService.RaiseNotification("Error", "Failed to update profile");
        }
        catch (Exception) { NotificationService.RaiseNotification("Error", "An error occurred"); }
        finally { isSaving = false; }
    }

    private void ShowDeleteModal() => showDeleteModal = true;
    private void CancelDelete() => showDeleteModal = false;

    private async Task DeleteAccount()
    {
        showDeleteModal = false;
        if (AuthService.CurrentUser == null) return;
        try
        {
            await UserService.DeleteUserAsync(AuthService.CurrentUser.Id);
            await AuthService.LogoutAsync();
            Navigation.NavigateTo("/");
        }
        catch { NotificationService.RaiseNotification("Error", "Failed to delete account"); }
    }
}
