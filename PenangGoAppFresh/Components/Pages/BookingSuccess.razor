@page "/booking-success"
@using PenangGoAppFresh.Services
@inject NavigationManager Navigation
@inject PenangGoAppFresh.Services.NotificationService NotificationService

<div class="d-flex items-center justify-center" style="min-height:80vh;padding:var(--space-16);">
    <PenangGoAppFresh.Components.Shared.GlassSurface Level="2" Class="p-24 text-center" Style="max-width:480px;width:100%;">
        <!-- Success Checkmark -->
        <div style="width:72px;height:72px;border-radius:var(--radius-pill);background:rgba(45,138,78,0.12);display:flex;align-items:center;justify-content:center;margin:0 auto var(--space-24);">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>

        <h1 class="text-2xl font-bold tracking-tight mb-8">Booking Confirmed!</h1>
        <p class="text-sm text-secondary mb-16">Your event has been successfully booked. You will receive a confirmation email shortly.</p>
        <p class="text-sm text-teal font-medium mb-24">Thank you for your payment!</p>

        @if (bookingDetails != null)
        {
            <PenangGoAppFresh.Components.Shared.GlassSurface Level="1" Tone="subtle" Class="p-16 text-left mb-24">
                <h3 class="text-md font-semibold text-primary mb-16">Booking Details</h3>
                <div class="d-flex flex-col gap-12">
                    <div class="d-flex justify-between items-center">
                        <span class="text-sm text-secondary">Event</span>
                        <span class="text-sm font-medium text-primary">@bookingDetails.EventTitle</span>
                    </div>
                    <div style="height:1px;background:var(--border-subtle);"></div>
                    <div class="d-flex justify-between items-center">
                        <span class="text-sm text-secondary">Date</span>
                        <span class="text-sm font-medium text-primary">@bookingDetails.EventDate.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div style="height:1px;background:var(--border-subtle);"></div>
                    <div class="d-flex justify-between items-center">
                        <span class="text-sm text-secondary">Time</span>
                        <span class="text-sm font-medium text-primary">@bookingDetails.EventTime</span>
                    </div>
                    <div style="height:1px;background:var(--border-subtle);"></div>
                    <div class="d-flex justify-between items-center">
                        <span class="text-sm text-secondary">Location</span>
                        <span class="text-sm font-medium text-primary">@bookingDetails.EventLocation</span>
                    </div>
                    <div style="height:1px;background:var(--border-subtle);"></div>
                    <div class="d-flex justify-between items-center">
                        <span class="text-sm text-secondary">Price</span>
                        <span class="text-sm font-medium text-teal">@bookingDetails.EventPrice</span>
                    </div>
                    <div style="height:1px;background:var(--border-subtle);"></div>
                    <div class="d-flex justify-between items-center">
                        <span class="text-sm text-secondary">Booking ID</span>
                        <span class="text-sm font-medium text-primary">#@bookingDetails.BookingId</span>
                    </div>
                </div>
            </PenangGoAppFresh.Components.Shared.GlassSurface>
        }
        else if (!string.IsNullOrEmpty(BookingId))
        {
            <PenangGoAppFresh.Components.Shared.GlassSurface Level="1" Tone="subtle" Class="p-16 text-left mb-24">
                <div class="d-flex justify-between mb-8">
                    <span class="text-sm text-secondary">Booking ID</span>
                    <span class="text-sm font-semibold">#@BookingId</span>
                </div>
                <div class="d-flex justify-between">
                    <span class="text-sm text-secondary">Status</span>
                    <PenangGoAppFresh.Components.Shared.StatusBadge Text="Confirmed" Variant="success" />
                </div>
            </PenangGoAppFresh.Components.Shared.GlassSurface>
        }

        <div class="d-flex gap-12">
            <button class="btn-glass btn-primary-heritage flex-1" @onclick="@(() => Navigation.NavigateTo("/events"))">Book More Events</button>
            <button class="btn-glass flex-1" @onclick="@(() => Navigation.NavigateTo("/dashboard"))">Go to Dashboard</button>
        </div>
    </PenangGoAppFresh.Components.Shared.GlassSurface>
</div>

@code {
    private BookingSuccessDetails? bookingDetails;

    [Parameter]
    [SupplyParameterFromQuery]
    public string? EventTitle { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? EventDate { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? EventTime { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? EventLocation { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? BookingId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? EventPrice { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(EventTitle))
        {
            bookingDetails = new BookingSuccessDetails
            {
                EventTitle = EventTitle,
                EventDate = DateTime.TryParse(EventDate, out var date) ? date : DateTime.Now,
                EventTime = EventTime ?? "",
                EventLocation = EventLocation ?? "",
                EventPrice = EventPrice ?? "Free",
                BookingId = BookingId ?? ""
            };
        }
    }

    public class BookingSuccessDetails
    {
        public string EventTitle { get; set; } = "";
        public DateTime EventDate { get; set; }
        public string EventTime { get; set; } = "";
        public string EventLocation { get; set; } = "";
        public string EventPrice { get; set; } = "";
        public string BookingId { get; set; } = "";
    }
}
