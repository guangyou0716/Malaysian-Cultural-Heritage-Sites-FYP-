@page "/payment"
@using PenangGoAppFresh.Services
@inject NavigationManager Navigation
@inject PenangGoAppFresh.Services.NotificationService NotificationService
@inject PenangGoAppFresh.Services.IApiBookingService BookingService
@inject PenangGoAppFresh.Auth.AuthService AuthService

<div class="payment-container fade-in">
    <div class="payment-card">
        <div class="payment-header">
            <h1 class="payment-title">Complete Your Booking</h1>
            <p class="payment-subtitle">Please complete your payment to confirm your booking</p>
        </div>

        @if (eventDetails != null)
        {
            <div class="event-summary">
                <h3>Event Summary</h3>
                <div class="summary-item">
                    <span class="summary-label">Event:</span>
                    <span class="summary-value">@eventDetails.EventTitle</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Date:</span>
                    <span class="summary-value">@eventDetails.EventDate.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Time:</span>
                    <span class="summary-value">@eventDetails.EventTime</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Location:</span>
                    <span class="summary-value">@eventDetails.EventLocation</span>
                </div>
                <div class="summary-item total">
                    <span class="summary-label">Total Amount:</span>
                    <span class="summary-value price">@eventDetails.EventPrice</span>
                </div>
            </div>

            <div class="payment-form">
                <h3>Payment Information</h3>
                
                <div class="form-group">
                    <label>Card Number</label>
                    <input type="text" class="form-control" placeholder="1234 5678 9012 3456" @bind="cardNumber" />
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label>Expiry Date</label>
                        <input type="text" class="form-control" placeholder="MM/YY" @bind="expiryDate" />
                    </div>
                    <div class="form-group">
                        <label>CVV</label>
                        <input type="text" class="form-control" placeholder="123" @bind="cvv" />
                    </div>
                </div>
                
                <div class="form-group">
                    <label>Cardholder Name</label>
                    <input type="text" class="form-control" placeholder="John Doe" @bind="cardholderName" />
                </div>
                
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" class="form-control" placeholder="john@example.com" @bind="email" />
                </div>
            </div>

            <div class="payment-actions">
                <button class="btn btn-primary" @onclick="ProcessPayment" disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <span class="loading-spinner"></span>
                        <span>Processing...</span>
                    }
                    else
                    {
                        <span class="btn-icon">💳</span>
                        <span>Pay @eventDetails.EventPrice</span>
                    }
                </button>
                <button class="btn btn-outline" @onclick="@(() => Navigation.NavigateTo("/events"))">
                    <span class="btn-icon">❌</span>
                    Cancel
                </button>
            </div>
        }
        else
        {
            <div class="error-message">
                <p>No event details found. Please try booking again.</p>
                <button class="btn btn-primary" @onclick="@(() => Navigation.NavigateTo("/events"))">
                    <span class="btn-icon">🎫</span>
                    Browse Events
                </button>
            </div>
        }
    </div>
</div>

@code {
    private EventPaymentDetails? eventDetails;
    private bool isProcessing = false;
    
    // Form fields
    private string cardNumber = "";
    private string expiryDate = "";
    private string cvv = "";
    private string cardholderName = "";
    private string email = "";

    [Parameter]
    [SupplyParameterFromQuery]
    public string? EventTitle { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? EventDate { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? EventTime { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? EventLocation { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? EventPrice { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? EventId { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(EventTitle))
        {
            eventDetails = new EventPaymentDetails
            {
                EventTitle = EventTitle,
                EventDate = DateTime.TryParse(EventDate, out var date) ? date : DateTime.Now,
                EventTime = EventTime ?? "",
                EventLocation = EventLocation ?? "",
                EventPrice = EventPrice ?? "Free",
                EventId = EventId ?? ""
            };
        }
    }

    private async Task ProcessPayment()
    {
        if (string.IsNullOrEmpty(cardNumber) || string.IsNullOrEmpty(expiryDate) || 
            string.IsNullOrEmpty(cvv) || string.IsNullOrEmpty(cardholderName) || 
            string.IsNullOrEmpty(email))
        {
            NotificationService.RaiseNotification("Validation Error", "Please fill in all payment fields.");
            return;
        }

        if (AuthService == null || !AuthService.IsLoggedIn)
        {
            NotificationService.RaiseNotification("Login Required", "Please log in to complete your booking.");
            Navigation.NavigateTo("/login");
            return;
        }

        isProcessing = true;
        StateHasChanged();

        try
        {
            // Simulate payment processing
            await Task.Delay(2000);

            // Create actual booking in database
            var eventId = int.TryParse(eventDetails?.EventId, out var id) ? id : 0;
            if (eventId == 0)
            {
                NotificationService.RaiseNotification("Error", "Invalid event ID.");
                isProcessing = false;
                return;
            }

            var booking = await BookingService.BookEventAsync(AuthService.CurrentUser.Id, eventId);
            
            if (booking != null)
            {
                // Redirect to booking success page with all details
                var queryParams = new Dictionary<string, string>
                {
                    ["EventTitle"] = eventDetails?.EventTitle ?? "",
                    ["EventDate"] = eventDetails?.EventDate.ToString("yyyy-MM-dd") ?? "",
                    ["EventTime"] = eventDetails?.EventTime ?? "",
                    ["EventLocation"] = eventDetails?.EventLocation ?? "",
                    ["EventPrice"] = eventDetails?.EventPrice ?? "",
                    ["BookingId"] = booking.Id.ToString()
                };

                var queryString = string.Join("&", queryParams.Select(kvp => $"{kvp.Key}={Uri.EscapeDataString(kvp.Value)}"));
                Navigation.NavigateTo($"/booking-success?{queryString}");
            }
            else
            {
                NotificationService.RaiseNotification("Booking Failed", "Unable to create booking. Please try again.");
                isProcessing = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Payment processing error: {ex.Message}");
            NotificationService.RaiseNotification("Payment Error", "An error occurred during payment processing. Please try again.");
            isProcessing = false;
        }
    }

    public class EventPaymentDetails
    {
        public string EventTitle { get; set; } = "";
        public DateTime EventDate { get; set; }
        public string EventTime { get; set; } = "";
        public string EventLocation { get; set; } = "";
        public string EventPrice { get; set; } = "";
        public string EventId { get; set; } = "";
    }
} 