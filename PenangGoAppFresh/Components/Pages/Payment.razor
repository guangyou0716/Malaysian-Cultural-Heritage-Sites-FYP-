@page "/payment"
@inject NavigationManager Navigation
@inject PenangGoAppFresh.Services.NotificationService NotificationService
@inject PenangGoAppFresh.Services.IBookingService BookingService
@inject PenangGoAppFresh.Auth.AuthService AuthService

<div class="payment-page" style="max-width:480px;margin:0 auto;">
    <PenangGoAppFresh.Components.Shared.PageHeader Title="Complete Booking" ShowBack="true" BackHref="/events" />

    <!-- Sandbox Banner -->
    <div class="l2-glass-subtle" style="padding:var(--space-12) var(--space-16);border-radius:var(--radius-md);margin-bottom:var(--space-24);display:flex;align-items:center;gap:var(--space-8);">
        <span class="badge badge-gold">Sandbox</span>
        <span class="text-xs text-secondary">Demo mode — no real payment will be processed</span>
    </div>

    @if (eventDetails != null)
    {
        <!-- Event Summary -->
        <div class="l1-material" style="padding:var(--space-20);margin-bottom:var(--space-24);">
            <h3 class="text-md font-semibold mb-12">Event Summary</h3>
            <div class="d-flex justify-between mb-8">
                <span class="text-sm text-secondary">Event</span>
                <span class="text-sm font-medium">@eventDetails.EventTitle</span>
            </div>
            <div class="d-flex justify-between mb-8">
                <span class="text-sm text-secondary">Date</span>
                <span class="text-sm font-medium">@eventDetails.EventDate.ToString("MMM dd, yyyy")</span>
            </div>
            <div class="d-flex justify-between mb-8">
                <span class="text-sm text-secondary">Location</span>
                <span class="text-sm font-medium">@eventDetails.EventLocation</span>
            </div>
            <div style="height:1px;background:var(--border-subtle);margin:var(--space-12) 0;"></div>
            <div class="d-flex justify-between">
                <span class="text-md font-semibold">Total</span>
                <span class="text-md font-bold text-teal">@eventDetails.EventPrice</span>
            </div>
        </div>

        <!-- Confirmation -->
        <div class="l1-material" style="padding:var(--space-20);margin-bottom:var(--space-24);">
            <p class="text-sm text-secondary" style="margin:0;line-height:var(--leading-relaxed);">
                By confirming, you agree to the event terms. A booking confirmation will be sent to your registered email.
            </p>
        </div>

        <div class="d-flex gap-12">
            <button class="btn-glass btn-primary-heritage btn-lg flex-1" @onclick="ConfirmBooking" disabled="@isProcessing">
                @if (isProcessing)
                {
                    <span>Processing...</span>
                }
                else
                {
                    <span>Confirm Booking</span>
                }
            </button>
            <button class="btn-glass btn-lg" @onclick="@(() => Navigation.NavigateTo("/events"))">
                Cancel
            </button>
        </div>
    }
    else
    {
        <PenangGoAppFresh.Components.Shared.EmptyState
            Title="No event selected"
            Description="Please select an event to book."
            Icon="🎫">
            <button class="btn-glass btn-primary-heritage" @onclick="@(() => Navigation.NavigateTo("/events"))">
                Browse Events
            </button>
        </PenangGoAppFresh.Components.Shared.EmptyState>
    }
</div>

@code {
    private EventPaymentDetails? eventDetails;
    private bool isProcessing = false;

    [Parameter] public string? EventTitle { get; set; }
    [Parameter] public string? EventDate { get; set; }
    [Parameter] public string? EventTime { get; set; }
    [Parameter] public string? EventLocation { get; set; }
    [Parameter] public string? EventPrice { get; set; }
    [Parameter] public string? EventId { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(EventTitle))
        {
            eventDetails = new EventPaymentDetails
            {
                EventTitle = EventTitle,
                EventDate = DateTime.TryParse(EventDate, out var date) ? date : DateTime.Now,
                EventTime = EventTime ?? "",
                EventLocation = EventLocation ?? "",
                EventPrice = EventPrice ?? "Free",
                EventId = EventId ?? ""
            };
        }
    }

    private async Task ConfirmBooking()
    {
        if (AuthService == null || !AuthService.IsLoggedIn)
        {
            NotificationService.RaiseNotification("Login Required", "Please log in to complete your booking.");
            Navigation.NavigateTo("/login");
            return;
        }

        isProcessing = true;
        StateHasChanged();

        try
        {
            var eventId = int.TryParse(eventDetails?.EventId, out var id) ? id : 0;
            if (eventId == 0)
            {
                NotificationService.RaiseNotification("Error", "Invalid event ID.");
                isProcessing = false;
                return;
            }

            var booking = await BookingService.BookEventAsync(AuthService.CurrentUser!.Id, eventId);

            if (booking != null)
            {
                var queryParams = new Dictionary<string, string>
                {
                    ["EventTitle"] = eventDetails?.EventTitle ?? "",
                    ["EventDate"] = eventDetails?.EventDate.ToString("yyyy-MM-dd") ?? "",
                    ["EventTime"] = eventDetails?.EventTime ?? "",
                    ["EventLocation"] = eventDetails?.EventLocation ?? "",
                    ["EventPrice"] = eventDetails?.EventPrice ?? "",
                    ["BookingId"] = booking.Id.ToString()
                };
                var queryString = string.Join("&", queryParams.Select(kvp => $"{kvp.Key}={Uri.EscapeDataString(kvp.Value)}"));
                Navigation.NavigateTo($"/booking-success?{queryString}");
            }
            else
            {
                NotificationService.RaiseNotification("Booking Failed", "Unable to create booking. Please try again.");
                isProcessing = false;
            }
        }
        catch (Exception)
        {
            NotificationService.RaiseNotification("Error", "An error occurred. Please try again.");
            isProcessing = false;
        }
    }

    public class EventPaymentDetails
    {
        public string EventTitle { get; set; } = "";
        public DateTime EventDate { get; set; }
        public string EventTime { get; set; } = "";
        public string EventLocation { get; set; } = "";
        public string EventPrice { get; set; } = "";
        public string EventId { get; set; } = "";
    }
}
