@page "/login"
@inject PenangGoAppFresh.Auth.IAuthService AuthService
@inject PenangGoAppFresh.Services.IApiService ApiService
@inject NavigationManager Navigation

<div class="d-flex items-center justify-center" style="min-height:80vh;padding:var(--space-16);">
    <PenangGoAppFresh.Components.Shared.GlassSurface Level="1" Class="p-24" Style="max-width:400px;width:100%;">
        <div class="text-center mb-24">
            <img src="/images/penanggo_logo.png" alt="PenangGo Logo" style="max-width:80px;margin-bottom:var(--space-12);" />
            <h1 class="text-2xl font-bold tracking-tight m-0">Welcome Back</h1>
            <p class="text-sm text-secondary mt-4">Sign in to your PenangGo account</p>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div style="padding:var(--space-12);border-radius:var(--radius-md);background:rgba(196,58,58,0.1);color:var(--color-error);margin-bottom:var(--space-16);">
                <span class="text-sm">@error</span>
            </div>
        }

        <div class="d-flex flex-col gap-16">
            <div>
                <label class="text-sm font-medium text-secondary d-block mb-8">Email</label>
                <input class="input-glass" type="email" @bind="email" placeholder="your@email.com" />
            </div>
            <div>
                <label class="text-sm font-medium text-secondary d-block mb-8">Password</label>
                <input class="input-glass" type="password" @bind="password" placeholder="Enter your password" />
            </div>
            <button class="btn-glass btn-primary-heritage btn-lg w-full" @onclick="LoginUser" disabled="@isLoading">
                @if (isLoading)
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation:login-spin 1s linear infinite;"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                    <span>Logging in...</span>
                }
                else
                {
                    <span>Login</span>
                }
            </button>
        </div>

        @if (showForgot)
        {
            <div style="border-top:1px solid var(--border-subtle);margin-top:var(--space-20);padding-top:var(--space-16);">
                <h3 class="text-md font-semibold mb-12" style="text-align:center;">Reset your password</h3>

                @if (!string.IsNullOrEmpty(forgotError))
                {
                    <div style="padding:var(--space-12);border-radius:var(--radius-md);background:rgba(196,58,58,0.1);color:var(--color-error);margin-bottom:var(--space-16);">
                        <span class="text-sm">@forgotError</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(forgotMessage))
                {
                    <div style="padding:var(--space-12);border-radius:var(--radius-md);background:rgba(14,116,106,0.1);color:var(--heritage-teal);margin-bottom:var(--space-16);">
                        <span class="text-sm">@forgotMessage</span>
                    </div>
                }

                @if (!codeSent)
                {
                    <div class="d-flex flex-col gap-16">
                        <div>
                            <label class="text-sm font-medium text-secondary d-block mb-8">Email</label>
                            <input class="input-glass" type="email" @bind="forgotEmail" placeholder="your@email.com" />
                        </div>
                        <button class="btn-glass btn-primary-heritage btn-lg w-full" @onclick="SendForgot" disabled="@isLoading">
                            @(isLoading ? "Sending..." : "Send reset code")
                        </button>
                        <button class="btn-glass btn-sm w-full" @onclick="CloseForgot">Back to login</button>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-col gap-16">
                        <div>
                            <label class="text-sm font-medium text-secondary d-block mb-8">Reset code</label>
                            <input class="input-glass" @bind="resetToken" placeholder="Code sent to your email" />
                        </div>
                        <div>
                            <label class="text-sm font-medium text-secondary d-block mb-8">New password</label>
                            <input class="input-glass" type="password" @bind="resetPassword" placeholder="Min 8 chars, upper, lower, digit, special" />
                        </div>
                        <div>
                            <label class="text-sm font-medium text-secondary d-block mb-8">Confirm new password</label>
                            <input class="input-glass" type="password" @bind="resetPasswordConfirm" />
                        </div>
                        <button class="btn-glass btn-primary-heritage btn-lg w-full" @onclick="DoReset" disabled="@isLoading">
                            @(isLoading ? "Resetting..." : "Reset password")
                        </button>
                        <button class="btn-glass btn-sm w-full" @onclick="CloseForgot">Back to login</button>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-sm text-center mt-8">
                <a href="#" class="text-teal font-medium" style="text-decoration:none;" @onclick="OpenForgot" @onclick:preventDefault="true">Forgot password?</a>
            </p>
        }

        <p class="text-sm text-secondary text-center mt-24">
            Don't have an account? <a href="/signup" class="text-teal font-medium" style="text-decoration:none;">Sign Up</a>
        </p>
    </PenangGoAppFresh.Components.Shared.GlassSurface>
</div>

<style>
    @@keyframes login-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
</style>

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private string error = string.Empty;
    private bool isLoading = false;

    private bool showForgot = false;
    private bool codeSent = false;
    private string forgotEmail = string.Empty;
    private string forgotError = string.Empty;
    private string forgotMessage = string.Empty;
    private string resetToken = string.Empty;
    private string resetPassword = string.Empty;
    private string resetPasswordConfirm = string.Empty;

    private void OpenForgot()
    {
        showForgot = true;
        forgotError = string.Empty;
        forgotMessage = string.Empty;
    }

    private void CloseForgot()
    {
        showForgot = false;
        codeSent = false;
        forgotError = string.Empty;
        forgotMessage = string.Empty;
    }

    private async Task SendForgot()
    {
        if (string.IsNullOrWhiteSpace(forgotEmail))
        {
            forgotError = "Please enter your email address.";
            return;
        }

        isLoading = true;
        forgotError = string.Empty;
        try
        {
            var ok = await ApiService.ForgotPasswordAsync(forgotEmail);
            if (ok)
            {
                codeSent = true;
                forgotMessage = "If that email is registered, a reset code has been sent. Check your inbox.";
            }
            else
            {
                forgotError = "Could not send a reset code right now. Please try again.";
            }
        }
        catch
        {
            forgotError = "An error occurred. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DoReset()
    {
        if (string.IsNullOrWhiteSpace(resetToken))
        {
            forgotError = "Please enter the reset code from your email.";
            return;
        }
        if (string.IsNullOrWhiteSpace(resetPassword) || resetPassword != resetPasswordConfirm)
        {
            forgotError = "Passwords do not match (or are empty).";
            return;
        }

        isLoading = true;
        forgotError = string.Empty;
        try
        {
            var ok = await ApiService.ResetPasswordAsync(resetToken.Trim(), resetPassword);
            if (ok)
            {
                forgotMessage = "Password has been reset. You can now log in with your new password.";
                codeSent = false;
                resetToken = string.Empty;
                resetPassword = string.Empty;
                resetPasswordConfirm = string.Empty;
                showForgot = false;
            }
            else
            {
                forgotError = "The reset code is invalid or has expired. Request a new one.";
            }
        }
        catch
        {
            forgotError = "An error occurred. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoginUser()
    {
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            error = "Please enter both email and password.";
            return;
        }

        isLoading = true;
        error = string.Empty;

        try
        {
            var result = await AuthService.LoginAsync(email, password);

            if (result.Success)
            {
                // Check if user is admin and redirect accordingly
                if (result.User?.IsAdmin == true)
                {
                    Navigation.NavigateTo("/admindashboard");
                }
                else
                {
                    Navigation.NavigateTo("/dashboard");
                }
            }
            else
            {
                error = result.Message;
            }
        }
        catch (Exception ex)
        {
            error = "An error occurred during login. Please try again.";
            Console.WriteLine($"Login error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}
