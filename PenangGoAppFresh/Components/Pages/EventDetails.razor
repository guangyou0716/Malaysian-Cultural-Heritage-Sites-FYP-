@page "/event/{id:int}"
@inject PenangGoAppFresh.Services.EventService EventService
@inject NavigationManager Navigation
@inject PenangGoAppFresh.Auth.AuthService AuthService

<div style="max-width:640px;margin:0 auto;">
    @if (eventData == null)
    {
        <div class="d-flex flex-col gap-16">
            <PenangGoAppFresh.Components.Shared.Skeleton Variant="image" Style="height:260px;" />
            <PenangGoAppFresh.Components.Shared.Skeleton Variant="title" />
            <PenangGoAppFresh.Components.Shared.Skeleton Variant="text" />
        </div>
    }
    else
    {
        <!-- Hero -->
        <div class="l0-content" style="position:relative;border-radius:var(--radius-xl);overflow:hidden;margin-bottom:var(--space-24);">
            <img src="@(string.IsNullOrEmpty(eventData.ImageUrl) ? "/images/penanggo_logo.png" : eventData.ImageUrl)"
                 alt="@eventData.Title" style="width:100%;height:260px;object-fit:cover;display:block;"
                 onerror="this.src='/images/penanggo_logo.png'" />
            <div class="l2-glass" style="position:absolute;bottom:var(--space-16);left:var(--space-16);right:var(--space-16);padding:var(--space-16);border-radius:var(--radius-lg);">
                <h1 class="text-xl font-bold tracking-tight m-0">@eventData.Title</h1>
                <p class="text-sm text-secondary m-0 mt-4">@eventData.Location</p>
            </div>
        </div>

        <!-- Details -->
        <div class="l1-material" style="padding:var(--space-24);margin-bottom:var(--space-24);">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-16);">
                <div>
                    <div class="text-xs text-secondary font-medium mb-4">Date</div>
                    <div class="text-sm font-medium">@eventData.StartTime.ToString("MMM dd, yyyy")</div>
                </div>
                <div>
                    <div class="text-xs text-secondary font-medium mb-4">Time</div>
                    <div class="text-sm font-medium">@eventData.StartTime.ToString("HH:mm") - @eventData.EndTime.ToString("HH:mm")</div>
                </div>
                <div>
                    <div class="text-xs text-secondary font-medium mb-4">Price</div>
                    <div class="text-sm font-medium">@(eventData.Price > 0 ? $"RM {eventData.Price:F2}" : "Free")</div>
                </div>
                <div>
                    <div class="text-xs text-secondary font-medium mb-4">Availability</div>
                    @{
                        var spots = eventData.MaxCapacity - eventData.CurrentBookings;
                    }
                    <PenangGoAppFresh.Components.Shared.StatusBadge Text="@(spots > 0 ? $"{spots} spots" : "Sold Out")" Variant="@(spots > 0 ? "teal" : "error")" />
                </div>
            </div>
        </div>

        <!-- Description -->
        <div class="l1-material" style="padding:var(--space-24);margin-bottom:var(--space-24);">
            <h2 class="text-md font-semibold mb-12">About This Event</h2>
            <p class="text-sm text-secondary" style="line-height:var(--leading-relaxed);margin:0;">@eventData.Description</p>
        </div>

        <!-- Action -->
        @if (eventData.CurrentBookings < eventData.MaxCapacity)
        {
            <button class="btn-glass btn-primary-heritage btn-lg w-full"
                    @onclick="@(() => Navigation.NavigateTo($"/payment?EventId={eventData.Id}&EventTitle={Uri.EscapeDataString(eventData.Title ?? "")}&EventDate={eventData.StartTime:yyyy-MM-dd}&EventLocation={Uri.EscapeDataString(eventData.Location ?? "")}&EventPrice={(eventData.Price > 0 ? $"RM {eventData.Price:F2}" : "Free")}"))">
                Book Now
            </button>
        }
        else
        {
            <button class="btn-glass btn-lg w-full" disabled>This event is sold out</button>
        }
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private PenangGoApp.DataAccess.Event? eventData;

    protected override async Task OnInitializedAsync()
    {
        try { eventData = await EventService.GetByIdAsync(Id); }
        catch { eventData = null; }
    }
}
