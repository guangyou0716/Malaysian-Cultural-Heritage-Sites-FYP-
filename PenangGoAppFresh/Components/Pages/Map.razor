@page "/map"
@inject NavigationManager Navigation
@inject PenangGoAppFresh.Services.HeritageSiteService HeritageSiteService
@inject PenangGoAppFresh.Services.PanoramaContentService PanoramaService
@inject PenangGoAppFresh.Services.OfflineSyncService OfflineSync
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="map-page">
    <!-- Search & Filter Bar -->
    <div class="l2-glass" style="padding:var(--space-12) var(--space-16);margin-bottom:var(--space-16);display:flex;gap:var(--space-12);align-items:center;">
        <input type="search" class="input-glass" placeholder="Search heritage sites..."
               value="@searchQuery" @oninput="OnSearchInput" style="flex:1;" />
        <button class="btn-glass btn-sm" @onclick="ToggleFilter">
            Filters @(HasActiveFilters ? "•" : "")
        </button>
        <button class="btn-glass btn-sm" @onclick="LocateUser" title="Find my location">
            📍
        </button>
    </div>

    <!-- Filter Panel -->
    @if (showFilter)
    {
        <div class="l1-material" style="padding:var(--space-16);margin-bottom:var(--space-16);">
            <div class="d-flex items-center justify-between mb-12">
                <h3 class="text-md font-semibold m-0">Filters</h3>
                <button class="btn-glass btn-sm" @onclick="ClearFilters">Clear All</button>
            </div>
            <div class="mb-12">
                <span class="text-xs text-secondary font-medium" style="display:block;margin-bottom:var(--space-8);">CATEGORY</span>
                <div class="d-flex gap-8 flex-wrap">
                    @foreach (var cat in allCategories)
                    {
                        var isActive = selectedCategories.Contains(cat);
                        <PenangGoAppFresh.Components.Shared.FilterChip Label="@cat" IsActive="@isActive"
                            IsActiveChanged="@((val) => ToggleCategory(cat, val))" />
                    }
                </div>
            </div>
            <div class="d-flex gap-8">
                <PenangGoAppFresh.Components.Shared.FilterChip Label="360° Panorama" IsActive="@filterPanorama"
                    IsActiveChanged="@((val) => { filterPanorama = val; ApplyFilters(); })" />
                <PenangGoAppFresh.Components.Shared.FilterChip Label="Accessible" IsActive="@filterAccessible"
                    IsActiveChanged="@((val) => { filterAccessible = val; ApplyFilters(); })" />
            </div>
        </div>
    }

    <div class="map-layout">
        <div class="map-pane">
            <!-- Map -->
    <div class="l1-material" style="overflow:hidden;border-radius:var(--radius-lg);margin-bottom:var(--space-16);">
        <div id="map" style="height:400px;width:100%;"></div>
    </div>

    <!-- Offline indicator -->
    @if (OfflineSync.State == PenangGoAppFresh.Services.OfflineSyncState.Offline)
    {
        <div class="l1-material" style="padding:var(--space-12) var(--space-16);margin-bottom:var(--space-12);">
            <span class="text-sm text-secondary">Offline — showing cached sites; map tiles may be unavailable.</span>
        </div>
    }

    <!-- Location Status -->
    @if (locationStatus != null)
    {
        <div class="text-xs text-secondary mb-8">@locationStatus</div>
    }
        </div> <!-- /map-pane -->
        <div class="results-pane">

    <!-- Results List -->
    <div class="d-flex justify-between items-center mb-12">
        <h2 class="text-lg font-semibold m-0">@filteredSites.Count Sites</h2>
    </div>

    @if (filteredSites.Count == 0)
    {
        <PenangGoAppFresh.Components.Shared.EmptyState Title="No sites found" Description="Try adjusting your filters or search query." />
    }
    else
    {
        <div class="grid-auto-fill-sm">
            @foreach (var site in filteredSites)
            {
                <div class="d-flex flex-col">
                    <PenangGoAppFresh.Components.Shared.SiteCard Site="site" />
                    @if (site.Latitude != 0 && site.Longitude != 0)
                    {
                        <button class="btn-glass btn-sm mt-8" style="align-self:flex-start;" @onclick="() => OpenDirections(site)">
                            Get Directions
                        </button>
                    }
                </div>
            }
        </div>
    }
        </div> <!-- /results-pane -->
    </div> <!-- /map-layout -->
</div>

@code {
    [SupplyParameterFromQuery(Name = "category")]
    public string? CategoryQuery { get; set; }

    private List<PenangGoApp.DataAccess.HeritageSite> allSites = new();
    private List<PenangGoApp.DataAccess.HeritageSite> filteredSites = new();
    private List<string> allCategories = new();
    private HashSet<string> selectedCategories = new();
    private bool showFilter;
    private bool filterPanorama;
    private bool filterAccessible;
    private string searchQuery = "";
    private string? locationStatus;
    private double? userLat;
    private double? userLng;

    private bool HasActiveFilters =>
        selectedCategories.Count < allCategories.Count || filterPanorama || filterAccessible;

    protected override async Task OnInitializedAsync()
    {
        OfflineSync.StateChanged += OnOfflineStateChanged;
        try
        {
            // Cache-first: refreshes in the background when online, falls back to SQLite cache offline
            allSites = await OfflineSync.GetHeritageSitesAsync();
            allCategories = allSites.Select(s => s.Category).Where(c => !string.IsNullOrEmpty(c)).Distinct().ToList();
            selectedCategories = allCategories.ToHashSet();

            if (!string.IsNullOrEmpty(CategoryQuery) && allCategories.Contains(CategoryQuery))
            {
                selectedCategories = new HashSet<string> { CategoryQuery };
                showFilter = true;
            }

            ApplyFilters();
        }
        catch { allSites = new(); filteredSites = new(); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && filteredSites.Count > 0)
        {
            var centerLat = filteredSites.Average(s => s.Latitude);
            var centerLng = filteredSites.Average(s => s.Longitude);
            var markers = filteredSites
                .Where(s => s.Latitude != 0 && s.Longitude != 0)
                .Select(s => new { name = s.Name, category = s.Category, x = s.Longitude, y = s.Latitude })
                .ToList();
            try
            {
                await JSRuntime.InvokeVoidAsync("leafletBlazor.initMap", "map", markers, centerLat, centerLng, 13);
            }
            catch { /* JS interop may fail in prerender */ }
        }
    }

    private void ToggleFilter() => showFilter = !showFilter;

    private void ToggleCategory(string cat, bool active)
    {
        if (active) selectedCategories.Add(cat);
        else selectedCategories.Remove(cat);
        ApplyFilters();
    }

    private void ClearFilters()
    {
        selectedCategories = allCategories.ToHashSet();
        filterPanorama = false;
        filterAccessible = false;
        searchQuery = "";
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        filteredSites = allSites
            .Where(s => string.IsNullOrEmpty(searchQuery) ||
                        s.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                        (s.Description ?? "").Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                        (s.Category ?? "").Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
            .Where(s => selectedCategories.Contains(s.Category ?? ""))
            .Where(s => !filterPanorama || s.HasPanoramaContent)
            .Where(s => !filterAccessible || s.IsAccessible)
            .OrderBy(s =>
            {
                if (userLat.HasValue && userLng.HasValue && s.Latitude != 0 && s.Longitude != 0)
                    return Haversine(userLat.Value, userLng.Value, s.Latitude, s.Longitude);
                return 0.0;
            })
            .ToList();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private async Task OpenDirections(PenangGoApp.DataAccess.HeritageSite site)
    {
        var lat = site.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var lng = site.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var destination = $"{lat},{lng}";
        string uri;
#if ANDROID
        uri = $"https://www.google.com/maps/dir/?api=1&destination={destination}";
#else
        uri = $"bingmaps:?rtp=~pos.{destination.Replace(",", "_")}";
#endif
        try
        {
            await Microsoft.Maui.ApplicationModel.Launcher.Default.OpenAsync(uri);
        }
        catch { }
    }

    private async Task LocateUser()
    {
        try
        {
            locationStatus = "Requesting location permission...";
            StateHasChanged();

            var status = await Microsoft.Maui.ApplicationModel.Permissions.CheckStatusAsync<Microsoft.Maui.ApplicationModel.Permissions.LocationWhenInUse>();
            if (status != Microsoft.Maui.ApplicationModel.PermissionStatus.Granted)
                status = await Microsoft.Maui.ApplicationModel.Permissions.RequestAsync<Microsoft.Maui.ApplicationModel.Permissions.LocationWhenInUse>();

            if (status != Microsoft.Maui.ApplicationModel.PermissionStatus.Granted)
            {
                locationStatus = "Location permission denied — showing all sites.";
                return;
            }

            locationStatus = "Locating...";
            StateHasChanged();

            var location = await Microsoft.Maui.Devices.Sensors.Geolocation.Default.GetLocationAsync(
                new Microsoft.Maui.Devices.Sensors.GeolocationRequest(
                    Microsoft.Maui.Devices.Sensors.GeolocationAccuracy.Medium, TimeSpan.FromSeconds(10)));

            if (location != null)
            {
                userLat = location.Latitude;
                userLng = location.Longitude;
                locationStatus = "Location acquired — showing nearest sites first.";
            }
            else
            {
                locationStatus = "Location unavailable — showing all sites.";
            }
        }
        catch (Exception)
        {
            locationStatus = "Location unavailable — showing all sites.";
        }
        ApplyFilters();
    }

    private static double Haversine(double lat1, double lng1, double lat2, double lng2)
    {
        var R = 6371.0;
        var dLat = (lat2 - lat1) * Math.PI / 180;
        var dLng = (lng2 - lng1) * Math.PI / 180;
        var a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2) +
                Math.Cos(lat1 * Math.PI / 180) * Math.Cos(lat2 * Math.PI / 180) *
                Math.Sin(dLng / 2) * Math.Sin(dLng / 2);
        return R * 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
    }

    public void Dispose()
    {
        OfflineSync.StateChanged -= OnOfflineStateChanged;
    }

    private void OnOfflineStateChanged() => InvokeAsync(StateHasChanged);
}
