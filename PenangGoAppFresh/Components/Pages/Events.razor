@page "/events"
@inject PenangGoAppFresh.Services.EventService EventService
@inject PenangGoAppFresh.Auth.AuthService AuthService

<div>
    <PenangGoAppFresh.Components.Shared.PageHeader Title="Events & Tours" Subtitle="Cultural experiences in Penang" />

    <!-- Filters -->
    <div class="d-flex gap-8 flex-wrap mb-24">
        <PenangGoAppFresh.Components.Shared.FilterChip Label="All" IsActive="@showAll" IsActiveChanged="@((v) => { showAll = v; if (v) selectedCategory = null; ApplyFilters(); })" />
        @foreach (var cat in categories)
        {
            <PenangGoAppFresh.Components.Shared.FilterChip Label="@cat" IsActive="@(selectedCategory == cat)"
                IsActiveChanged="@((v) => { if (v) { selectedCategory = cat; showAll = false; } ApplyFilters(); })" />
        }
    </div>

    @if (events == null)
    {
        <div class="grid-auto-fill">
            @for (int i = 0; i < 6; i++) { <PenangGoAppFresh.Components.Shared.Skeleton Variant="image" /> }
        </div>
    }
    else if (filteredEvents.Count == 0)
    {
        <PenangGoAppFresh.Components.Shared.EmptyState Title="No events found" Description="Try a different category or check back later." />
    }
    else
    {
        <div class="grid-auto-fill">
            @foreach (var ev in filteredEvents)
            {
                <PenangGoAppFresh.Components.Shared.EventCard Event="ev" />
            }
        </div>
    }
</div>

@code {
    private List<PenangGoApp.DataAccess.Event>? events;
    private List<PenangGoApp.DataAccess.Event> filteredEvents = new();
    private string[] categories = new[] { "Tour", "Festival", "Workshop", "Performance", "Exhibition" };
    private string? selectedCategory;
    private bool showAll = true;

    protected override async Task OnInitializedAsync()
    {
        try { events = await EventService.GetAllAsync(); filteredEvents = events.ToList(); }
        catch { events = new(); }
    }

    private void ApplyFilters()
    {
        if (events == null) return;
        filteredEvents = string.IsNullOrEmpty(selectedCategory) ? events.ToList()
            : events.Where(e => e.Type == selectedCategory).ToList();
    }
}
