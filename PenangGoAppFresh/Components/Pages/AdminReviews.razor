@page "/adminreviews"
@inject PenangGoAppFresh.Auth.AuthService AuthService
@inject PenangGoAppFresh.Services.IReviewService ReviewService
@inject PenangGoAppFresh.Services.NotificationService NotificationService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div>
    <PenangGoAppFresh.Components.Shared.PageHeader Title="Review Management" Subtitle="Manage user reviews and ratings for heritage sites">
        <PenangGoAppFresh.Components.Shared.StatusBadge Text="Admin" Variant="gold" />
    </PenangGoAppFresh.Components.Shared.PageHeader>

    @if (!AuthService.IsAdmin)
    {
        <PenangGoAppFresh.Components.Shared.EmptyState Title="Access Denied" Description="You do not have admin privileges to access this page.">
            <button class="btn-glass btn-primary-heritage" @onclick="@(() => Navigation.NavigateTo("/dashboard"))">Go to Dashboard</button>
        </PenangGoAppFresh.Components.Shared.EmptyState>
    }
    else if (reviews == null)
    {
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:var(--space-16);">
            @for (int i = 0; i < 6; i++) { <PenangGoAppFresh.Components.Shared.Skeleton Variant="image" Style="height:140px;" /> }
        </div>
    }
    else if (reviews.Count == 0)
    {
        <PenangGoAppFresh.Components.Shared.EmptyState Title="No Reviews Found" Description="There are no reviews in the system yet." />
    }
    else
    {
        <!-- Statistics -->
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:var(--space-16);margin-bottom:var(--space-24);">
            <div class="l1-material" style="padding:var(--space-16);text-align:center;">
                <div class="text-xl font-bold" style="color:var(--heritage-teal);">@reviews.Count</div>
                <div class="text-sm text-secondary mt-4">Total Reviews</div>
            </div>
            <div class="l1-material" style="padding:var(--space-16);text-align:center;">
                <div class="text-xl font-bold" style="color:var(--heritage-teal);">@reviews.Average(r => r.Rating).ToString("F1")</div>
                <div class="text-sm text-secondary mt-4">Average Rating</div>
            </div>
            <div class="l1-material" style="padding:var(--space-16);text-align:center;">
                <div class="text-xl font-bold" style="color:var(--heritage-teal);">@reviews.Select(r => r.SiteId).Distinct().Count()</div>
                <div class="text-sm text-secondary mt-4">Sites Reviewed</div>
            </div>
            <div class="l1-material" style="padding:var(--space-16);text-align:center;">
                <div class="text-xl font-bold" style="color:var(--heritage-teal);">@reviews.Select(r => r.UserId).Distinct().Count()</div>
                <div class="text-sm text-secondary mt-4">Unique Users</div>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="d-flex gap-12 mb-24 items-center" style="flex-wrap:wrap;">
            <select class="input-glass" @bind="ratingFilter" style="min-width:140px;">
                <option value="0">All Ratings</option>
                <option value="5">5 Stars</option>
                <option value="4">4 Stars</option>
                <option value="3">3 Stars</option>
                <option value="2">2 Stars</option>
                <option value="1">1 Star</option>
            </select>
            <select class="input-glass" @bind="statusFilter" style="min-width:140px;">
                <option value="All">All Status</option>
                <option value="Pending">Pending</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>
            </select>
            <input type="text" class="input-glass" placeholder="Search by user or site..." @bind="searchTerm" style="flex:1;min-width:200px;" />
            <button class="btn-glass btn-sm" @onclick="ClearFilters">Clear Filters</button>
        </div>

        <!-- Reviews List -->
        <div style="display:grid;gap:var(--space-12);">
            @foreach (var review in pagedItems)
            {
                <div class="l1-material" style="padding:var(--space-16);">
                    <div class="d-flex justify-between items-center" style="gap:var(--space-12);">
                        <div style="flex:1;min-width:0;">
                            <div class="d-flex items-center gap-12 mb-8" style="flex-wrap:wrap;">
                                <span class="text-md font-semibold text-primary">@(review.Site?.Name ?? "Unknown Site")</span>
                                <PenangGoAppFresh.Components.Shared.StatusBadge Text="@($"{review.Rating} star{(review.Rating != 1 ? "s" : "")}")" Variant="@(review.Rating >= 4 ? "teal" : review.Rating >= 3 ? "gold" : "terracotta")" />
                                <PenangGoAppFresh.Components.Shared.StatusBadge Text="@review.ApprovalStatus.ToString()" Variant="@GetStatusVariant(review.ApprovalStatus)" />
                                <span class="text-xs text-tertiary">#@review.Id</span>
                            </div>
                            <div class="d-flex gap-12 text-xs text-secondary mb-8" style="flex-wrap:wrap;">
                                <span>by @(review.User?.Name ?? "Anonymous")</span>
                                <span>@review.CreatedAt.ToString("MMM dd, yyyy")</span>
                                @if (review.Site?.Location != null)
                                {
                                    <span>@review.Site.Location</span>
                                }
                            </div>
                            <p class="text-sm text-primary" style="margin:0;line-height:1.5;">@review.Comment</p>
                        </div>
                        <div style="flex-shrink:0;" class="d-flex gap-8">
                            @if (review.ApprovalStatus == PenangGoApp.DataAccess.ApprovalStatus.Pending)
                            {
                                <button class="btn-glass btn-sm"
                                        @onclick="@(() => ApproveReview(review))"
                                        @onclick:stopPropagation="true"
                                        disabled="@moderatingIds.Contains(review.Id)">
                                    @(moderatingIds.Contains(review.Id) ? "Working..." : "Approve")
                                </button>
                                <button class="btn-glass btn-sm btn-accent-heritage"
                                        @onclick="@(() => RejectReview(review))"
                                        @onclick:stopPropagation="true"
                                        disabled="@moderatingIds.Contains(review.Id)">
                                    Reject
                                </button>
                            }
                            <button class="btn-glass btn-sm btn-accent-heritage"
                                    @onclick="@(() => DeleteReview(review))"
                                    @onclick:stopPropagation="true"
                                    disabled="@deletingReviewIds.Contains(review.Id)">
                                @(deletingReviewIds.Contains(review.Id) ? "Deleting..." : "Delete")
                            </button>
                        </div>
                    </div>
                </div>
            }
            @if (!filteredReviews.Any())
            {
                <div style="padding:var(--space-32);">
                    <PenangGoAppFresh.Components.Shared.EmptyState Title="No reviews found" Description="Try adjusting your search or filter criteria." />
                </div>
            }
            @if (TotalPages > 1)
            {
                <div class="d-flex justify-between items-center p-16" style="border-top:1px solid var(--border-subtle);">
                    <span class="text-xs text-secondary">Showing @((ClampedPage - 1) * PageSize + 1)–@Math.Min(ClampedPage * PageSize, filteredReviews.Count()) of @filteredReviews.Count()</span>
                    <div class="d-flex gap-8 items-center">
                        <button class="btn-glass btn-sm" @onclick="PrevPage" disabled="@(currentPage <= 1)">Previous</button>
                        <span class="text-xs text-secondary">Page @ClampedPage of @TotalPages</span>
                        <button class="btn-glass btn-sm" @onclick="NextPage" disabled="@(currentPage >= TotalPages)">Next</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Confirm Dialog -->
<PenangGoAppFresh.Components.Shared.ConfirmDialog IsVisible="showConfirm" Title="@confirmTitle" Message="@confirmMessage" IsDestructive="@confirmDestructive" OnConfirm="RunConfirm" OnCancel="CancelConfirm" />

@code {
    private List<PenangGoApp.DataAccess.Review> reviews;
    private int ratingFilter = 0;
    private string statusFilter = "All";
    private string searchTerm = "";
    private HashSet<int> deletingReviewIds = new();
    private HashSet<int> moderatingIds = new();

    // Pagination
    private const int PageSize = 10;
    private int currentPage = 1;
    private int ClampedPage => Math.Min(currentPage, TotalPages);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(filteredReviews.Count() / (double)PageSize));
    private IEnumerable<PenangGoApp.DataAccess.Review> pagedItems =>
        filteredReviews.Skip((ClampedPage - 1) * PageSize).Take(PageSize);
    private void NextPage() { if (currentPage < TotalPages) currentPage++; }
    private void PrevPage() { if (currentPage > 1) currentPage--; }

    // Shared confirm dialog
    private bool showConfirm;
    private string confirmTitle = "Confirm";
    private string confirmMessage = "";
    private bool confirmDestructive = true;
    private Func<Task>? confirmAction;

    private void OpenConfirm(string title, string message, Func<Task> action, bool destructive = true)
    {
        confirmTitle = title;
        confirmMessage = message;
        confirmAction = action;
        confirmDestructive = destructive;
        showConfirm = true;
    }

    private async Task RunConfirm()
    {
        showConfirm = false;
        if (confirmAction != null)
            await confirmAction();
    }

    private void CancelConfirm() => showConfirm = false;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAdmin)
        {
            try
            {
                reviews = await ReviewService.GetAllReviewsAsync();
            }
            catch (Exception ex)
            {
                NotificationService.RaiseNotification("Error", "Failed to load reviews: " + ex.Message);
                reviews = new List<PenangGoApp.DataAccess.Review>();
            }
        }
    }

    private IEnumerable<PenangGoApp.DataAccess.Review> filteredReviews
    {
        get
        {
            var filtered = reviews.AsEnumerable();

            if (ratingFilter > 0)
            {
                filtered = filtered.Where(r => r.Rating == ratingFilter);
            }

            if (statusFilter != "All")
            {
                filtered = filtered.Where(r => r.ApprovalStatus.ToString() == statusFilter);
            }

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                filtered = filtered.Where(r =>
                    (r.User?.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true) ||
                    (r.Site?.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true) ||
                    (r.Comment?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true));
            }

            return filtered.OrderByDescending(r => r.CreatedAt);
        }
    }

    private void DeleteReview(PenangGoApp.DataAccess.Review review)
    {
        OpenConfirm("Delete Review",
            $"Delete this review?\nSite: {review.Site?.Name ?? "Unknown"}\nUser: {review.User?.Name ?? "Anonymous"}\nRating: {review.Rating} stars\nThis action cannot be undone.",
            () => DeleteReviewConfirmed(review));
    }

    private async Task DeleteReviewConfirmed(PenangGoApp.DataAccess.Review review)
    {
        // Set loading state
        deletingReviewIds.Add(review.Id);
        currentPage = 1;
        StateHasChanged();

        // Show loading notification
        NotificationService.RaiseNotification("Info", "Deleting review...");

        // Optimistically remove from UI
        var originalReviews = reviews.ToList();
        reviews.Remove(review);
        StateHasChanged();

        try
        {
            var success = await ReviewService.DeleteReviewAsync(review.Id);
            if (success)
            {
                NotificationService.RaiseNotification("Success",
                    $"Review #{review.Id} from {review.User?.Name ?? "Anonymous"} for {review.Site?.Name ?? "Unknown Site"} has been permanently deleted.");

                // Update statistics
                StateHasChanged();
            }
            else
            {
                // Revert on failure
                reviews = originalReviews;
                StateHasChanged();
                NotificationService.RaiseNotification("Error",
                    $"Failed to delete review #{review.Id}. The review may have already been deleted or you don't have permission.");
            }
        }
        catch (Exception ex)
        {
            // Revert on error
            reviews = originalReviews;
            StateHasChanged();
            NotificationService.RaiseNotification("Error",
                $"Failed to delete review #{review.Id}: {ex.Message}\n\nPlease try again or contact support if the problem persists.");
        }
        finally
        {
            // Clear loading state
            deletingReviewIds.Remove(review.Id);
            StateHasChanged();
        }
    }

    private void ClearFilters()
    {
        ratingFilter = 0;
        statusFilter = "All";
        searchTerm = "";
        currentPage = 1;
    }

    private static string GetStatusVariant(PenangGoApp.DataAccess.ApprovalStatus status) => status switch
    {
        PenangGoApp.DataAccess.ApprovalStatus.Approved => "teal",
        PenangGoApp.DataAccess.ApprovalStatus.Rejected => "terracotta",
        _ => "gold"
    };

    private async Task ApproveReview(PenangGoApp.DataAccess.Review review)
    {
        moderatingIds.Add(review.Id);
        StateHasChanged();
        try
        {
            var success = await ReviewService.ApproveReviewAsync(review.Id);
            if (success)
            {
                NotificationService.RaiseNotification("Success", $"Review #{review.Id} approved and published.");
                reviews = await ReviewService.GetAllReviewsAsync();
            }
            else
            {
                NotificationService.RaiseNotification("Error", $"Failed to approve review #{review.Id}.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.RaiseNotification("Error", $"Failed to approve review #{review.Id}: {ex.Message}");
        }
        finally
        {
            moderatingIds.Remove(review.Id);
            StateHasChanged();
        }
    }

    private async Task RejectReview(PenangGoApp.DataAccess.Review review)
    {
        var reason = await JSRuntime.InvokeAsync<string>("prompt", "Reason for rejecting this review (shown in the audit log):");
        if (string.IsNullOrWhiteSpace(reason)) return;

        moderatingIds.Add(review.Id);
        StateHasChanged();
        try
        {
            var success = await ReviewService.RejectReviewAsync(review.Id, reason);
            if (success)
            {
                NotificationService.RaiseNotification("Success", $"Review #{review.Id} rejected.");
                reviews = await ReviewService.GetAllReviewsAsync();
            }
            else
            {
                NotificationService.RaiseNotification("Error", $"Failed to reject review #{review.Id}.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.RaiseNotification("Error", $"Failed to reject review #{review.Id}: {ex.Message}");
        }
        finally
        {
            moderatingIds.Remove(review.Id);
            StateHasChanged();
        }
    }
}
