@page "/adminevents"
@inject PenangGoAppFresh.Services.EventService EventService
@inject PenangGoAppFresh.Auth.AuthService AuthService
@inject PenangGoAppFresh.Services.NotificationService NotificationService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<div>
    <PenangGoAppFresh.Components.Shared.PageHeader Title="Events Management" Subtitle="Manage cultural events, festivals, and activities">
        <PenangGoAppFresh.Components.Shared.StatusBadge Text="Admin" Variant="gold" />
    </PenangGoAppFresh.Components.Shared.PageHeader>

    @if (!AuthService.IsAdmin)
    {
        <PenangGoAppFresh.Components.Shared.EmptyState Title="Access Denied" Description="You do not have admin privileges to access this page.">
            <button class="btn-glass btn-primary-heritage" @onclick="@(() => Navigation.NavigateTo("/dashboard"))">Go to Dashboard</button>
        </PenangGoAppFresh.Components.Shared.EmptyState>
    }
    else if (events == null)
    {
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:var(--space-16);">
            @for (int i = 0; i < 6; i++) { <PenangGoAppFresh.Components.Shared.Skeleton Variant="image" Style="height:160px;" /> }
        </div>
    }
    else if (events.Count == 0)
    {
        <PenangGoAppFresh.Components.Shared.EmptyState Title="No Events Found" Description="There are no events in the system yet.">
            <button class="btn-glass btn-primary-heritage" @onclick="ShowAddModal">Add First Event</button>
        </PenangGoAppFresh.Components.Shared.EmptyState>
    }
    else
    {
        <!-- Statistics -->
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:var(--space-16);margin-bottom:var(--space-24);">
            <div class="l1-material" style="padding:var(--space-16);text-align:center;">
                <div class="text-xl font-bold" style="color:var(--heritage-teal);">@events.Count</div>
                <div class="text-sm text-secondary mt-4">Total Events</div>
            </div>
            <div class="l1-material" style="padding:var(--space-16);text-align:center;">
                <div class="text-xl font-bold" style="color:var(--heritage-teal);">@events.Count(e => e.StartTime > DateTime.Now)</div>
                <div class="text-sm text-secondary mt-4">Upcoming</div>
            </div>
            <div class="l1-material" style="padding:var(--space-16);text-align:center;">
                <div class="text-xl font-bold" style="color:var(--heritage-teal);">@events.Count(e => e.IsActive)</div>
                <div class="text-sm text-secondary mt-4">Active</div>
            </div>
            <div class="l1-material" style="padding:var(--space-16);text-align:center;">
                <div class="text-xl font-bold" style="color:var(--heritage-teal);">RM @(events.Where(e => e.Price.HasValue).Any() ? events.Where(e => e.Price.HasValue).Average(e => e.Price.Value).ToString("F0") : "0")</div>
                <div class="text-sm text-secondary mt-4">Avg Price</div>
            </div>
            <div class="l1-material" style="padding:var(--space-16);text-align:center;">
                <div class="text-xl font-bold" style="color:var(--heritage-teal);">@(events.Any() ? events.Average(e => e.MaxCapacity).ToString("F0") : "0")</div>
                <div class="text-sm text-secondary mt-4">Avg Capacity</div>
            </div>
        </div>

        <!-- Action Bar -->
        <div class="d-flex gap-12 mb-24 items-center" style="flex-wrap:wrap;">
            <input type="text" class="input-glass" placeholder="Search events..." @bind="searchTerm" style="flex:1;min-width:200px;" />
            <button class="btn-glass btn-sm" @onclick="ClearSearch">Clear</button>
            <button class="btn-glass btn-sm btn-primary-heritage" @onclick="ShowAddModal">Add New Event</button>
        </div>

        <!-- Events Table -->
        <div class="l1-material" style="overflow:hidden;">
            <table style="width:100%;border-collapse:collapse;">
                <thead>
                    <tr style="border-bottom:1px solid var(--border-subtle, rgba(255,255,255,0.08));">
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:left;">Event</th>
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:left;">Location</th>
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:left;">Date</th>
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:center;">Price</th>
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:center;">Capacity</th>
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:center;">Status</th>
                        <th class="text-sm font-medium text-secondary" style="padding:var(--space-12) var(--space-16);text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in pagedItems)
                    {
                        <tr style="border-bottom:1px solid var(--border-subtle, rgba(255,255,255,0.06));">
                            <td style="padding:var(--space-12) var(--space-16);">
                                <div class="text-md font-medium text-primary">@ev.Title</div>
                                <div class="text-xs text-tertiary">#@ev.Id@(ev.Type != null ? $" \u00B7 {ev.Type}" : "")</div>
                            </td>
                            <td style="padding:var(--space-12) var(--space-16);">
                                <span class="text-sm text-secondary">@ev.Location</span>
                            </td>
                            <td style="padding:var(--space-12) var(--space-16);">
                                <div class="text-sm">@ev.StartTime.ToString("MMM dd, yyyy HH:mm")</div>
                                <div class="text-xs text-tertiary">to @ev.EndTime.ToString("MMM dd, yyyy HH:mm")</div>
                            </td>
                            <td style="padding:var(--space-12) var(--space-16);text-align:center;">
                                <span class="text-sm font-medium">RM @(ev.Price?.ToString("F2") ?? "Free")</span>
                            </td>
                            <td style="padding:var(--space-12) var(--space-16);text-align:center;">
                                <span class="text-sm">@ev.MaxCapacity</span>
                            </td>
                            <td style="padding:var(--space-12) var(--space-16);text-align:center;">
                                <div class="d-flex gap-4" style="justify-content:center;flex-wrap:wrap;">
                                    @if (ev.IsActive)
                                    {
                                        <PenangGoAppFresh.Components.Shared.StatusBadge Text="Active" Variant="teal" />
                                    }
                                    else
                                    {
                                        <PenangGoAppFresh.Components.Shared.StatusBadge Text="Inactive" Variant="terracotta" />
                                    }
                                    @if (ev.StartTime > DateTime.Now)
                                    {
                                        <PenangGoAppFresh.Components.Shared.StatusBadge Text="Upcoming" Variant="gold" />
                                    }
                                    else if (ev.StartTime <= DateTime.Now && ev.EndTime >= DateTime.Now)
                                    {
                                        <PenangGoAppFresh.Components.Shared.StatusBadge Text="Ongoing" Variant="teal" />
                                    }
                                    else
                                    {
                                        <PenangGoAppFresh.Components.Shared.StatusBadge Text="Past" Variant="neutral" />
                                    }
                                </div>
                            </td>
                            <td style="padding:var(--space-12) var(--space-16);text-align:right;">
                                <div class="d-flex gap-8" style="justify-content:flex-end;">
                                    <button class="btn-glass btn-sm" @onclick="@(() => EditEvent(ev))" @onclick:stopPropagation="true">Edit</button>
                                    <button class="btn-glass btn-sm btn-accent-heritage" @onclick="@(() => DeleteEvent(ev))" @onclick:stopPropagation="true">Delete</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!filteredEvents.Any())
            {
                <div style="padding:var(--space-32);text-align:center;">
                    <PenangGoAppFresh.Components.Shared.EmptyState Title="No events found" Description="Try adjusting your search criteria." />
                </div>
            }
            @if (TotalPages > 1)
            {
                <div class="d-flex justify-between items-center p-16" style="border-top:1px solid var(--border-subtle);">
                    <span class="text-xs text-secondary">Showing @((ClampedPage - 1) * PageSize + 1)–@Math.Min(ClampedPage * PageSize, filteredEvents.Count()) of @filteredEvents.Count()</span>
                    <div class="d-flex gap-8 items-center">
                        <button class="btn-glass btn-sm" @onclick="PrevPage" disabled="@(currentPage <= 1)">Previous</button>
                        <span class="text-xs text-secondary">Page @ClampedPage of @TotalPages</span>
                        <button class="btn-glass btn-sm" @onclick="NextPage" disabled="@(currentPage >= TotalPages)">Next</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Add/Edit Event Modal -->
@if (showModal)
{
    <div class="dialog-overlay" @onclick="CloseModal">
        <div class="dialog-panel" @onclick:stopPropagation="true" style="max-width:560px;width:100%;">
            <h3 class="dialog-title">@(isEditing ? "Edit Event: " + selectedEvent?.Title : "Add New Event")</h3>
            <div style="display:grid;gap:var(--space-12);margin:var(--space-16) 0;">
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Title *</label>
                    <input type="text" class="input-glass w-full" @bind="editEvent.Title" placeholder="Enter event title" />
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Description *</label>
                    <textarea class="input-glass w-full" @bind="editEvent.Description" rows="3" placeholder="Enter event description"></textarea>
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Location *</label>
                    <input type="text" class="input-glass w-full" @bind="editEvent.Location" placeholder="Enter event location" />
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-12);">
                    <div>
                        <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Start Time *</label>
                        <input type="datetime-local" class="input-glass w-full" value="@startTimeString" @onchange="@((e) => startTimeString = e.Value?.ToString() ?? "")" />
                    </div>
                    <div>
                        <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">End Time *</label>
                        <input type="datetime-local" class="input-glass w-full" value="@endTimeString" @onchange="@((e) => endTimeString = e.Value?.ToString() ?? "")" />
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-12);">
                    <div>
                        <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Price (RM)</label>
                        <input type="number" step="0.01" class="input-glass w-full" @bind="editEvent.Price" placeholder="0.00" />
                    </div>
                    <div>
                        <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Capacity</label>
                        <input type="number" class="input-glass w-full" @bind="editEvent.MaxCapacity" placeholder="100" />
                    </div>
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Type</label>
                    <input type="text" class="input-glass w-full" @bind="editEvent.Type" placeholder="e.g., Festival, Workshop, Exhibition" />
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Image URL</label>
                    <input type="url" class="input-glass w-full" @bind="editEvent.ImageUrl" placeholder="https://example.com/event-image.jpg" />
                </div>
                <div>
                    <label class="text-sm font-medium text-secondary" style="display:block;margin-bottom:4px;">Status</label>
                    <select class="input-glass w-full" @bind="editEvent.IsActive">
                        <option value="@true">Active</option>
                        <option value="@false">Inactive</option>
                    </select>
                </div>
            </div>
            <div class="dialog-actions">
                <button class="btn-glass btn-sm" @onclick="CloseModal">Cancel</button>
                <button class="btn-glass btn-sm btn-primary-heritage" @onclick="SaveEvent" disabled="@isSaving">
                    @(isSaving ? "Saving..." : (isEditing ? "Update Event" : "Add Event"))
                </button>
            </div>
        </div>
    </div>
}

<!-- Confirm Dialog -->
<PenangGoAppFresh.Components.Shared.ConfirmDialog IsVisible="showConfirm" Title="@confirmTitle" Message="@confirmMessage" IsDestructive="@confirmDestructive" OnConfirm="RunConfirm" OnCancel="CancelConfirm" />

@code {
    private List<PenangGoApp.DataAccess.Event> events;
    private string searchTerm = "";
    private bool showModal = false;
    private bool isEditing = false;
    private bool isSaving = false;
    private PenangGoApp.DataAccess.Event? selectedEvent;
    private PenangGoApp.DataAccess.Event editEvent = new();
    private string startTimeString = "";
    private string endTimeString = "";

    // Pagination
    private const int PageSize = 10;
    private int currentPage = 1;
    private int ClampedPage => Math.Min(currentPage, TotalPages);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(filteredEvents.Count() / (double)PageSize));
    private IEnumerable<PenangGoApp.DataAccess.Event> pagedItems =>
        filteredEvents.Skip((ClampedPage - 1) * PageSize).Take(PageSize);
    private void NextPage() { if (currentPage < TotalPages) currentPage++; }
    private void PrevPage() { if (currentPage > 1) currentPage--; }

    // Shared confirm dialog
    private bool showConfirm;
    private string confirmTitle = "Confirm";
    private string confirmMessage = "";
    private bool confirmDestructive = true;
    private Func<Task>? confirmAction;

    private void OpenConfirm(string title, string message, Func<Task> action, bool destructive = true)
    {
        confirmTitle = title;
        confirmMessage = message;
        confirmAction = action;
        confirmDestructive = destructive;
        showConfirm = true;
    }

    private async Task RunConfirm()
    {
        showConfirm = false;
        if (confirmAction != null)
            await confirmAction();
    }

    private void CancelConfirm() => showConfirm = false;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAdmin)
        {
            await LoadEvents();
        }
    }

    private async Task LoadEvents()
    {
        try
        {
            events = await EventService.GetAllAsync();
        }
        catch (Exception ex)
        {
            NotificationService.RaiseNotification("Error", "Failed to load events: " + ex.Message);
            events = new List<PenangGoApp.DataAccess.Event>();
        }
    }

    private IEnumerable<PenangGoApp.DataAccess.Event> filteredEvents
    {
        get
        {
            var filtered = events.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                filtered = filtered.Where(e =>
                    e.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    e.Location.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    e.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (e.Type?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true));
            }

            return filtered.OrderBy(e => e.StartTime);
        }
    }

    private void ShowAddModal()
    {
        isEditing = false;
        selectedEvent = null;
        editEvent = new PenangGoApp.DataAccess.Event
        {
            IsActive = true,
            Price = 0,
            MaxCapacity = 100
        };
        startTimeString = DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
        endTimeString = DateTime.Now.AddHours(2).ToString("yyyy-MM-ddTHH:mm");
        showModal = true;
    }

    private void EditEvent(PenangGoApp.DataAccess.Event ev)
    {
        isEditing = true;
        selectedEvent = ev;
        editEvent = new PenangGoApp.DataAccess.Event
        {
            Id = ev.Id,
            Title = ev.Title,
            Description = ev.Description,
            Location = ev.Location,
            StartTime = ev.StartTime,
            EndTime = ev.EndTime,
            Price = ev.Price,
            MaxCapacity = ev.MaxCapacity,
            Type = ev.Type,
            ImageUrl = ev.ImageUrl,
            IsActive = ev.IsActive
        };
        startTimeString = ev.StartTime.ToString("yyyy-MM-ddTHH:mm");
        endTimeString = ev.EndTime.ToString("yyyy-MM-ddTHH:mm");
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        selectedEvent = null;
        editEvent = new();
        startTimeString = "";
        endTimeString = "";
    }

    private async Task SaveEvent()
    {
        if (string.IsNullOrWhiteSpace(editEvent.Title) ||
            string.IsNullOrWhiteSpace(editEvent.Description) ||
            string.IsNullOrWhiteSpace(editEvent.Location))
        {
            NotificationService.RaiseNotification("Error", "Please fill in all required fields (Title, Description, Location)");
            return;
        }

        if (!DateTime.TryParse(startTimeString, out var startTime) || !DateTime.TryParse(endTimeString, out var endTime))
        {
            NotificationService.RaiseNotification("Error", "Please enter valid start and end times");
            return;
        }

        // Ensure we're working with DateTime objects, not TimeOnly
        startTime = DateTime.SpecifyKind(startTime, DateTimeKind.Local);
        endTime = DateTime.SpecifyKind(endTime, DateTimeKind.Local);

        if (startTime >= endTime)
        {
            NotificationService.RaiseNotification("Error", "End time must be after start time");
            return;
        }

        editEvent.StartTime = startTime;
        editEvent.EndTime = endTime;

        isSaving = true;
        try
        {
            if (isEditing)
            {
                // Update existing event - use the original event object to avoid tracking conflicts
                var originalEvent = events.FirstOrDefault(e => e.Id == selectedEvent!.Id);
                if (originalEvent != null)
                {
                    // Update the original event object properties
                    originalEvent.Title = editEvent.Title;
                    originalEvent.Description = editEvent.Description;
                    originalEvent.Location = editEvent.Location;
                    originalEvent.StartTime = editEvent.StartTime;
                    originalEvent.EndTime = editEvent.EndTime;
                    originalEvent.Price = editEvent.Price;
                    originalEvent.MaxCapacity = editEvent.MaxCapacity;
                    originalEvent.Type = editEvent.Type;
                    originalEvent.ImageUrl = editEvent.ImageUrl;
                    originalEvent.IsActive = editEvent.IsActive;
                    originalEvent.UpdatedAt = DateTime.Now;

                    // Update in database using the original event object
                    await EventService.UpdateAsync(originalEvent);
                    NotificationService.RaiseNotification("Success", $"Event '{editEvent.Title}' updated successfully");
                }
                else
                {
                    NotificationService.RaiseNotification("Error", "Event not found for updating");
                }
            }
            else
            {
                // Add new event
                editEvent.CreatedAt = DateTime.Now;
                await EventService.AddAsync(editEvent);
                events.Add(editEvent);
                NotificationService.RaiseNotification("Success", $"Event '{editEvent.Title}' added successfully");
            }

            CloseModal();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            NotificationService.RaiseNotification("Error", $"Failed to save event: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void DeleteEvent(PenangGoApp.DataAccess.Event ev)
    {
        OpenConfirm("Delete Event",
            $"Delete '{ev.Title}'?\nLocation: {ev.Location}\nDate: {ev.StartTime.ToString("MMM dd, yyyy")}\nThis action cannot be undone.",
            () => DeleteEventConfirmed(ev));
    }

    private async Task DeleteEventConfirmed(PenangGoApp.DataAccess.Event ev)
    {
        // Store original events list for potential rollback
        var originalEvents = events.ToList();

        try
        {
            // Optimistically remove from UI
            events.Remove(ev);
            StateHasChanged();

            await EventService.DeleteAsync(ev.Id);
            currentPage = 1;
            NotificationService.RaiseNotification("Success", $"Event '{ev.Title}' deleted successfully");
        }
        catch (Exception ex)
        {
            // Revert on error
            events = originalEvents;
            StateHasChanged();
            NotificationService.RaiseNotification("Error", $"Failed to delete event: {ex.Message}");
        }
    }

    private void ViewEventDetails(PenangGoApp.DataAccess.Event ev)
    {
        NotificationService.RaiseNotification("Info", $"Viewing details for {ev.Title}");
        // Navigate to event details page or show detailed modal
    }

    private void ClearSearch()
    {
        searchTerm = "";
        currentPage = 1;
    }
}
