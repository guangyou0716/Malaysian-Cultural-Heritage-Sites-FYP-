@inherits LayoutComponentBase
@inject PenangGoAppFresh.Services.NotificationService NotificationService
@inject PenangGoAppFresh.Services.OfflineSyncService OfflineSync
@inject PenangGoAppFresh.Auth.AuthService AuthService
@inject IJSRuntime JSRuntime
@implements IDisposable
@inject NavigationManager Navigation

<div class="app-shell" style="min-height:100dvh;background:var(--canvas-bg);font-family:var(--font-system);color:var(--text-primary);">
    <!-- Notification Toast -->
    @if (!string.IsNullOrEmpty(notificationTitle))
    {
        <div class="l2-glass-dense" style="position:fixed;top:calc(var(--space-16) + var(--safe-top));left:50%;transform:translateX(-50%);z-index:var(--z-toast);padding:var(--space-12) var(--space-20);max-width:400px;text-align:center;">
            <strong class="text-sm font-semibold">@notificationTitle</strong>
            @if (!string.IsNullOrEmpty(notificationBody))
            {
                <p class="text-xs text-secondary m-0 mt-4">@notificationBody</p>
            }
            <button class="btn-glass btn-sm" style="position:absolute;top:4px;right:4px;padding:2px 6px;" @onclick="ClearNotification">×</button>
        </div>
    }

    <!-- Desktop Nav Rail -->
    <PenangGoAppFresh.Components.Layout.DesktopNavRail />

    <!-- Mobile Bottom Dock -->
    <PenangGoAppFresh.Components.Layout.MobileBottomDock />

    <!-- Main Content Area -->
    <main class="main-content-area" style="padding-left:96px;padding-right:var(--space-16);padding-top:var(--space-16);padding-bottom:80px;">
        <div style="max-width:1100px;margin:0 auto;">
            @Body
        </div>
    </main>
</div>

<style>
    @@media (max-width: 767px) {
        .main-content-area {
            padding-left: var(--space-16) !important;
            padding-right: var(--space-16) !important;
            padding-bottom: 100px !important;
        }
    }
</style>

@code {
    private string? notificationTitle;
    private string? notificationBody;

    protected override async Task OnInitializedAsync()
    {
        NotificationService.OnNotificationReceived += ShowNotification;
        AuthService.AuthStateChanged += OnAuthStateChanged;
        // Restore a persisted session (refresh token) across app restarts
        await AuthService.RestoreSessionAsync();
        // Apply persisted appearance preferences
        try
        {
            await JSRuntime.InvokeVoidAsync("penangGoTheme.apply", PenangGoAppFresh.Services.AppSettings.Theme);
            await JSRuntime.InvokeVoidAsync("penangGoTheme.setReducedMotion", PenangGoAppFresh.Services.AppSettings.ReduceMotion);
        }
        catch { }

        // Prime the offline cache/outbox (SQLite) and refresh it in the background
        try { await OfflineSync.InitializeAsync(); } catch { }
    }

    private void ShowNotification(string title, string body)
    {
        notificationTitle = title;
        notificationBody = body;
        StateHasChanged();
    }

    private void ClearNotification()
    {
        notificationTitle = null;
        notificationBody = null;
        StateHasChanged();
    }

    private void OnAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NotificationService.OnNotificationReceived -= ShowNotification;
        AuthService.AuthStateChanged -= OnAuthStateChanged;
    }
}
