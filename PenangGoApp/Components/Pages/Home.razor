@page "/"

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-lg p-4" style="max-width: 400px; width: 100%;">
        <div class="text-center mb-4">
            <img src="/images/penanggo_logo.png" alt="PenangGo Logo" style="max-width: 120px;" />
        </div>
        <h2 class="text-center mb-3">Welcome to PenangGo</h2>
        <p class="text-center">Your gateway to Penang's cultural heritage and tourism experiences.</p>
        <div class="d-flex justify-content-center mt-4">
            <a class="btn btn-primary me-2" href="/login">Login</a>
            <a class="btn btn-secondary" href="/signup">Sign Up</a>
