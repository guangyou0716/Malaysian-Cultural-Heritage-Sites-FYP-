@page "/admin"
@inject PenangGoApp.Services.AuthService AuthService
@inject PenangGoApp.Services.ARContentService ARContentService
@inject PenangGoApp.Services.HeritageSiteService HeritageSiteService
@inject NavigationManager Navigation

@if (!AuthService.IsAdmin)
{
    <div class="alert alert-danger">Access denied. Admins only.</div>
    <button class="btn btn-primary" @onclick="GoDashboard">Back to Dashboard</button>
    @code {
        void GoDashboard() => Navigation.NavigateTo("/dashboard");
    }
    return;
}

<div class="container mt-4">
    <h3 class="mb-4 text-center">Admin: Manage AR Content</h3>
    <div class="row justify-content-center mb-4">
        <div class="col-md-8">
            <div class="card shadow-sm p-4">
                <h5 class="mb-3">Add New AR Content</h5>
                <div class="mb-3">
                    <label>Title</label>
                    <input class="form-control" @bind="title" />
                </div>
                <div class="mb-3">
                    <label>Description</label>
                    <textarea class="form-control" @bind="description"></textarea>
                </div>
                <div class="mb-3">
                    <label>Image URL</label>
                    <input class="form-control" @bind="imageUrl" />
                </div>
                <div class="mb-3">
                    <label>Link to Heritage Site</label>
                    <select class="form-select" @bind="heritageSiteId">
                        <option value="">-- None --</option>
                        @if (heritageSites != null)
                        {
                            @foreach (var site in heritageSites)
                            {
                                <option value="@site.Id">@site.Name</option>
                            }
                        }
                    </select>
                </div>
                <button class="btn btn-success w-100" @onclick="AddARContent">Add AR Content</button>
            </div>
        </div>
    </div>
    @if (arContents != null && arContents.Count > 0)
    {
        <h5 class="mb-3">All AR Content</h5>
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Image</th>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Heritage Site</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ar in arContents)
                    {
                        <tr>
                            <td style="width:120px"><img src="@ar.ImageUrl" alt="@ar.Title" style="max-width:100px;max-height:80px;object-fit:cover;" /></td>
                            <td>@ar.Title</td>
                            <td>@ar.Description</td>
                            <td>@ar.HeritageSite?.Name</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private string title;
    private string description;
    private string imageUrl;
    private int? heritageSiteId;
    private List<PenangGoApp.Data.ARContent> arContents = new();
    private List<PenangGoApp.Data.HeritageSite> heritageSites = new();

    protected override async Task OnInitializedAsync()
    {
        arContents = await ARContentService.GetAllAsync();
        heritageSites = await HeritageSiteService.GetAllAsync();
    }

    private async Task AddARContent()
    {
        var ar = new PenangGoApp.Data.ARContent
        {
            Title = title,
            Description = description,
            ImageUrl = imageUrl,
            UploadedBy = AuthService.CurrentUser.Id,
            UploadedAt = DateTime.Now,
            HeritageSiteId = heritageSiteId
        };
        await ARContentService.AddAsync(ar.Title, ar.Description, ar.ImageUrl, ar.UploadedBy ?? 0); // Update AddAsync to accept ARContent if needed
        arContents = await ARContentService.GetAllAsync();
        title = description = imageUrl = string.Empty;
        heritageSiteId = null;
        StateHasChanged();
    }
} 