@page "/admin-sites"
@inject PenangGoApp.Services.HeritageSiteService HeritageSiteService
@inject PenangGoApp.Services.AuthService AuthService
@inject NavigationManager Navigation

@if (!AuthService.IsAdmin)
{
    <div class="alert alert-danger">Access denied. Admins only.</div>
    <button class="btn btn-primary" @onclick="GoDashboard">Back to Dashboard</button>
    @code {
        void GoDashboard() => Navigation.NavigateTo("/dashboard");
    }
    return;
}

<div class="container mt-4">
    <h3 class="mb-4 text-center">Admin: Manage Heritage Sites</h3>
    <div class="row justify-content-center mb-4">
        <div class="col-md-8">
            <div class="card shadow-sm p-4">
                <h5 class="mb-3">Add New Heritage Site</h5>
                <div class="mb-3">
                    <label>Name</label>
                    <input class="form-control" @bind="name" />
                </div>
                <div class="mb-3">
                    <label>Description</label>
                    <textarea class="form-control" @bind="description"></textarea>
                </div>
                <div class="mb-3">
                    <label>Image URL</label>
                    <input class="form-control" @bind="imageUrl" />
                </div>
                <button class="btn btn-success w-100" @onclick="AddSite">Add Site</button>
            </div>
        </div>
    </div>
    @if (sites != null && sites.Count > 0)
    {
        <h5 class="mb-3">All Heritage Sites</h5>
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var site in sites)
                    {
                        <tr>
                            <td style="width:120px"><img src="@site.ImageUrl" alt="@site.Name" style="max-width:100px;max-height:80px;object-fit:cover;" /></td>
                            <td>@site.Name</td>
                            <td>@site.Description</td>
                            <td>
                                <button class="btn btn-danger btn-sm" @onclick="() => DeleteSite(site.Id)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private string name;
    private string description;
    private string imageUrl;
    private List<PenangGoApp.Data.HeritageSite> sites = new();

    protected override async Task OnInitializedAsync()
    {
        sites = await HeritageSiteService.GetAllAsync();
    }

    private async Task AddSite()
    {
        var site = new PenangGoApp.Data.HeritageSite
        {
            Name = name,
            Description = description,
            ImageUrl = imageUrl
        };
        await HeritageSiteService.AddAsync(site);
        sites = await HeritageSiteService.GetAllAsync();
        name = description = imageUrl = string.Empty;
        StateHasChanged();
    }

    private async Task DeleteSite(int id)
    {
        await HeritageSiteService.DeleteAsync(id);
        sites = await HeritageSiteService.GetAllAsync();
        StateHasChanged();
    }
} 