@page "/dashboard"
@inject PenangGoApp.Services.AuthService AuthService
@inject NavigationManager Navigation

<h2>Tourism Features Dashboard</h2>
@if (AuthService.IsLoggedIn)
{
    <p>Welcome, <b>@AuthService.CurrentUser.Name</b> (@(AuthService.IsAdmin ? "Admin" : "User"))</p>
    <button class="btn btn-sm btn-outline-secondary mb-3" @onclick="Logout">Logout</button>
}

<div class="list-group">
    <a class="list-group-item list-group-item-action" href="/map">Interactive Map Navigation</a>
    <a class="list-group-item list-group-item-action" href="/events">Real-time Site Updates & Events</a>
    <a class="list-group-item list-group-item-action" href="/info">Historical & Cultural Information</a>
    <a class="list-group-item list-group-item-action" href="/arview">AR View Photos</a>
    @if (AuthService.IsAdmin)
    {
        <a class="list-group-item list-group-item-action" href="/admin">Admin: AR Content Management</a>
    }
</div>

@code {
    private async Task Logout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/");
    }
} 