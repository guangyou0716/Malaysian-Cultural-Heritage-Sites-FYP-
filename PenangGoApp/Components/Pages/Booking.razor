@page "/booking"
@inject PenangGoApp.Services.BookingService BookingService
@inject PenangGoApp.Services.AuthService AuthService

<h3 class="mb-4 text-center">My Bookings</h3>
@if (!AuthService.IsLoggedIn)
{
    <div class="alert alert-warning text-center">Please log in to view your bookings.</div>
}
else if (bookings == null)
{
    <p>Loading bookings...</p>
}
else if (bookings.Count == 0)
{
    <div class="alert alert-info text-center">You have no bookings yet.</div>
}
else
{
    <div class="container">
        <div class="row g-4">
            @foreach (var booking in bookings)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(booking.Event.ImageUrl))
                        {
                            <img src="@booking.Event.ImageUrl" class="card-img-top" alt="@booking.Event.Name" style="max-height:180px;object-fit:cover;" />
                        }
                        <div class="card-body">
                            <h5 class="card-title">@booking.Event.Name</h5>
                            <div class="mb-2"><span class="badge bg-info">@booking.Event.Date.ToString("yyyy-MM-dd")</span></div>
                            <div class="mb-2"><i class="bi bi-geo-alt"></i> @booking.Event.Location</div>
                            <span>Status: <b>@booking.Status</b></span><br />
                            <span>Booked on: @booking.BookingTime.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<PenangGoApp.Data.Booking> bookings;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsLoggedIn)
        {
            bookings = await BookingService.GetUserBookingsAsync(AuthService.CurrentUser.Id);
        }
    }
} 