@page "/info"
@inject PenangGoApp.Services.BookmarkService BookmarkService
@inject PenangGoApp.Services.ReviewService ReviewService
@inject PenangGoApp.Services.AuthService AuthService
@inject PenangGoApp.Services.ARContentService ARContentService
@inject PenangGoApp.Services.HeritageSiteService HeritageSiteService
@inject PenangGoApp.Services.ARService ARService

@* For demo, use siteId=1 (Khoo Kongsi) *@
@code {
    private const int siteId = 1;
    private PenangGoApp.Data.HeritageSite site;
    private bool isBookmarked;
    private List<PenangGoApp.Data.Review> reviews;
    private int rating;
    private string comment;
    private string reviewMsg;
    private List<PenangGoApp.Data.ARContent> arContents;

    protected override async Task OnInitializedAsync()
    {
        site = await HeritageSiteService.GetByIdAsync(siteId);
        if (AuthService.IsLoggedIn)
        {
            var userBookmarks = await BookmarkService.GetUserBookmarksAsync(AuthService.CurrentUser.Id);
            isBookmarked = userBookmarks.Any(b => b.SiteId == siteId);
        }
        reviews = await ReviewService.GetSiteReviewsAsync(siteId);
        arContents = await ARContentService.GetByHeritageSiteIdAsync(siteId);
    }
    private async Task Bookmark()
    {
        await BookmarkService.AddBookmarkAsync(AuthService.CurrentUser.Id, siteId);
        isBookmarked = true;
    }
    private async Task Unbookmark()
    {
        await BookmarkService.RemoveBookmarkAsync(AuthService.CurrentUser.Id, siteId);
        isBookmarked = false;
    }
    private async Task SubmitReview()
    {
        await ReviewService.AddReviewAsync(AuthService.CurrentUser.Id, siteId, rating, comment);
        reviewMsg = "Review submitted!";
        reviews = await ReviewService.GetSiteReviewsAsync(siteId);
    }
    private void ActivateAR(int arId)
    {
        // TODO: Pass AR content/model info to native AR view
        ARService.OpenARView();
    }
}

@if (site != null)
{
    <div class="container mt-4">
        <div class="row">
            <div class="col-md-6">
                <div class="card mb-4 shadow-sm">
                    <img src="@site.ImageUrl" class="card-img-top" alt="@site.Name" style="max-height:300px;object-fit:cover;" />
                    <div class="card-body">
                        <h3 class="card-title">@site.Name</h3>
                        <p class="card-text">@site.Description</p>
                        @if (AuthService.IsLoggedIn)
                        {
                            @if (isBookmarked)
                            {
                                <button class="btn btn-warning btn-sm" @onclick="Unbookmark">Unbookmark</button>
                            }
                            else
                            {
                                <button class="btn btn-primary btn-sm" @onclick="Bookmark">Bookmark</button>
                            }
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <h5 class="mb-3">AR Content for this Site</h5>
                @if (arContents != null && arContents.Count > 0)
                {
                    <div class="row g-3">
                        @foreach (var ar in arContents)
                        {
                            <div class="col-12">
                                <div class="card h-100">
                                    <img src="@ar.ImageUrl" class="card-img-top" alt="@ar.Title" style="max-height:180px;object-fit:cover;" />
                                    <div class="card-body">
                                        <b>@ar.Title</b><br />
                                        <small>@ar.Description</small><br />
                                        <button class="btn btn-success btn-sm mt-2" @onclick="() => ActivateAR(ar.Id)">View in AR</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info">No AR content for this site yet.</div>
                }
            </div>
        </div>
        <div class="row mt-4">
            <div class="col-md-8">
                <h5>Reviews & Ratings</h5>
                @if (reviews == null)
                {
                    <p>Loading reviews...</p>
                }
                else if (reviews.Count == 0)
                {
                    <p>No reviews yet. Be the first to review!</p>
                }
                else
                {
                    <ul class="list-group mb-3">
                        @foreach (var review in reviews)
                        {
                            <li class="list-group-item">
                                <b>@review.User.Name</b> - <span>Rating: @review.Rating</span><br />
                                <span>@review.Comment</span><br />
                                <small>@review.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                            </li>
                        }
                    </ul>
                }
                @if (AuthService.IsLoggedIn)
                {
                    <div class="mb-3">
                        <label>Rating</label>
                        <input type="number" min="1" max="5" class="form-control" @bind="rating" />
                    </div>
                    <div class="mb-3">
                        <label>Comment</label>
                        <textarea class="form-control" @bind="comment"></textarea>
                    </div>
                    <button class="btn btn-success" @onclick="SubmitReview">Submit Review</button>
                    @if (!string.IsNullOrEmpty(reviewMsg))
                    {
                        <div class="alert alert-info mt-2">@reviewMsg</div>
                    }
                }
            </div>
        </div>
    </div>
} 