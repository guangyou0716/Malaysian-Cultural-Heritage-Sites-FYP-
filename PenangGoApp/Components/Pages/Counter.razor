@page "/login"
@inject PenangGoApp.Services.AuthService AuthService
@inject NavigationManager Navigation

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-lg p-4" style="max-width: 400px; width: 100%;">
        <div class="text-center mb-4">
            <img src="/images/penanggo_logo.png" alt="PenangGo Logo" style="max-width: 100px;" />
        </div>
        <h3 class="text-center mb-3">Login</h3>
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger">@error</div>
        }
        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" class="form-control" id="email" @bind="email" />
        </div>
        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input type="password" class="form-control" id="password" @bind="password" />
        </div>
        <button class="btn btn-primary w-100" @onclick="LoginUser">Login</button>
        <div class="text-center mt-3">
            <a class="btn btn-link" href="/signup">Sign Up</a>
        </div>
    </div>
</div>

@code {
    private string email;
    private string password;
    private string error;

    private async Task LoginUser()
    {
        if (await AuthService.LoginAsync(email, password))
        {
            Navigation.NavigateTo("/dashboard");
        }
        else
        {
            error = "Invalid email or password.";
        }
    }
}
